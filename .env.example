# ============================================================
# Visual Style Editor — Environment Configuration
# ============================================================

# PostHog Product Analytics
# Get your Project API Key from https://app.posthog.com/project/settings
PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here

# PostHog Ingestion Host (Default US: https://us.i.posthog.com | EU: https://eu.i.posthog.com)
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Ads & Analytics (Optional identifiers)
# PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
