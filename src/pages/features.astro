---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";
import FloatingBadges from "@/components/marketing/FloatingBadges";
import SupportedTechMatrix from "@/components/marketing/SupportedTechMatrix.astro";
import Icon from "@/components/ui/Icon.astro";

const engines = [
  {
    id: "01",
    iconName: "ast",
    title: "Surgical Code Editing & Layer Hierarchy",
    image: "/images/editor-snapshots/desktop/02-editor-layers-pages-desktop.jpg",
    imageMobile: "/images/editor-snapshots/mobile/02-editor-layers-pages-mobile.jpg",
    imageLabel: "Pages, AST Tree & Document Layers",
    badgeTheme: "violet",
    tagline: "Your HTML stays clean. Never strips comments or custom scripts.",
    body: "Most visual editors reformat your entire HTML document, stripping developer comments, breaking Blade/Twig template tags, and messing up your indentation. Visual Style Editor works differently: Parse5 source location tracking records the exact byte position of the classes you want to change, and modifies only those characters — leaving everything else 100% untouched.",
    specs: [
      "Visual page switcher and DOM tree navigator",
      "Parse5 source location tracking records exact byte offsets",
      "Zero collateral changes to comments, doctypes, or scripts",
      "Works seamlessly with server-rendered HTML templates"
    ],
    code: `<!-- Before -->
<div class="px-4 py-2 bg-slate-100"> <!-- important note -->

<!-- After (only the class attribute is updated) -->
<div class="px-6 py-3.5 bg-zinc-900 rounded-xl"> <!-- important note -->`
  },
  {
    id: "02",
    iconName: "tailwind",
    title: "Tailwind Utility Classes & Responsive Breakpoints",
    image: "/images/editor-snapshots/desktop/03-editor-classes-system-desktop.jpg",
    imageMobile: "/images/editor-snapshots/mobile/03-editor-classes-system-mobile.jpg",
    imageLabel: "Live Utility Classes & Breakpoint Switcher",
    badgeTheme: "cyan",
    tagline: "Interactive pills, live autocomplete, and sm:/md:/lg: toggles.",
    body: "Tweak padding, margins, colors, and layout using interactive badge pills or typing with autocomplete. The forward-mapping engine maps your visual selections into standard Tailwind v3 utilities or v4 @theme CSS variables — never messy inline styles.",
    specs: [
      "Interactive class pills with one-click addition and removal",
      "Automatic Tailwind v3 utility and v4 @theme token detection",
      "Responsive breakpoint synthesis: sm:, md:, lg:, xl:",
      "Bidirectional class ↔ property synchronization at 60 FPS"
    ],
    code: `/* Forward-map output examples */
font-weight: 600       → class="font-semibold"
letter-spacing: -0.02  → class="tracking-tight"
border-radius: 1rem    → class="rounded-2xl"
color: oklch(0.65 ...) → class="bg-brand-primary"`
  },
  {
    id: "03",
    iconName: "palette",
    title: "OKLCH Color Studio & Contrast Checker",
    image: "/images/editor-snapshots/desktop/04-editor-colors-lab-desktop.jpg",
    imageMobile: "/images/editor-snapshots/mobile/04-editor-colors-lab-mobile.jpg",
    imageLabel: "OKLCH Lightness Tuner & WCAG AA/AAA Validator",
    badgeTheme: "lime",
    tagline: "Perceptually uniform colors with automated WCAG AA/AAA compliance.",
    body: "Standard sRGB color pickers create muddy, inconsistent tints. Visual Style Editor uses the modern OKLCH color space (Oklab Lightness Chroma Hue) to create smooth, balanced tonal scales (50 to 900) while continuously verifying WCAG 2.1 contrast ratios against your background.",
    specs: [
      "Modern Culori OKLCH perceptual color interpolation",
      "5 harmony schemes: mono, analogous, complementary, triadic, split",
      "Automatic 9-step tonal scale generator (50 to 900)",
      "Real-time WCAG AA and AAA accessibility contrast tests"
    ],
    code: `/* OKLCH palette output */
50:  oklch(0.97 0.02 200)   /* lightest tint */
500: oklch(0.62 0.22 200)   /* base brand color */
900: oklch(0.28 0.14 200)   /* deepest contrast shade */`
  },
  {
    id: "04",
    iconName: "step-sliders",
    title: "Visual Box Model, Padding & Margins",
    image: "/images/editor-snapshots/desktop/06-editor-padding-boxmodel-desktop.jpg",
    imageMobile: "/images/editor-snapshots/mobile/06-editor-padding-boxmodel-mobile.jpg",
    imageLabel: "Visual Box Model: Margin, Border, Padding & Content",
    badgeTheme: "amber",
    tagline: "Tactile sliders for spacing without guessing utility names.",
    body: "Stop guessing whether you need p-4, p-6, or py-8. Click any element to view its nested Margin, Border, Padding, and Content zones. Move visual sliders to adjust spacing with instant 60 FPS feedback and automatic Tailwind class generation.",
    specs: [
      "Concentric 4-tier visualizer: Margin, Border, Padding, Content",
      "Linked vs independent 4-side spacing controls",
      "Instant Tailwind spacing forward-mapping (p-4, mx-auto, py-6)",
      "Zero layout thrashing with CSS transform preview"
    ],
    code: `/* Box Model Tailwind utility mapping */
padding-top: 1.5rem;    padding-bottom: 1.5rem; → class="py-6"
padding-left: 2rem;     padding-right: 2rem;    → class="px-8"
margin-left: auto;      margin-right: auto;     → class="mx-auto"`
  },
  {
    id: "05",
    iconName: "gauge",
    title: "Fluid Typography & Font Hierarchy",
    image: "/images/editor-snapshots/desktop/05-editor-typography-desktop.jpg",
    imageMobile: "/images/editor-snapshots/mobile/05-editor-typography-mobile.jpg",
    imageLabel: "Typography Weights, Tracking, Leading & Alignment",
    badgeTheme: "violet",
    tagline: "Font weights, letter tracking, line height, and text alignment.",
    body: "Dial in beautiful typography visually. Choose font weights from Thin (100) to Black (900), fine-tune letter tracking and line heights with sliders, and toggle text alignment with single-click ease. Double-click any text on canvas to edit its copy inline.",
    specs: [
      "Full font weight selector grid from Thin to Black (100–900)",
      "Tracking (letter-spacing) and leading (line-height) tactile sliders",
      "Text alignment, transform, and text-wrap balance toggles",
      "Immediate canvas re-rendering at 60 FPS"
    ],
    code: `/* Typography utility mapping */
font-weight: 700;       → class="font-bold"
letter-spacing: -0.025em; → class="tracking-tight"
line-height: 1.25;      → class="leading-tight"
text-align: center;     → class="text-center"`
  },
  {
    id: "06",
    iconName: "hard-drive",
    title: "Direct Disk Save & Multi-Format Export",
    image: "/images/editor-snapshots/desktop/07-editor-export-studio-desktop.jpg",
    imageMobile: "/images/editor-snapshots/mobile/07-editor-export-studio-mobile.jpg",
    imageLabel: "Export Studio: HTML, JSX, Astro & Direct Disk Commit",
    badgeTheme: "lime",
    tagline: "Save directly back to local disk (⌘S), or export to React JSX & Astro.",
    body: "Work seamlessly with your local development setup. In Chromium browsers, the W3C File System Access API writes edits straight to your local file on disk with 0ms server latency. When you're ready, copy clean HTML, export React JSX with className syntax, or generate an Astro island component.",
    specs: [
      "Direct local disk save via W3C File System Access API",
      "Multi-framework generator: Clean HTML, React JSX, and Astro",
      "Visual diff review modal before committing changes to disk",
      "100% private: Zero cloud uploads, zero external telemetry"
    ],
    code: `// Multi-framework export options:
// 1. Clean HTML with preserved comments & doctype
// 2. JSX with className and self-closing tags
// 3. Astro component markup with frontmatter support
// 4. Direct disk commit via fileHandle.createWritable()`
  }
];

const benchmarks = [
  { metric: "Server latency", vse: "0 ms (100% client-side in RAM)", cloud: "250–800 ms per roundtrip save" },
  { metric: "File privacy", vse: "100% local, never leaves device", cloud: "Uploaded to third-party databases" },
  { metric: "Comment preservation", vse: "100% intact, byte-accurate", cloud: "Usually stripped or mangled" },
  { metric: "AST splicing overhead", vse: "<4 ms average execution", cloud: "Full document regeneration" },
  { metric: "Tailwind output quality", vse: "Idiomatic utility class names", cloud: "Generated or arbitrary values" },
  { metric: "Offline availability", vse: "Fully functional air-gapped", cloud: "Requires continuous connection" },
];

const featuresItemListSchema = {
  "@type": "ItemList",
  "@id": "https://visualstyleeditor.com/features#engines",
  "name": "Visual Style Editor Core Architectural Engines",
  "description": "Six client-side engines powering in-browser HTML and Tailwind CSS visual editing.",
  "itemListElement": engines.map((eng, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": eng.title,
    "description": eng.tagline
  }))
};

const breadcrumbs = [
  { name: "Home", item: "https://visualstyleeditor.com/" },
  { name: "Features", item: "https://visualstyleeditor.com/features" }
];
---

<BaseLayout
  title="Features — In-Browser AST & Tailwind CSS Architecture"
  description="Six client-side engines: in-browser AST splicing, Tailwind v3/v4 token mapping, OKLCH color science, concentric box model, and native File System API."
  breadcrumbs={breadcrumbs}
  customEntities={[featuresItemListSchema]}
>
  <div class="flex flex-col min-h-[100dvh]">
    <Navbar activePage="features" />

    <main id="main-content" class="flex-1">

      <!-- ============================================================
           HERO: Editorial Engine Deep Dive
           ============================================================ -->
      <section class="relative overflow-hidden pt-8 sm:pt-12 md:pt-14 pb-14 lg:pb-16 px-4 sm:px-6 lg:px-8" data-parallax-section>
        {/* Vibrant Multi-Layered Ambient Studio Aura & Grid Texture */}
        <div class="hero-ambient-glow" aria-hidden="true">
          <div class="hero-glow-orb cyan"></div>
          <div class="hero-grid-pattern"></div>
        </div>

        <div class="max-w-6xl mx-auto relative z-10 space-y-8">
          <div class="max-w-3xl space-y-6" data-reveal="fade-up">
            <div
              class="inline-flex items-center gap-2 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-mono font-bold uppercase tracking-wider border select-none shadow-sm backdrop-blur-xl bg-purple-50 text-purple-800 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-500/40"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse shrink-0"></span>
              <span class="truncate">Architectural Engine Deep Dive</span>
            </div>

            <h1
              class="text-display text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight leading-[1.12] sm:leading-[1.08]"
              data-motion-text="words"
            >
              Six core engines.<br />
              <span class="gradient-text">Zero proprietary formats.</span>
            </h1>

            <p class="text-body text-sm sm:text-base md:text-lg lg:text-xl" style="color: var(--ink-2);">
              Everything you need to inspect, tweak, and save HTML and Tailwind files visually — with 0ms server latency, zero cloud uploads, and 100% free open-source code.
            </p>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2 max-w-sm sm:max-w-none w-full sm:w-auto">
              <a href="/editor" data-magnetic class="btn btn-primary px-6 py-3.5 sm:py-4 rounded-2xl shadow-lg flex items-center justify-center text-center font-bold text-sm w-full sm:w-auto">
                Open Studio Workspace
              </a>
              <a href="/how-it-works" data-magnetic class="btn btn-secondary px-6 py-3.5 sm:py-4 rounded-2xl border flex items-center justify-center text-center font-semibold text-sm w-full sm:w-auto">
                Technical Walkthrough
              </a>
            </div>

            <div class="pt-2">
              <FloatingBadges client:load />
            </div>
          </div>

          <!-- Features Hero Studio Visual Window Frame -->
          <div class="max-w-5xl mx-auto pt-4" data-reveal="fade-up">
            <div class="glass-window-frame p-1.5 sm:p-2.5 group overflow-hidden">
              <div class="px-4 py-2 flex items-center justify-between border-b rounded-t-xl select-none text-xs font-mono text-zinc-400" style="background: rgba(18, 18, 21, 0.75); border-color: rgba(255, 255, 255, 0.08);">
                <div class="flex items-center gap-2">
                  <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></div>
                  <span class="ml-2 hidden sm:inline">visual-style-editor • six-engines-workstation</span>
                </div>
                <span class="text-purple-400 font-semibold text-[11px]">Six Core Engines</span>
              </div>
              <div class="relative rounded-lg overflow-hidden bg-black aspect-[16/9] max-sm:aspect-[9/13]">
                <picture class="block w-full h-full">
                  <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/01-editor-overview-mobile.png" />
                  <img
                    src="/images/editor-snapshots/desktop/01-editor-overview-desktop.png"
                    alt="Visual Style Editor Six Core Engines Studio Canvas"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]"
                    loading="eager"
                  />
                </picture>
              </div>
            </div>
          </div>
        </div>
      </section>

      <hr class="section-divider" />

      <!-- ============================================================
           STICKY STORYTELLING ENGINE SECTIONS
           ============================================================ -->
      <section class="section py-20 relative">
        <div class="section-inner space-y-28 lg:space-y-36">
          {engines.map((eng, i) => (
            <article
              class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start py-8 ${i > 0 ? 'border-t' : ''}`}
              style="border-color: var(--border);"
              data-reveal="fade-up"
            >
              {/* Sticky Narrative Column on Left (or alternating) */}
              <div class={`lg:col-span-5 space-y-6 lg:sticky lg:top-28 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
                <div class="flex items-center gap-3">
                  <div class={`frosted-icon-capsule ${eng.badgeTheme} w-11 h-11 shadow-md flex items-center justify-center`}>
                    <Icon name={eng.iconName} class="w-5 h-5" />
                  </div>
                  <span class={`neon-callout-tag ${eng.badgeTheme} text-xs font-mono font-bold`}>
                    Engine {eng.id}
                  </span>
                </div>

                <div class="space-y-2">
                  <h2 class="text-headline text-3xl font-black tracking-tight" style="color: var(--ink-1);">
                    {eng.title}
                  </h2>
                  <p class="text-sm font-semibold text-emerald-700 dark:text-emerald-400 font-mono">
                    {eng.tagline}
                  </p>
                </div>

                <p class="text-body text-sm sm:text-base leading-relaxed" style="color: var(--ink-2);">
                  {eng.body}
                </p>

                {/* Specs with custom glowing frosted icon capsules */}
                <ul class="space-y-3 pt-2">
                  {eng.specs.map((s) => (
                    <li class="flex items-start gap-3 text-xs font-mono" style="color: var(--ink-2);">
                      <div class={`w-5 h-5 rounded-md flex items-center justify-center shrink-0 border mt-0.5 text-[10px] font-bold ${
                        eng.badgeTheme === 'violet' ? 'bg-purple-50 text-purple-800 border-purple-300 dark:bg-purple-500/10 dark:text-purple-300 dark:border-purple-500/30' :
                        eng.badgeTheme === 'cyan' ? 'bg-sky-50 text-sky-800 border-sky-300 dark:bg-sky-500/10 dark:text-sky-300 dark:border-sky-500/30' :
                        eng.badgeTheme === 'lime' ? 'bg-emerald-50 text-emerald-800 border-emerald-300 dark:bg-emerald-500/10 dark:text-emerald-300 dark:border-emerald-500/30' :
                        'bg-amber-50 text-amber-800 border-amber-300 dark:bg-amber-500/10 dark:text-amber-300 dark:border-amber-500/30'
                      }`}>
                        <Icon name="check" class="w-3 h-3" strokeWidth={3} />
                      </div>
                      <span class="leading-relaxed">{s}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {/* Scrolling Feature Graphics & Interactive Code Blocks on Right */}
              <div class={`lg:col-span-7 space-y-5 ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
                {eng.image && (
                  <div class="glass-window-frame p-2 sm:p-2.5 group">
                    <div class="px-3.5 py-2 flex items-center justify-between border-b rounded-t-lg select-none text-[11px] font-mono text-zinc-400" style="background: rgba(18, 18, 21, 0.7); border-color: rgba(255, 255, 255, 0.08);">
                      <div class="flex items-center gap-1.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                        <span class="ml-2 font-medium">{eng.imageLabel}</span>
                      </div>
                      <span class="text-purple-400 font-bold">Engine {eng.id}</span>
                    </div>
                    <div class="relative rounded-lg overflow-hidden bg-black">
                      <picture class="block w-full">
                        {eng.imageMobile && (
                          <source media="(max-width: 640px)" srcset={eng.imageMobile} />
                        )}
                        <img
                          src={eng.image}
                          alt={eng.imageLabel || eng.title}
                          class="w-full h-auto object-cover max-h-[520px] transition-transform duration-700 group-hover:scale-[1.02]"
                          loading="lazy"
                        />
                      </picture>
                      <div class="absolute bottom-3 right-3">
                        <span class={`neon-callout-tag ${eng.badgeTheme} text-[10px]`}>
                          {eng.title}
                        </span>
                      </div>
                    </div>
                  </div>
                )}

                {/* Code Block Container */}
                <div class="code-block rounded-2xl shadow-xl border overflow-hidden p-0" style="background: var(--code-bg); border-color: var(--border);">
                  <div class="px-4 py-2.5 border-b flex items-center justify-between text-[11px] font-mono" style="border-color: var(--border); background: rgba(0,0,0,0.15);">
                    <span class="text-zinc-400 font-bold">engine/spec-0{eng.id}.css</span>
                    <span class="text-emerald-400 font-semibold">Idiomatic Code Output</span>
                  </div>
                  <pre class="p-4 text-xs font-mono leading-relaxed overflow-x-auto whitespace-pre-wrap" style="color: var(--ink-2);">{eng.code}</pre>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Supported Tech Matrix -->
      <SupportedTechMatrix />

      <!-- ============================================================
           PERFORMANCE BENCHMARKS
           ============================================================ -->
      <section class="section border-t" style="border-color: var(--border); background: var(--canvas-subtle);">
        <div class="section-inner space-y-12">
          <div class="section-header max-w-2xl mx-auto text-center" data-reveal="fade-up">
            <span class="badge text-xs font-mono font-bold uppercase tracking-wider mb-2 px-3 py-1 bg-purple-50 text-purple-800 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-500/40">
              Empirical Proof
            </span>
            <h2 class="text-headline text-3xl sm:text-4xl font-black">Performance Benchmarks</h2>
            <div data-aeo-answer class="text-xs sm:text-sm p-4 rounded-xl mt-3 mb-2 text-left bg-purple-500/10 border border-purple-500/20 text-purple-900 dark:text-purple-200">
              <p><strong>Direct Answer:</strong> Visual Style Editor achieves 0ms server latency and under 4ms AST splicing execution time by computing all edits in client-side WebAssembly and browser RAM. Unlike cloud-based builders that upload full documents, it reads and writes only altered byte ranges directly to your local file system via the W3C File System Access API and Parse5 engine.</p>
            </div>
            <p class="text-body text-base mt-2">
              Empirical metrics measured against the W3C File System Access API and Parse5 AST benchmark specifications.
            </p>
          </div>

          <div class="card overflow-x-auto rounded-3xl border shadow-xl" data-reveal="fade-up">
            <table class="w-full text-sm" style="border-collapse: collapse; font-family: var(--font-mono);" aria-label="Visual Style Editor vs Cloud Builders Performance Benchmarks">
              <thead>
                <tr style="border-bottom: 1px solid var(--border); background: var(--surface-2);">
                  <th scope="col" class="text-left px-6 py-4 text-label font-semibold" style="color: var(--ink-2);">Metric</th>
                  <th scope="col" class="text-left px-6 py-4 text-label font-bold text-purple-700 dark:text-purple-300">Visual Style Editor</th>
                  <th scope="col" class="text-left px-6 py-4 text-label font-medium" style="color: var(--ink-3);">Cloud-Based Builders</th>
                </tr>
              </thead>
              <tbody>
                {benchmarks.map((row, i) => (
                  <tr style={`border-bottom: 1px solid var(--border); background: ${i % 2 === 0 ? 'transparent' : 'var(--surface-1)'};`}>
                    <th scope="row" class="text-left px-6 py-4 text-xs font-semibold" style="color: var(--ink-1);">{row.metric}</th>
                    <td class="px-6 py-4 text-xs font-bold text-emerald-700 dark:text-emerald-400">{row.vse}</td>
                    <td class="px-6 py-4 text-xs font-medium" style="color: var(--ink-3);">{row.cloud}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <CtaBanner />
    </main>

    <Footer />
  </div>
</BaseLayout>
