---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Support Visual Style Editor — 100% Free In-Browser HTML Editor"
  description="Visual Style Editor is 100% free with no login and no telemetry. Help us keep it free forever through donations, sponsorships, or sharing."
>
  <main className="min-h-screen bg-[#09090b] text-zinc-100 flex flex-col justify-between selection:bg-rose-500 selection:text-white">
    <!-- Header Navigation -->
    <header className="border-b border-white/[0.06] bg-[#09090b]/80 backdrop-blur-md sticky top-0 z-30">
      <div className="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" className="flex items-center gap-2.5 group">
          <div className="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#0084FF] to-indigo-500 flex items-center justify-center text-white shadow-md shadow-[#0084FF]/20 group-hover:scale-105 transition-transform">
            <svg className="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
            </svg>
          </div>
          <span className="font-bold text-sm tracking-tight text-white">Visual Style Editor</span>
        </a>

        <div className="flex items-center gap-4">
          <a
            href="/templates"
            className="text-xs text-zinc-400 hover:text-white transition-colors"
          >
            Templates
          </a>
          <a
            href="/editor"
            className="text-xs font-semibold px-4 py-2 rounded-lg bg-[#0084FF] hover:bg-[#0074E0] text-white shadow-md shadow-[#0084FF]/20 transition-all flex items-center gap-1.5"
          >
            <span>Open Editor</span>
            <svg className="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14m-7-7 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Support Content Area -->
    <div className="max-w-3xl mx-auto px-6 py-16 flex-1 flex flex-col justify-center">
      {/* Hero Section */}
      <div className="text-center space-y-4 mb-12">
        <div className="inline-flex p-3 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-500 shadow-xl shadow-rose-500/10 mb-2 animate-bounce">
          <svg className="w-8 h-8 fill-rose-500/20 stroke-[2.2]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
          </svg>
        </div>
        <h1 className="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Support Visual Style Editor
        </h1>
        <p className="text-zinc-400 text-sm sm:text-base max-w-lg mx-auto leading-relaxed">
          This editor is 100% free, zero login, zero tracking — forever. If it saves you time on your projects, here are four simple ways you can help support continued development.
        </p>
      </div>

      {/* 4 Cards Grid */}
      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12">
        {/* Card 1: Ko-fi */}
        <a
          href="https://ko-fi.com"
          target="_blank"
          rel="noopener noreferrer"
          className="group p-6 rounded-2xl bg-[#111114] border border-white/[0.08] hover:border-amber-500/40 hover:bg-[#15151a] transition-all flex flex-col justify-between shadow-lg hover:shadow-amber-500/5 relative overflow-hidden"
        >
          <div className="space-y-3">
            <div className="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
              <span className="text-xl">☕</span>
            </div>
            <div>
              <h2 className="text-base font-semibold text-white group-hover:text-amber-300 transition-colors">
                Buy Me a Coffee
              </h2>
              <p className="text-xs text-zinc-400 mt-1 leading-relaxed">
                Make a one-time tip of any amount via Ko-fi. Every coffee fuels late-night development.
              </p>
            </div>
          </div>
          <div className="mt-5 flex items-center text-xs font-semibold text-amber-400 gap-1 group-hover:translate-x-1 transition-transform">
            <span>Tip on Ko-fi</span>
            <span>&rarr;</span>
          </div>
        </a>

        {/* Card 2: GitHub Sponsors */}
        <a
          href="https://github.com/sponsors"
          target="_blank"
          rel="noopener noreferrer"
          className="group p-6 rounded-2xl bg-[#111114] border border-white/[0.08] hover:border-rose-500/40 hover:bg-[#15151a] transition-all flex flex-col justify-between shadow-lg hover:shadow-rose-500/5 relative overflow-hidden"
        >
          <div className="space-y-3">
            <div className="w-10 h-10 rounded-xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 group-hover:scale-110 transition-transform">
              <svg className="w-5 h-5 fill-rose-500/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
              </svg>
            </div>
            <div>
              <h2 className="text-base font-semibold text-white group-hover:text-rose-300 transition-colors">
                GitHub Sponsors
              </h2>
              <p className="text-xs text-zinc-400 mt-1 leading-relaxed">
                Back ongoing open-source maintenance with recurring or one-time GitHub Sponsorship.
              </p>
            </div>
          </div>
          <div className="mt-5 flex items-center text-xs font-semibold text-rose-400 gap-1 group-hover:translate-x-1 transition-transform">
            <span>Sponsor on GitHub</span>
            <span>&rarr;</span>
          </div>
        </a>

        {/* Card 3: Watch an Ad / Partner Slot */}
        <div
          id="support-ad"
          className="p-6 rounded-2xl bg-[#111114] border border-white/[0.08] flex flex-col justify-between shadow-lg relative overflow-hidden"
        >
          <div className="space-y-3">
            <div className="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400">
              <svg className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="14" x="2" y="5" rx="2"/>
                <line x1="2" x2="22" y1="10" y2="10"/>
              </svg>
            </div>
            <div>
              <div className="flex items-center justify-between">
                <h2 className="text-base font-semibold text-white">Sponsor / Partner Slot</h2>
                <span className="text-[10px] font-mono px-2 py-0.5 rounded-full bg-white/[0.06] text-zinc-400">Ad Space</span>
              </div>
              <p className="text-xs text-zinc-400 mt-1 leading-relaxed">
                View developer tooling and hosting sponsor announcements that fund our web hosting.
              </p>
            </div>
          </div>
          <div className="mt-5 p-3 rounded-xl bg-white/[0.03] border border-dashed border-white/10 text-center text-xs text-zinc-500">
            Carbon Ads / Sponsor Slot Active
          </div>
        </div>

        {/* Card 4: Share & Spread the Word */}
        <div className="p-6 rounded-2xl bg-[#111114] border border-white/[0.08] hover:border-sky-500/40 hover:bg-[#15151a] transition-all flex flex-col justify-between shadow-lg hover:shadow-sky-500/5 group">
          <div className="space-y-3">
            <div className="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 group-hover:scale-110 transition-transform">
              <svg className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="18" cy="5" r="3"/>
                <circle cx="6" cy="12" r="3"/>
                <circle cx="18" cy="19" r="3"/>
                <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
                <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
              </svg>
            </div>
            <div>
              <h2 className="text-base font-semibold text-white group-hover:text-sky-300 transition-colors">
                Share With Friends
              </h2>
              <p className="text-xs text-zinc-400 mt-1 leading-relaxed">
                Share this tool on X / Twitter, Reddit, or Discord to help other front-end engineers.
              </p>
            </div>
          </div>

          <div className="mt-5 flex items-center gap-2">
            <a
              href="https://twitter.com/intent/tweet?text=Check%20out%20Visual%20Style%20Editor%20%E2%80%94%20a%20free%2C%20in-browser%20visual%20editor%20for%20HTML%20and%20Tailwind%20CSS%20with%20live%20AST%20splicing%21&url=https%3A%2F%2Fvisualstyleeditor.com"
              target="_blank"
              rel="noopener noreferrer"
              className="px-3 py-1.5 rounded-lg bg-sky-500/20 hover:bg-sky-500/30 text-sky-300 text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer"
            >
              <span>Post on X</span>
            </a>
            <button
              id="copy-link-btn"
              type="button"
              className="px-3 py-1.5 rounded-lg bg-white/[0.06] hover:bg-white/[0.12] text-zinc-200 text-xs font-semibold transition-colors cursor-pointer"
            >
              Copy Link
            </button>
          </div>
        </div>
      </div>

      {/* Back CTA */}
      <div className="text-center">
        <a
          href="/editor"
          className="inline-flex items-center gap-2 text-xs font-medium text-zinc-400 hover:text-white transition-colors"
        >
          <span>&larr; Return to Visual Style Editor</span>
        </a>
      </div>
    </div>

    <!-- Simple Footer -->
    <footer className="border-t border-white/[0.06] py-6 text-center text-xs text-zinc-500">
      <p>Visual Style Editor &bull; Free & Open-Source &bull; No Tracking &bull; Zero Server Logic</p>
    </footer>
  </main>

  <script is:inline>
    const btn = document.getElementById("copy-link-btn");
    if (btn) {
      btn.addEventListener("click", () => {
        navigator.clipboard.writeText(window.location.origin);
        btn.textContent = "Copied!";
        setTimeout(() => {
          btn.textContent = "Copy Link";
        }, 2000);
      });
    }
  </script>
</BaseLayout>
