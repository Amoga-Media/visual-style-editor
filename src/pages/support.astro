---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import Icon from "@/components/ui/Icon.astro";

const supportLinks = [
  {
    theme: "violet",
    iconName: "bug",
    title: "Report a bug",
    body: "Found something broken? Open an issue on GitHub with what you did, what you expected, and what happened instead.",
    cta: "Open GitHub issues",
    href: "https://github.com",
    external: true,
  },
  {
    theme: "cyan",
    iconName: "lightbulb",
    title: "Request a feature",
    body: "Describe what you're trying to do and why the current tool doesn't quite get there. We read everything.",
    cta: "GitHub discussions",
    href: "https://github.com",
    external: true,
  },
  {
    theme: "emerald",
    iconName: "mail",
    title: "Direct contact & inquiries",
    body: "Have a partnership proposal, bug report, or feature request? Reach our core engineering team directly via our contact hub.",
    cta: "Open Contact Hub",
    href: "/contact",
    external: false,
  },
  {
    theme: "amber",
    iconName: "heart",
    title: "Support the project",
    body: "No subscription, no paywalls. But if this tool saves you time, Ko-fi or GitHub Sponsors help keep it maintained.",
    cta: "Ko-fi / GitHub Sponsors",
    href: "https://ko-fi.com",
    external: true,
  },
];

const faqs = [
  {
    q: "Can I visually edit HTML generated by Claude, Cursor, or v0?",
    a: "Yes! This is one of the most popular workflows. When an AI coding assistant generates an HTML snippet or UI prototype, simply drop it into Visual Style Editor to adjust padding, colors, fonts, or responsive layout visually in seconds — eliminating prompt fatigue."
  },
  {
    q: "Why can't I save files directly on Firefox or Safari?",
    a: "The File System Access API is currently only supported in Chromium-based browsers (Chrome, Edge, Brave, Arc). On Firefox and Safari, you can still use the editor — you'll get a download button instead of direct disk save."
  },
  {
    q: "The editor isn't detecting my Tailwind v4 @theme variables.",
    a: "Make sure your CSS file uses the @theme {} block syntax and is linked from the HTML file you opened. The detector looks for @theme in the document's associated stylesheets."
  },
  {
    q: "Does it work with React/Vue/Svelte component files directly?",
    a: "Visual Style Editor opens .html and .htm files directly. If your project uses React, Vue, or Next.js, you can visually style your components as HTML and then use the Export Studio to export them as React JSX (with className) or Astro in one click. Direct parsing of .jsx and .vue files is currently in development."
  },
  {
    q: "Will editing styles mess up my custom JavaScript or HTML comments?",
    a: "No. The AST engine operates at character-offset precision. It only updates the characters within class attributes. All adjacent markup, external scripts (like GSAP or Swiper), and developer comments remain 100% untouched."
  },
];

const supportFaqSchema = {
  "@type": "FAQPage",
  "@id": "https://visualstyleeditor.com/support#faq",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};

const breadcrumbs = [
  { name: "Home", item: "https://visualstyleeditor.com/" },
  { name: "Support", item: "https://visualstyleeditor.com/support" }
];
---

<BaseLayout
  title="Support & Documentation — Visual Style Editor"
  description="Troubleshooting, FAQs, bug reports, and technical assistance for Visual Style Editor. Get direct help with File System Access and Tailwind CSS tokens."
  breadcrumbs={breadcrumbs}
  customEntities={[supportFaqSchema]}
>
  <div class="flex flex-col min-h-[100dvh]">
    <Navbar activePage="support" />

    <main id="main-content" class="flex-1">

      <!-- Header -->
      <section class="relative overflow-hidden pt-8 sm:pt-12 md:pt-14 pb-12 sm:pb-14 px-4 sm:px-6 lg:px-8">
        {/* Vibrant Multi-Layered Ambient Studio Aura & Grid Texture */}
        <div class="hero-ambient-glow" aria-hidden="true">
          <div class="hero-glow-orb cyan"></div>
          <div class="hero-grid-pattern"></div>
        </div>

        <div class="max-w-6xl mx-auto relative z-10">
          <div class="max-w-3xl space-y-4 reveal">
            <div
              class="inline-flex items-center gap-2 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-mono font-bold uppercase tracking-wider border select-none shadow-sm backdrop-blur-xl bg-sky-50 text-sky-800 border-sky-200 dark:bg-sky-950/40 dark:text-sky-300 dark:border-sky-500/40"
            >
              <span class="w-2 h-2 rounded-full bg-sky-600 dark:bg-sky-400 animate-pulse shrink-0"></span>
              <span class="truncate">Community & Assistance</span>
            </div>
            <h1 class="text-display text-3xl sm:text-5xl md:text-6xl font-black tracking-tight leading-[1.12] sm:leading-[1.08]">
              Support & Community
            </h1>
            <p class="text-body text-sm sm:text-base md:text-lg" style="color: var(--ink-2);">
              We're an open-source team. GitHub Issues and Discussions are the fastest ways to get answers, report bugs, or request features.
            </p>
          </div>

          <!-- Hero Studio Workstation Window Frame -->
          <div class="max-w-5xl mx-auto pt-4 reveal">
            <div class="glass-window-frame p-1.5 sm:p-2.5 group overflow-hidden">
              <div class="px-4 py-2 flex items-center justify-between border-b rounded-t-xl select-none text-xs font-mono text-zinc-400" style="background: rgba(18, 18, 21, 0.75); border-color: rgba(255, 255, 255, 0.08);">
                <div class="flex items-center gap-2">
                  <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></div>
                  <span class="ml-2 hidden sm:inline">visual-style-editor • support-and-diagnostics</span>
                </div>
                <span class="text-sky-400 font-semibold text-[11px]">Developer Documentation</span>
              </div>
              <div class="relative rounded-lg overflow-hidden bg-black aspect-[16/9] max-sm:aspect-[9/13]">
                <picture class="block w-full h-full">
                  <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/01-editor-overview-mobile.png" />
                  <img
                    src="/images/editor-snapshots/desktop/01-editor-overview-desktop.png"
                    alt="Visual Style Editor Support Canvas Workspace"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]"
                    loading="eager"
                  />
                </picture>
              </div>
            </div>
          </div>
        </div>
      </section>

      <hr class="section-divider" />

      <!-- Support options: 4-column responsive grid -->
      <section class="section">
        <div class="section-inner">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {supportLinks.map((link, i) => (
              <div class={`tile rounded-3xl p-6 sm:p-7 lg:p-8 border reveal reveal-stagger-${i + 1} space-y-4`} style="background: var(--surface-1); border-color: var(--border);">
                <div class={`frosted-icon-capsule ${link.theme}`}>
                  <Icon name={link.iconName} class="w-6 h-6" />
                </div>
                <h2 class="text-title text-xl font-bold" style="color: var(--ink-1);">{link.title}</h2>
                <p class="text-sm leading-relaxed" style="color: var(--ink-3);">{link.body}</p>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  class="btn btn-ghost text-sm inline-flex items-center gap-1.5 pt-2"
                >
                  <span>{link.cta}</span>
                  {link.external && (
                    <svg class="w-3.5 h-3.5 opacity-60 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  )}
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Visual Diagnostic & Guided Tours -->
      <section class="section border-t py-16" style="border-color: var(--border); background: var(--canvas);">
        <div class="section-inner space-y-12">
          <div class="section-header max-w-2xl mx-auto text-center reveal">
            <span class="badge text-xs font-mono font-bold uppercase tracking-wider mb-2 px-3 py-1 bg-sky-50 text-sky-800 border-sky-200 dark:bg-sky-950/40 dark:text-sky-300 dark:border-sky-500/40">
              Visual Guides
            </span>
            <h2 class="text-headline text-3xl sm:text-4xl font-black">Studio Walkthroughs & Quick Reference</h2>
            <p class="text-body text-base mt-2">
              Learn how to utilize responsive switchers, keyboard accelerators, and element insertion drawers.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-reveal-group>
            <!-- Guide 1: Device Switcher -->
            <div class="card rounded-3xl border overflow-hidden group hover:shadow-2xl transition-all duration-300 flex flex-col justify-between" data-reveal-item style="background: var(--surface-1); border-color: var(--border);">
              <div class="relative overflow-hidden aspect-[16/10] max-sm:aspect-[9/13] bg-zinc-950">
                <picture class="block w-full h-full">
                  <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/08-editor-device-switch-mobile.png" />
                  <img
                    src="/images/editor-snapshots/desktop/09-editor-device-switch-desktop.png"
                    alt="Multi-Viewport Device Switcher"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </picture>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
                <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between pointer-events-none">
                  <span class="neon-callout-tag cyan text-[10px]">Viewport Controls</span>
                  <span class="text-[10px] font-mono text-zinc-300">Responsive Canvas</span>
                </div>
              </div>
              <div class="p-5 space-y-1.5">
                <h3 class="text-base font-bold" style="color: var(--ink-1);">Multi-Device Previews</h3>
                <p class="text-xs leading-relaxed" style="color: var(--ink-3);">
                  Toggle between Mobile (375px), Tablet (768px), and Full Desktop (100%) canvas frames with zero page reloads.
                </p>
              </div>
            </div>

            <!-- Guide 2: Shortcuts -->
            <div class="card rounded-3xl border overflow-hidden group hover:shadow-2xl transition-all duration-300 flex flex-col justify-between" data-reveal-item style="background: var(--surface-1); border-color: var(--border);">
              <div class="relative overflow-hidden aspect-[16/10] max-sm:aspect-[9/13] bg-zinc-950">
                <picture class="block w-full h-full">
                  <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/11-editor-shortcuts-modal-mobile.png" />
                  <img
                    src="/images/editor-snapshots/desktop/11-editor-shortcuts-modal-desktop.png"
                    alt="Keyboard Shortcuts Modal"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </picture>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
                <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between pointer-events-none">
                  <span class="neon-callout-tag violet text-[10px]">Hotkeys Overlay</span>
                  <span class="text-[10px] font-mono text-zinc-300">Shift + ?</span>
                </div>
              </div>
              <div class="p-5 space-y-1.5">
                <h3 class="text-base font-bold" style="color: var(--ink-1);">Keyboard Accelerators</h3>
                <p class="text-xs leading-relaxed" style="color: var(--ink-3);">
                  Press Shift + ? anywhere in the studio to pull up instant shortcuts for Undo, Redo, Zoom, Selection, and Direct Disk Save.
                </p>
              </div>
            </div>

            <!-- Guide 3: Component Library -->
            <div class="card rounded-3xl border overflow-hidden group hover:shadow-2xl transition-all duration-300 flex flex-col justify-between" data-reveal-item style="background: var(--surface-1); border-color: var(--border);">
              <div class="relative overflow-hidden aspect-[16/10] max-sm:aspect-[9/13] bg-zinc-950">
                <picture class="block w-full h-full">
                  <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/10-editor-library-insert-mobile.png" />
                  <img
                    src="/images/editor-snapshots/desktop/10-editor-library-insert-desktop.png"
                    alt="Component Library & Insert Panel"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </picture>
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
                <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between pointer-events-none">
                  <span class="neon-callout-tag lime text-[10px]">Insert Library</span>
                  <span class="text-[10px] font-mono text-zinc-300">Snippets & Blocks</span>
                </div>
              </div>
              <div class="p-5 space-y-1.5">
                <h3 class="text-base font-bold" style="color: var(--ink-1);">Block Ingestion Library</h3>
                <p class="text-xs leading-relaxed" style="color: var(--ink-3);">
                  Insert buttons, badges, feature grids, cards, and typography snippets directly into your HTML document with live preview.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="section border-t" style="border-color: var(--border); background: var(--canvas-subtle);">
        <div class="section-inner">
          <div class="section-header reveal">
            <h2 class="text-headline">Common issues & FAQs</h2>
            <div data-aeo-answer class="text-xs sm:text-sm p-4 rounded-xl mt-3 mb-2 text-left bg-sky-500/10 border border-sky-500/20 text-sky-900 dark:text-sky-200">
              <p><strong>Direct Answer:</strong> Visual Style Editor requires a Chromium browser (Chrome, Edge, Brave, Arc) to synchronize edits directly with local disk files via the File System Access API. On Safari and Firefox, users can edit styles visually and download the modified HTML files without losing comments or template logic.</p>
            </div>
          </div>
          <div class="max-w-2xl space-y-0 reveal">
            {faqs.map((faq, i) => (
              <div class="py-6" style={`border-bottom: 1px solid var(--border);${i === 0 ? 'border-top: 1px solid var(--border);' : ''}`}>
                <h3 class="text-sm font-semibold mb-2" style="color: var(--ink-1); letter-spacing: -0.01em;">{faq.q}</h3>
                <p class="text-sm leading-relaxed" style="color: var(--ink-3);">{faq.a}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

    </main>

    <Footer />
  </div>
</BaseLayout>
