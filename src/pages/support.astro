---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";

const supportOptions = [
  {
    icon: "☕",
    title: "Buy us a Coffee",
    desc: "A quick, one-time donation on Ko-fi to fuel late-night coding sessions and serverless domain infrastructure.",
    cta: "Donate on Ko-fi",
    href: "https://ko-fi.com",
    badge: "One-Time Tip"
  },
  {
    icon: "💖",
    title: "GitHub Sponsors",
    desc: "Support our ongoing open-source engineering with a monthly sponsorship tier on GitHub.",
    cta: "Become a Sponsor",
    href: "https://github.com/sponsors",
    badge: "Monthly Supporter"
  },
  {
    icon: "⭐",
    title: "Star on GitHub",
    desc: "Give our repository a star on GitHub. It directly increases our visibility in the frontend developer ecosystem.",
    cta: "Star Repository",
    href: "https://github.com",
    badge: "100% Free"
  },
  {
    icon: "📢",
    title: "Share with Peers",
    desc: "Tweet, post on LinkedIn, or share in your developer communities (Reddit, Discord, Hacker News).",
    cta: "Share Visual Style Editor",
    href: "https://twitter.com/intent/tweet?text=Check%20out%20Visual%20Style%20Editor%20%E2%80%94%20a%20free%2C%20in-browser%20visual%20editor%20for%20HTML%20and%20Tailwind%20CSS!&url=https://visualstyleeditor.com",
    badge: "Community Growth"
  }
];

const tiers = [
  {
    name: "Supporter",
    price: "$5",
    freq: "/month",
    desc: "Helps cover our domain name, SSL certs, and continuous integration runners.",
    perks: ["Sponsor badge on GitHub", "Special Supporter role in Discord", "Our eternal gratitude"]
  },
  {
    name: "Backer",
    price: "$20",
    freq: "/month",
    desc: "Directly funds engineering time for new features like AST extensions and template creation.",
    perks: ["All Supporter perks", "Priority feature request voting", "Name listed on Support Hall of Fame", "Early access to experimental builds"]
  },
  {
    name: "Enterprise Champion",
    price: "$100",
    freq: "/month",
    desc: "For digital agencies and studios using Visual Style Editor for commercial client production.",
    perks: ["All Backer perks", "Company logo with link on our homepage & repo", "Direct 1-on-1 support channel", "Custom starter template integration"]
  }
];
---

<BaseLayout
  title="Support & Sponsorship — Visual Style Editor"
  description="Visual Style Editor is 100% free with no login and zero telemetry. Help us keep it free forever through donations, sponsorships, or sharing."
  theme="dark"
  showPixelCanvas={true}
>
  <div class="relative min-h-screen flex flex-col bg-[#060608] text-slate-100 overflow-hidden">
    <Navbar activePage="support" />

    <main class="flex-1">
      <!-- HERO SECTION -->
      <section class="pt-16 pb-24 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto text-center space-y-8">
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-cyan-950/60 text-cyan-300 border border-cyan-500/30 shadow-lg shadow-cyan-500/10">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          100% Free & Open Source Forever
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.1]">
          Help us keep web tools <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">
            free, private, and open.
          </span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Visual Style Editor has zero venture funding, zero subscriptions, and zero paywalled features. If our tool saves you hours of development work, here is how you can support our mission.
        </p>
      </section>

      <!-- 4 SIMPLE WAYS TO SUPPORT -->
      <section class="pb-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {supportOptions.map((opt) => (
            <div class="doppelrand-shell spotlight-card">
              <div class="doppelrand-core p-7 sm:p-8 flex flex-col justify-between space-y-6 h-full">
                <div class="space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="text-3xl">{opt.icon}</span>
                    <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-cyan-950/60 text-cyan-300 border border-cyan-500/30">
                      {opt.badge}
                    </span>
                  </div>

                  <h3 class="text-xl font-bold text-white tracking-tight">{opt.title}</h3>
                  <p class="text-sm text-slate-300 leading-relaxed font-sans">{opt.desc}</p>
                </div>

                <a
                  href={opt.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-full text-xs font-bold text-black bg-gradient-to-r from-cyan-400 to-sky-300 hover:brightness-110 shadow-md shadow-cyan-500/20 active:scale-98 transition-all"
                >
                  <span>{opt.cta}</span>
                  <span class="text-xs">↗</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- SPONSORSHIP TIERS -->
      <section class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 border-t border-white/10 bg-[#07090e]/60">
        <div class="max-w-6xl mx-auto space-y-12">
          <div class="text-center max-w-2xl mx-auto space-y-3">
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan-400">
              Sponsorship Tiers
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
              Fuel Continued Development
            </h2>
            <p class="text-sm sm:text-base text-slate-400">
              For individuals, teams, and agencies who rely on Visual Style Editor daily.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {tiers.map((t, idx) => (
              <div class={`doppelrand-shell spotlight-card ${idx === 1 ? 'ring-2 ring-cyan-400/50' : ''}`}>
                <div class="doppelrand-core p-7 sm:p-8 flex flex-col justify-between space-y-6 h-full">
                  <div class="space-y-4">
                    <div class="flex items-center justify-between">
                      <h3 class="text-lg font-bold text-white">{t.name}</h3>
                      {idx === 1 && (
                        <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-cyan-950 text-cyan-300 border border-cyan-500/30">
                          Recommended
                        </span>
                      )}
                    </div>

                    <div class="flex items-baseline gap-1">
                      <span class="text-4xl font-extrabold text-white">{t.price}</span>
                      <span class="text-xs font-mono text-slate-400">{t.freq}</span>
                    </div>

                    <p class="text-xs text-slate-300 leading-relaxed font-sans">{t.desc}</p>

                    <div class="pt-4 border-t border-white/10 space-y-2">
                      <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400">Included Perks:</span>
                      <ul class="space-y-2 text-xs text-slate-300">
                        {t.perks.map((p) => (
                          <li class="flex items-center gap-2">
                            <span class="text-cyan-400 font-bold">✓</span>
                            <span>{p}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <a
                    href="https://github.com/sponsors"
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-full text-xs font-bold ${
                      idx === 1
                        ? "text-black bg-gradient-to-r from-cyan-400 to-sky-300 shadow-md shadow-cyan-500/25 hover:brightness-110"
                        : "text-slate-200 bg-white/5 hover:bg-white/10 border border-white/10"
                    } transition-all`}
                  >
                    <span>Sponsor this Tier</span>
                    <span class="text-xs">↗</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- TRANSPARENCY DECLARATION -->
      <section class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
        <div class="doppelrand-shell spotlight-card text-center">
          <div class="doppelrand-core p-8 sm:p-10 space-y-3">
            <h3 class="text-xl font-bold text-white">Ethical Financial Transparency</h3>
            <p class="text-sm text-slate-300 max-w-xl mx-auto leading-relaxed">
              100% of sponsorship income is dedicated strictly to domain renewals, software signing certificates, continuous testing pipelines, and maintaining free public templates. We will never sell your data or gate features.
            </p>
          </div>
        </div>
      </section>

      <!-- CTA BANNER -->
      <CtaBanner
        headline="Ready to build something amazing today?"
        subheadline="Jump right into the editor and start crafting your website."
      />
    </main>

    <Footer />
  </div>
</BaseLayout>
