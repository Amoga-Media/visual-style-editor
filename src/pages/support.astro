---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import Icon from "@/components/ui/Icon.astro";

const supportLinks = [
  {
    theme: "violet",
    iconName: "bug",
    title: "Report a bug",
    body: "Found something broken? Open an issue on GitHub with what you did, what you expected, and what happened instead.",
    cta: "Open GitHub issues",
    href: "https://github.com",
    external: true,
  },
  {
    theme: "cyan",
    iconName: "lightbulb",
    title: "Request a feature",
    body: "Describe what you're trying to do and why the current tool doesn't quite get there. We read everything.",
    cta: "GitHub discussions",
    href: "https://github.com",
    external: true,
  },
  {
    theme: "amber",
    iconName: "heart",
    title: "Support the project",
    body: "No subscription, no paywalls. But if this tool saves you time, Ko-fi or GitHub Sponsors help keep it maintained.",
    cta: "Ko-fi / GitHub Sponsors",
    href: "https://ko-fi.com",
    external: true,
  },
];

const faqs = [
  {
    q: "Why can't I save files directly on Firefox or Safari?",
    a: "The File System Access API is currently only supported in Chromium-based browsers (Chrome, Edge, Brave, Arc). On Firefox and Safari, you can still use the editor — you'll get a download button instead of direct disk save."
  },
  {
    q: "The editor isn't detecting my Tailwind v4 @theme variables.",
    a: "Make sure your CSS file uses the @theme {} block syntax and is linked from the HTML file you opened. The detector looks for @theme in the document's associated stylesheets."
  },
  {
    q: "I opened a folder but some components aren't showing up.",
    a: "The editor resolves relative paths from the HTML file's location. If a component's source is outside that folder, it may not resolve. Try opening the outermost project folder."
  },
  {
    q: "Does it work with React/Vue/Svelte component files?",
    a: "Currently, it works with HTML files and Tailwind utility classes. Component file formats (.jsx, .vue, .svelte) aren't supported yet — it's on the roadmap."
  },
];
---

<BaseLayout
  title="Support — Visual Style Editor"
  description="Get help with Visual Style Editor, report bugs, request features, or support the project."
>
  <div class="flex flex-col min-h-[100dvh]">
    <Navbar activePage="support" />

    <main id="main-content" class="flex-1">

      <!-- Header -->
      <section class="relative overflow-hidden pt-8 sm:pt-12 md:pt-14 pb-12 sm:pb-14 px-4 sm:px-6 lg:px-8">
        {/* Vibrant Multi-Layered Ambient Studio Aura & Grid Texture */}
        <div class="hero-ambient-glow" aria-hidden="true">
          <div class="hero-glow-orb cyan"></div>
          <div class="hero-grid-pattern"></div>
        </div>

        <div class="max-w-6xl mx-auto relative z-10">
          <div class="max-w-3xl space-y-4 reveal">
            <div
              class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider border select-none shadow-sm backdrop-blur-xl bg-sky-50 text-sky-800 border-sky-200 dark:bg-sky-950/40 dark:text-sky-300 dark:border-sky-500/40"
            >
              <span class="w-2 h-2 rounded-full bg-sky-600 dark:bg-sky-400 animate-pulse"></span>
              <span>Community & Assistance</span>
            </div>
            <h1 class="text-display text-4xl sm:text-5xl md:text-6xl font-black tracking-tight leading-[1.08]">
              Support & Community
            </h1>
            <p class="text-body text-base sm:text-lg" style="color: var(--ink-2);">
              We're an open-source team. GitHub Issues and Discussions are the fastest ways to get answers, report bugs, or request features.
            </p>
          </div>
        </div>
      </section>

      <hr class="section-divider" />

      <!-- Support options: 3-column, no icons -->
      <section class="section">
        <div class="section-inner">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {supportLinks.map((link, i) => (
              <div class={`tile rounded-3xl p-8 border reveal reveal-stagger-${i + 1} space-y-4`} style="background: var(--surface-1); border-color: var(--border);">
                <div class={`frosted-icon-capsule ${link.theme}`}>
                  <Icon name={link.iconName} class="w-6 h-6" />
                </div>
                <h2 class="text-title text-xl font-bold" style="color: var(--ink-1);">{link.title}</h2>
                <p class="text-sm leading-relaxed" style="color: var(--ink-3);">{link.body}</p>
                <a
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  class="btn btn-ghost text-sm inline-flex items-center gap-1.5 pt-2"
                >
                  <span>{link.cta}</span>
                  {link.external && (
                    <svg class="w-3.5 h-3.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  )}
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="section border-t" style="border-color: var(--border); background: var(--canvas-subtle);">
        <div class="section-inner">
          <div class="section-header reveal">
            <h2 class="text-headline">Common issues</h2>
          </div>
          <div class="max-w-2xl space-y-0 reveal">
            {faqs.map((faq, i) => (
              <div class="py-6" style={`border-bottom: 1px solid var(--border);${i === 0 ? 'border-top: 1px solid var(--border);' : ''}`}>
                <h3 class="text-sm font-semibold mb-2" style="color: var(--ink-1); letter-spacing: -0.01em;">{faq.q}</h3>
                <p class="text-sm leading-relaxed" style="color: var(--ink-3);">{faq.a}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

    </main>

    <Footer />
  </div>
</BaseLayout>
