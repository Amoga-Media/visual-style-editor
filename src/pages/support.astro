---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";

const supportOptions = [
  {
    icon: "☕",
    title: "Buy us a Coffee",
    desc: "A quick, one-time donation on Ko-fi to fuel late-night coding sessions and serverless domain infrastructure.",
    cta: "Donate on Ko-fi",
    href: "https://ko-fi.com",
    badge: "One-Time Tip"
  },
  {
    icon: "💖",
    title: "GitHub Sponsors",
    desc: "Support our ongoing open-source engineering with a monthly sponsorship tier on GitHub.",
    cta: "Become a Sponsor",
    href: "https://github.com/sponsors",
    badge: "Monthly Supporter"
  },
  {
    icon: "⭐",
    title: "Star on GitHub",
    desc: "Give our repository a star on GitHub. It directly increases our visibility in the frontend developer ecosystem.",
    cta: "Star Repository",
    href: "https://github.com",
    badge: "100% Free"
  },
  {
    icon: "📢",
    title: "Share with Peers",
    desc: "Tweet, post on LinkedIn, or share in your developer communities (Reddit, Discord, Hacker News).",
    cta: "Share Visual Style Editor",
    href: "https://twitter.com/intent/tweet?text=Check%20out%20Visual%20Style%20Editor%20%E2%80%94%20a%20free%2C%20in-browser%20visual%20editor%20for%20HTML%20and%20Tailwind%20CSS!&url=https://visualstyleeditor.com",
    badge: "Community Growth"
  }
];

const tiers = [
  {
    name: "Supporter",
    price: "$5",
    freq: "/month",
    desc: "Helps cover our domain name, SSL certs, and continuous integration runners.",
    perks: ["Sponsor badge on GitHub", "Special Supporter role in Discord", "Our eternal gratitude"]
  },
  {
    name: "Backer",
    price: "$20",
    freq: "/month",
    desc: "Directly funds engineering time for new features like AST extensions and template creation.",
    perks: ["All Supporter perks", "Priority feature request voting", "Name listed on Support Hall of Fame", "Early access to v3 experimental builds"]
  },
  {
    name: "Enterprise Champion",
    price: "$100",
    freq: "/month",
    desc: "For digital agencies and studios using Visual Style Editor for commercial client production.",
    perks: ["All Backer perks", "Company logo with link on our homepage & repo", "Direct 1-on-1 support channel", "Custom starter template integration"]
  }
];
---

<BaseLayout
  title="Support & Sponsorship — Visual Style Editor"
  description="Visual Style Editor is 100% free with no login and zero telemetry. Help us keep it free forever through donations, sponsorships, or sharing."
  theme="light"
>
  <div class="relative min-h-screen flex flex-col bg-white overflow-hidden text-slate-900">
    <!-- Ambient Purple Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gradient-to-b from-purple-200/40 via-purple-100/20 to-transparent blur-[130px] pointer-events-none -z-10"></div>

    <Navbar activePage="support" />

    <main class="flex-1">
      <!-- HERO SECTION -->
      <section class="pt-16 pb-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto text-center space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-50 text-purple-700 border border-purple-200/80">
          <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
          100% Free & Open Source Forever
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-950 tracking-tight leading-[1.1]">
          Help us keep web tools <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 via-purple-600 to-rose-500">
            free, private, and open.
          </span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
          Visual Style Editor has zero investors, zero subscriptions, and zero paywalled features. If our tool saves you hours of development work, here is how you can support our mission.
        </p>
      </section>

      <!-- 4 SIMPLE WAYS TO SUPPORT -->
      <section class="pb-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {supportOptions.map((opt) => (
            <div class="p-1.5 sm:p-2 rounded-[2rem] bg-gradient-to-b from-purple-100/80 via-purple-50/40 to-slate-100/60 border border-purple-200/80 shadow-xs hover:shadow-xl hover:shadow-purple-500/10 transition-all flex flex-col justify-between">
              <div class="h-full rounded-[calc(2rem-0.5rem)] bg-white p-7 sm:p-8 flex flex-col justify-between space-y-6 shadow-[inset_0_1px_1px_rgba(255,255,255,1)]">
                <div class="space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="text-3xl">{opt.icon}</span>
                    <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-purple-50 text-purple-700 border border-purple-200">
                      {opt.badge}
                    </span>
                  </div>

                  <h3 class="text-xl font-bold text-slate-950 tracking-tight">{opt.title}</h3>
                  <p class="text-sm text-slate-600 leading-relaxed">{opt.desc}</p>
                </div>

                <a
                  href={opt.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-full text-xs font-semibold text-white bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-700 hover:to-purple-700 shadow-md shadow-purple-600/20 hover:-translate-y-0.5 transition-all"
                >
                  <span>{opt.cta}</span>
                  <span class="text-xs">↗</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- SPONSORSHIP TIERS -->
      <section class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-slate-50/50 border-t border-purple-100/60">
        <div class="max-w-6xl mx-auto space-y-12">
          <div class="text-center max-w-2xl mx-auto space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-purple-700 bg-purple-50 border border-purple-200/80 px-3 py-1 rounded-full">
              Sponsorship Tiers
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-950 tracking-tight">
              Fuel Continued Development
            </h2>
            <p class="text-sm sm:text-base text-slate-600">
              For individuals, teams, and agencies who rely on Visual Style Editor daily.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {tiers.map((t, idx) => (
              <div class={`p-1.5 sm:p-2 rounded-[2.5rem] ${
                idx === 1 
                  ? "bg-gradient-to-b from-purple-300 via-purple-200 to-violet-300 border-2 border-purple-400 shadow-xl shadow-purple-500/15" 
                  : "bg-gradient-to-b from-purple-100/80 to-slate-100/60 border border-purple-200/80 shadow-xs"
              } flex flex-col justify-between`}>
                <div class="h-full rounded-[calc(2.5rem-0.5rem)] bg-white p-7 sm:p-8 flex flex-col justify-between space-y-6 shadow-[inset_0_1px_1px_rgba(255,255,255,1)]">
                  <div class="space-y-4">
                    <div class="flex items-center justify-between">
                      <h3 class="text-lg font-bold text-slate-950">{t.name}</h3>
                      {idx === 1 && (
                        <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-purple-100 text-purple-800">
                          Most Popular
                        </span>
                      )}
                    </div>

                    <div class="flex items-baseline gap-1">
                      <span class="text-4xl font-extrabold text-slate-950">{t.price}</span>
                      <span class="text-xs font-medium text-slate-600">{t.freq}</span>
                    </div>

                    <p class="text-xs text-slate-600 leading-relaxed">{t.desc}</p>

                    <div class="pt-4 border-t border-purple-100 space-y-2">
                      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-700">Included Perks:</span>
                      <ul class="space-y-1.5 text-xs text-slate-600">
                        {t.perks.map((p) => (
                          <li class="flex items-center gap-2">
                            <span class="text-purple-600 font-bold">✓</span>
                            <span>{p}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <a
                    href="https://github.com/sponsors"
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-full text-xs font-semibold ${
                      idx === 1
                        ? "text-white bg-gradient-to-r from-violet-600 to-purple-600 shadow-md shadow-purple-600/25 hover:from-violet-700 hover:to-purple-700"
                        : "text-slate-800 bg-purple-50 hover:bg-purple-100 border border-purple-200"
                    } transition-all`}
                  >
                    <span>Sponsor this Tier</span>
                    <span class="text-xs">↗</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- TRANSPARENCY DECLARATION -->
      <section class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
        <div class="p-8 rounded-3xl bg-purple-50/60 border border-purple-200/80 text-center space-y-4">
          <h3 class="text-xl font-bold text-slate-950">Ethical Financial Transparency</h3>
          <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
            100% of sponsorship income is dedicated strictly to domain renewals, software signing certificates, continuous testing pipelines, and maintaining free public templates. We will never sell your data or gate features.
          </p>
        </div>
      </section>

      <!-- CTA BANNER -->
      <CtaBanner
        headline="Ready to build something amazing today?"
        subheadline="Jump right into the editor and start crafting your website."
      />
    </main>

    <Footer />
  </div>
</BaseLayout>
