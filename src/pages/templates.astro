---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";
import { TEMPLATE_REGISTRY } from "@/lib/templates/template-registry";

const categories = ["all", "landing", "saas", "portfolio", "blog", "component"] as const;
---

<BaseLayout
  title="Free Tailwind HTML Templates — Visual Style Editor"
  description="Browse and visually edit free responsive Tailwind CSS starter templates directly in your browser with zero installation."
  theme="light"
>
  <div class="relative min-h-screen flex flex-col bg-white overflow-hidden text-slate-900">
    <!-- Ambient Purple Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gradient-to-b from-purple-200/40 via-purple-100/20 to-transparent blur-[130px] pointer-events-none -z-10"></div>

    <Navbar activePage="templates" />

    <main class="flex-1">
      <!-- Title & Search Header -->
      <section class="pt-16 pb-12 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-center space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-50 text-purple-700 border border-purple-200/80">
          <span class="w-2 h-2 rounded-full bg-purple-600 animate-pulse"></span>
          Ready-To-Use Starter Library
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-950 tracking-tight leading-[1.1]">
          Starter Templates <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 via-purple-600 to-indigo-600">
            Engineered for Tailwind.
          </span>
        </h1>

        <p class="text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
          Clean, production-ready HTML layouts. Click any template to immediately launch and edit it in Visual Style Editor with zero setup.
        </p>

        <!-- Search Input -->
        <div class="pt-2 max-w-md mx-auto relative">
          <input
            id="template-search"
            type="text"
            placeholder="Search templates by keyword, category, or tag..."
            class="w-full px-5 py-3.5 pl-11 rounded-full bg-white border border-purple-200/90 text-slate-900 text-sm placeholder:text-slate-400 focus:outline-none focus:border-purple-600 focus:ring-4 focus:ring-purple-500/10 shadow-sm transition-all font-sans"
          />
          <svg class="w-4 h-4 text-purple-600 absolute left-4.5 top-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap justify-center gap-2 pt-2" id="category-filters">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-cat={cat}
              class={`filter-btn px-4 py-2 rounded-full text-xs font-semibold capitalize cursor-pointer transition-all ${
                idx === 0
                  ? "bg-gradient-to-r from-violet-600 to-purple-600 text-white shadow-md shadow-purple-600/20 active-cat"
                  : "bg-purple-50/70 hover:bg-purple-100/70 text-slate-700 border border-purple-200/60"
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      </section>

      <!-- Templates Grid -->
      <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="templates-grid">
          {TEMPLATE_REGISTRY.map((tpl) => (
            <div
              class="template-card p-2 sm:p-2.5 rounded-[2.5rem] bg-gradient-to-b from-purple-100/80 via-purple-50/40 to-slate-100/60 border border-purple-200/80 shadow-xs hover:shadow-xl hover:shadow-purple-500/10 transition-all flex flex-col justify-between"
              data-name={tpl.name.toLowerCase()}
              data-desc={tpl.description.toLowerCase()}
              data-tags={tpl.tags.join(" ").toLowerCase()}
              data-category={tpl.category}
            >
              <div class="rounded-[calc(2.5rem-0.625rem)] bg-white p-7 h-full flex flex-col justify-between space-y-6 shadow-[inset_0_1px_1px_rgba(255,255,255,1)]">
                <div class="space-y-4">
                  <!-- Thumbnail Header / Category Badges -->
                  <div class="flex items-center justify-between">
                    <span class="text-[11px] font-mono font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-purple-50 text-purple-700 border border-purple-200">
                      {tpl.category}
                    </span>
                    <span class="text-[11px] font-mono text-slate-400">HTML &bull; Tailwind</span>
                  </div>

                  <!-- Template Name & Description -->
                  <div>
                    <h3 class="text-xl font-bold text-slate-950 tracking-tight">{tpl.name}</h3>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mt-1.5">{tpl.description}</p>
                  </div>

                  <!-- Tags -->
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {tpl.tags.map((tag) => (
                      <span class="px-2.5 py-0.5 rounded-md text-[10px] font-mono bg-purple-50/60 text-purple-800 border border-purple-100">
                        #{tag}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Action Buttons -->
                <div class="pt-4 border-t border-purple-100/80 flex items-center gap-3">
                  <a
                    href={`/editor?template=${tpl.id}`}
                    class="flex-1 inline-flex items-center justify-center gap-2 py-3 px-4 rounded-full text-xs font-semibold text-white bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-700 hover:to-purple-700 shadow-md shadow-purple-600/20 hover:-translate-y-0.5 transition-all"
                  >
                    <span>Edit in Studio</span>
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14m-7-7 7 7-7 7"/>
                    </svg>
                  </a>

                  <a
                    href={`/templates/${tpl.id}.html`}
                    target="_blank"
                    download={`${tpl.id}.html`}
                    class="p-3 rounded-full text-slate-600 hover:text-purple-700 bg-purple-50/60 hover:bg-purple-100/60 border border-purple-200/60 transition-colors"
                    title="Download raw HTML"
                    aria-label={`Download ${tpl.name} HTML`}
                  >
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- No Results Fallback -->
        <div id="no-results" class="hidden py-16 text-center space-y-3">
          <p class="text-base font-semibold text-slate-700">No templates found matching your search.</p>
          <button id="reset-search" class="text-xs font-bold text-purple-700 hover:underline">
            Clear filters and show all templates
          </button>
        </div>
      </section>

      <!-- CTA BANNER -->
      <CtaBanner
        headline="Have your own HTML project?"
        subheadline="You don't have to start with a template. Drop your existing website files into the editor now."
        ctaText="Open Studio with Blank Canvas"
      />
    </main>

    <Footer />
  </div>
</BaseLayout>

<script is:inline>
  const searchInput = document.getElementById("template-search");
  const filterBtns = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".template-card");
  const noResults = document.getElementById("no-results");
  const resetBtn = document.getElementById("reset-search");

  let activeCategory = "all";
  let searchQuery = "";

  function applyFilters() {
    let visibleCount = 0;
    const query = searchQuery.trim().toLowerCase();

    cards.forEach((card) => {
      const cat = card.getAttribute("data-category") || "";
      const name = card.getAttribute("data-name") || "";
      const desc = card.getAttribute("data-desc") || "";
      const tags = card.getAttribute("data-tags") || "";

      const matchesCat = activeCategory === "all" || cat === activeCategory;
      const matchesSearch = !query || name.includes(query) || desc.includes(query) || tags.includes(query);

      if (matchesCat && matchesSearch) {
        card.style.display = "flex";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove("hidden");
      } else {
        noResults.classList.add("hidden");
      }
    }
  }

  searchInput?.addEventListener("input", (e) => {
    searchQuery = e.target.value;
    applyFilters();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => {
        b.className = "filter-btn px-4 py-2 rounded-full text-xs font-semibold capitalize cursor-pointer transition-all bg-purple-50/70 hover:bg-purple-100/70 text-slate-700 border border-purple-200/60";
      });
      btn.className = "filter-btn px-4 py-2 rounded-full text-xs font-semibold capitalize cursor-pointer transition-all bg-gradient-to-r from-violet-600 to-purple-600 text-white shadow-md shadow-purple-600/20 active-cat";
      activeCategory = btn.getAttribute("data-cat") || "all";
      applyFilters();
    });
  });

  resetBtn?.addEventListener("click", () => {
    if (searchInput) searchInput.value = "";
    searchQuery = "";
    activeCategory = "all";
    filterBtns[0]?.click();
  });
</script>
