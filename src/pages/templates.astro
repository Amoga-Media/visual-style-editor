---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";
import FloatingBadges from "@/components/marketing/FloatingBadges";
import TemplatePreviewModal from "@/components/marketing/TemplatePreviewModal";
import { TEMPLATE_REGISTRY } from "@/lib/templates/template-registry";
import Icon from "@/components/ui/Icon.astro";

const categories = ["all", "landing", "saas", "portfolio", "blog", "component"] as const;

const categoryThemes: Record<string, { pillClass: string; iconClass: string }> = {
  landing: {
    pillClass: "bg-purple-100 text-purple-900 border-purple-300 dark:bg-purple-950/50 dark:text-purple-300 dark:border-purple-500/40",
    iconClass: "bg-purple-100 text-purple-800 border-purple-300 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-500/40",
  },
  saas: {
    pillClass: "bg-sky-100 text-sky-900 border-sky-300 dark:bg-sky-950/50 dark:text-sky-300 dark:border-sky-500/40",
    iconClass: "bg-sky-100 text-sky-800 border-sky-300 dark:bg-sky-950/40 dark:text-sky-300 dark:border-sky-500/40",
  },
  portfolio: {
    pillClass: "bg-emerald-100 text-emerald-900 border-emerald-300 dark:bg-emerald-950/50 dark:text-emerald-300 dark:border-emerald-500/40",
    iconClass: "bg-emerald-100 text-emerald-800 border-emerald-300 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-500/40",
  },
  blog: {
    pillClass: "bg-pink-100 text-pink-900 border-pink-300 dark:bg-pink-950/50 dark:text-pink-300 dark:border-pink-500/40",
    iconClass: "bg-pink-100 text-pink-800 border-pink-300 dark:bg-pink-950/40 dark:text-pink-300 dark:border-pink-500/40",
  },
  component: {
    pillClass: "bg-amber-100 text-amber-900 border-amber-300 dark:bg-amber-950/50 dark:text-amber-300 dark:border-amber-500/40",
    iconClass: "bg-amber-100 text-amber-800 border-amber-300 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-500/40",
  },
};

const collectionPageSchema = {
  "@type": "CollectionPage",
  "@id": "https://visualstyleeditor.com/templates#collection",
  "name": "Free HTML & Tailwind CSS Starter Templates",
  "description": "Browse 12+ free responsive HTML and Tailwind CSS starter templates with live in-browser visual editing.",
  "mainEntity": {
    "@type": "ItemList",
    "name": "Tailwind CSS Starter Templates Collection",
    "numberOfItems": TEMPLATE_REGISTRY.length,
    "itemListElement": TEMPLATE_REGISTRY.map((tmpl, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": tmpl.name,
      "description": tmpl.description,
      "url": `https://visualstyleeditor.com/templates#${tmpl.id}`
    }))
  }
};

const breadcrumbs = [
  { name: "Home", item: "https://visualstyleeditor.com/" },
  { name: "Starter Templates", item: "https://visualstyleeditor.com/templates" }
];
---

<BaseLayout
  title="Tailwind UI Starter Templates — Visual Style Editor"
  description="Browse 12+ free responsive HTML and Tailwind CSS starter templates. Click any template to edit it visually in the browser with zero setup or cloud fees."
  breadcrumbs={breadcrumbs}
  customEntities={[collectionPageSchema]}
>
  <div class="flex flex-col min-h-[100dvh]">
    <Navbar activePage="templates" />

    <main id="main-content" class="flex-1">

      <!-- ============================================================
           HERO: Editorial Header with Search & Filter
           ============================================================ -->
      <section class="relative overflow-hidden pt-8 sm:pt-12 md:pt-14 pb-12 lg:pb-14 px-4 sm:px-6 lg:px-8" data-parallax-section>
        {/* Vibrant Multi-Layered Ambient Studio Aura & Grid Texture */}
        <div class="hero-ambient-glow" aria-hidden="true">
          <div class="hero-glow-orb"></div>
          <div class="hero-grid-pattern"></div>
        </div>

        <div class="max-w-6xl mx-auto relative z-10 space-y-8">
          <div class="max-w-3xl space-y-6" data-reveal="fade-up">
            <div
              class="inline-flex items-center gap-2 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-mono font-bold uppercase tracking-wider border select-none shadow-sm backdrop-blur-xl bg-purple-50 text-purple-800 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-500/40"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse shrink-0"></span>
              <span class="truncate">12 Production-Ready Templates • 100% Free</span>
            </div>

            <h1
              class="text-display text-3xl sm:text-5xl md:text-6xl font-black tracking-tight leading-[1.12] sm:leading-[1.08]"
              data-motion-text="words"
            >
              Starter templates.<br />
              <span class="gradient-text">Open and edit immediately.</span>
            </h1>

            <div data-aeo-answer class="text-xs sm:text-sm p-4 rounded-xl mt-4 mb-2 text-left bg-purple-500/10 border border-purple-500/20 text-purple-900 dark:text-purple-200">
              <p><strong>Direct Answer:</strong> Visual Style Editor provides 12+ free, production-ready HTML and Tailwind CSS starter templates (SaaS dashboards, agency portfolios, marketing landing pages, and bento grids). Selecting any template immediately initializes the local in-browser studio with zero configuration, no sign-in, and zero cloud hosting fees.</p>
            </div>

            <p class="text-body text-sm sm:text-base md:text-lg" style="color: var(--ink-2);">
              Don't have an HTML file ready? Pick a free, responsive starter template below and customize it in the visual studio right now — zero accounts, zero downloads.
            </p>

            <div class="pt-2">
              <FloatingBadges client:load />
            </div>
          </div>

          <!-- Hero Studio Workstation Graphic with Responsive Picture -->
          <div class="max-w-5xl mx-auto pt-2" data-reveal="fade-up">
            <div class="glass-window-frame p-1.5 sm:p-2.5 group overflow-hidden">
              <div class="px-4 py-2 flex items-center justify-between border-b rounded-t-xl select-none text-xs font-mono text-zinc-400" style="background: rgba(18, 18, 21, 0.75); border-color: rgba(255, 255, 255, 0.08);">
                <div class="flex items-center gap-2">
                  <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></div>
                  <span class="ml-2 hidden sm:inline">templates • instant-canvas-preview</span>
                </div>
                <span class="text-purple-400 font-semibold text-[11px]">12 Starter Blueprints</span>
              </div>
              <div class="relative rounded-lg overflow-hidden bg-black aspect-[16/9] max-sm:aspect-[9/13]">
                <picture class="block w-full h-full">
                  <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/01-editor-overview-mobile.png" />
                  <img
                    src="/images/editor-snapshots/desktop/01-editor-overview-desktop.png"
                    alt="Visual Style Editor Template Studio Canvas"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]"
                    loading="eager"
                  />
                </picture>
              </div>
            </div>
          </div>

          <!-- Filter & Search Controls Bar -->
          <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 pt-4 border-t" style="border-color: var(--border);" data-reveal="fade-up">
            <!-- Filter Tabs with horizontal swipe on mobile -->
            <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 -mx-4 px-4 sm:mx-0 sm:px-0 touch-pan-x flex-nowrap sm:flex-wrap">
              {categories.map((cat) => (
                <button
                  data-filter={cat}
                  class={`filter-btn px-4 py-2 rounded-xl text-xs font-mono font-semibold uppercase tracking-wider cursor-pointer border transition-all duration-150 shrink-0 whitespace-nowrap active:scale-95 ${cat === 'all' ? 'filter-active' : ''}`}
                  style={cat === 'all' ? 'background: var(--ink-1); color: var(--canvas); border-color: var(--ink-1);' : 'background: var(--surface-1); color: var(--ink-2); border-color: var(--border);'}
                >
                  {cat}
                </button>
              ))}
            </div>

            <!-- Search Input -->
            <div class="relative w-full md:w-72">
              <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color: var(--ink-3);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
              </svg>
              <input
                id="template-search"
                type="text"
                placeholder="Filter templates..."
                class="w-full pl-10 pr-4 py-2.5 rounded-xl text-xs font-mono outline-none transition-colors border"
                style="background: var(--surface-1); border-color: var(--border-strong); color: var(--ink-1);"
              />
            </div>
          </div>
        </div>
      </section>

      <hr class="section-divider" />

      <!-- ============================================================
           TEMPLATE CARDS GRID
           ============================================================ -->
      <section class="section py-16">
        <div class="section-inner">
          <div id="template-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-reveal-group>
            {TEMPLATE_REGISTRY.map((tmpl, i) => {
              const theme = categoryThemes[tmpl.category] || categoryThemes.landing;
              return (
                <article
                  class={`template-card card group flex flex-col justify-between overflow-hidden rounded-3xl border transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl`}
                  data-reveal-item
                  data-category={tmpl.category}
                  data-title={(tmpl.name || '').toLowerCase()}
                  data-tags={(tmpl.tags || []).join(' ')}
                  style="background: var(--surface-1); border-color: var(--border);"
                >
                  <!-- Preview Header Box with Real Responsive Screenshot (Click to preview) -->
                  <div
                    class="relative overflow-hidden border-b cursor-pointer group/preview aspect-[16/10] bg-zinc-950"
                    data-preview-template={tmpl.id}
                    title="Click to preview template"
                    style="border-color: var(--border);"
                  >
                    <picture class="block w-full h-full">
                      <source media="(max-width: 640px)" srcset={`/images/templates/mobile/${tmpl.id}-mobile.png`} />
                      <img
                        src={`/images/templates/desktop/${tmpl.id}-desktop.png`}
                        alt={`${tmpl.name} template canvas preview`}
                        class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105"
                        loading="lazy"
                        width="800"
                        height="500"
                      />
                    </picture>

                    <!-- Frosted Glass Gradient Overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent pointer-events-none"></div>

                    <!-- Top Category & ID Pill -->
                    <div class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none">
                      <span
                        class={`px-2.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider border backdrop-blur-md ${theme.pillClass}`}
                      >
                        {tmpl.category}
                      </span>
                      <span class="text-[11px] font-mono font-medium px-2 py-0.5 rounded-md bg-black/60 text-zinc-300 border border-white/10 backdrop-blur-md">
                        {tmpl.id}.html
                      </span>
                    </div>

                    <!-- Bottom Quick Info Bar -->
                    <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between pointer-events-none">
                      <div class="flex items-center gap-2">
                        <div
                          class={`w-7 h-7 rounded-lg flex items-center justify-center border shadow-md ${theme.iconClass}`}
                        >
                          <Icon name={`category-${tmpl.category}`} class="w-4 h-4" />
                        </div>
                        <span class="text-[11px] font-mono font-bold text-white drop-shadow">
                          Live Canvas Ready
                        </span>
                      </div>
                      <span class="text-[10px] font-mono text-emerald-400 font-semibold px-2 py-0.5 rounded bg-emerald-950/60 border border-emerald-500/30 backdrop-blur-md">
                        ✓ AST Splicing
                      </span>
                    </div>
                  </div>

                  <!-- Card Body -->
                  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                    <div class="space-y-1.5">
                      <h3 class="text-base font-bold tracking-tight transition-colors group-hover:text-purple-600 dark:group-hover:text-purple-400" style="color: var(--ink-1);">
                        {tmpl.name}
                      </h3>
                      <p class="text-xs leading-relaxed line-clamp-2" style="color: var(--ink-2);">
                        {tmpl.description}
                      </p>
                    </div>

                    <!-- Tags Chips -->
                    <div class="flex flex-wrap gap-1.5 pt-1">
                      {tmpl.tags.map((tag) => (
                        <span class="text-[10px] font-mono px-2 py-0.5 rounded-md border font-medium" style="background: var(--surface-2); border-color: var(--border); color: var(--ink-2);">
                          #{tag}
                        </span>
                      ))}
                    </div>

                    <!-- Bottom Action Buttons: Preview & Open in Studio -->
                    <div class="flex items-center justify-between pt-4 border-t gap-2" style="border-color: var(--border);">
                      <button
                        type="button"
                        data-preview-template={tmpl.id}
                        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-mono font-semibold transition-all duration-150 hover:border-purple-500 hover:text-purple-600 border cursor-pointer"
                        style="background: var(--surface-2); border-color: var(--border); color: var(--ink-1);"
                        title="Preview rendered HTML"
                      >
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                          <circle cx="12" cy="12" r="3" />
                        </svg>
                        <span>Preview</span>
                      </button>

                      <a
                        href={`/editor?template=${tmpl.id}`}
                        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-mono font-bold transition-all duration-150 hover:scale-[1.02] bg-purple-700 hover:bg-purple-800 text-white shadow-sm"
                        style="text-decoration: none;"
                      >
                        <span>Open in Studio</span>
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <!-- Empty State -->
          <div id="no-results" class="hidden py-24 text-center space-y-3">
            <p class="text-xl font-bold" style="color: var(--ink-2);">No templates match that query.</p>
            <p class="text-sm text-zinc-500">Try searching for "hero", "saas", "dashboard", or "pricing".</p>
          </div>
        </div>
      </section>

      <CtaBanner
        headline="Build your own starting point."
        subheadline="Open an empty canvas in the editor and start from scratch. Or drop any existing local HTML file."
        ctaText="Launch Visual Studio"
      />
    </main>

    <Footer />
  </div>

  <TemplatePreviewModal client:load />
</BaseLayout>

<script is:inline>
  (function() {
    var searchInput = document.getElementById('template-search');
    var filterBtns = document.querySelectorAll('.filter-btn');
    var cards = document.querySelectorAll('.template-card');
    var noResults = document.getElementById('no-results');
    var currentFilter = 'all';
    var currentSearch = '';

    function applyFilters() {
      var visible = 0;
      cards.forEach(function(card) {
        var cat = card.getAttribute('data-category') || '';
        var title = card.getAttribute('data-title') || '';
        var tags = card.getAttribute('data-tags') || '';
        var matchesFilter = currentFilter === 'all' || cat === currentFilter;
        var matchesSearch = !currentSearch || title.includes(currentSearch) || tags.includes(currentSearch);
        if (matchesFilter && matchesSearch) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });
      if (noResults) noResults.classList.toggle('hidden', visible > 0);
    }

    filterBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        filterBtns.forEach(function(b) {
          b.style.background = 'var(--surface-1)';
          b.style.color = 'var(--ink-2)';
          b.style.borderColor = 'var(--border)';
        });
        btn.style.background = 'var(--ink-1)';
        btn.style.color = 'var(--canvas)';
        btn.style.borderColor = 'var(--ink-1)';
        currentFilter = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', function() {
        currentSearch = searchInput.value.toLowerCase();
        applyFilters();
      });
    }
  })();
</script>
