---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";
import { TEMPLATE_REGISTRY } from "@/lib/templates/template-registry";

const categories = ["all", "landing", "saas", "portfolio", "blog", "component"] as const;
---

<BaseLayout
  title="Free Tailwind HTML Templates — Visual Style Editor"
  description="Browse and visually edit free responsive Tailwind CSS starter templates directly in your browser with zero installation."
  theme="dark"
  showPixelCanvas={true}
>
  <div class="relative min-h-screen flex flex-col bg-[#060608] text-slate-100 overflow-hidden">
    <Navbar activePage="templates" />

    <main class="flex-1">
      <!-- Title & Search Header -->
      <section class="pt-16 pb-14 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-center space-y-8">
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-cyan-950/60 text-cyan-300 border border-cyan-500/30 shadow-lg shadow-cyan-500/10">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          Ready-To-Use Starter Library
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.1]">
          Starter Templates <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">
            Engineered for Tailwind.
          </span>
        </h1>

        <p class="text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Clean, production-ready HTML layouts. Click any template to immediately launch and edit it in Visual Style Editor with zero setup.
        </p>

        <!-- Search Input -->
        <div class="pt-2 max-w-md mx-auto relative">
          <input
            id="template-search"
            type="text"
            placeholder="Search templates by keyword, category, or tag..."
            class="w-full px-5 py-3.5 pl-11 rounded-full bg-[#0c0e14] border border-white/10 text-white text-sm placeholder:text-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-4 focus:ring-cyan-500/15 shadow-inner transition-all font-mono"
          />
          <svg class="w-4 h-4 text-cyan-400 absolute left-4.5 top-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap justify-center gap-2 pt-2" id="category-filters">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-cat={cat}
              class={`filter-btn px-4 py-2 rounded-full text-xs font-mono font-semibold capitalize cursor-pointer transition-all ${
                idx === 0
                  ? "bg-gradient-to-r from-cyan-400 to-sky-300 text-black shadow-lg shadow-cyan-500/25 active-cat font-bold"
                  : "bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10"
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      </section>

      <!-- Templates Grid -->
      <section class="py-12 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="templates-grid">
          {TEMPLATE_REGISTRY.map((tpl) => (
            <div
              class="template-card doppelrand-shell spotlight-card transition-all flex flex-col justify-between"
              data-name={tpl.name.toLowerCase()}
              data-desc={tpl.description.toLowerCase()}
              data-tags={tpl.tags.join(" ").toLowerCase()}
              data-category={tpl.category}
            >
              <div class="doppelrand-core p-7 h-full flex flex-col justify-between space-y-6">
                <div class="space-y-4">
                  <!-- Category Badge & Format -->
                  <div class="flex items-center justify-between">
                    <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-cyan-950/60 text-cyan-300 border border-cyan-500/30">
                      {tpl.category}
                    </span>
                    <span class="text-[10px] font-mono text-slate-400">HTML &bull; Tailwind</span>
                  </div>

                  <!-- Template Name & Description -->
                  <div>
                    <h3 class="text-xl font-bold text-white tracking-tight">{tpl.name}</h3>
                    <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mt-2">{tpl.description}</p>
                  </div>

                  <!-- Tags -->
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {tpl.tags.map((tag) => (
                      <span class="px-2.5 py-0.5 rounded-md text-[10px] font-mono bg-white/5 text-slate-300 border border-white/10">
                        #{tag}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Action Buttons -->
                <div class="pt-5 border-t border-white/10 flex items-center gap-3">
                  <a
                    href={`/editor?template=${tpl.id}`}
                    class="flex-1 inline-flex items-center justify-center gap-2 py-3 px-4 rounded-full text-xs font-bold text-black bg-gradient-to-r from-cyan-400 via-sky-300 to-cyan-300 hover:brightness-110 shadow-md shadow-cyan-500/20 active:scale-98 transition-all"
                  >
                    <span>Edit in Studio</span>
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14m-7-7 7 7-7 7"/>
                    </svg>
                  </a>

                  <a
                    href={`/templates/${tpl.id}.html`}
                    target="_blank"
                    download={`${tpl.id}.html`}
                    class="p-3 rounded-full text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-colors"
                    title="Download raw HTML"
                    aria-label={`Download ${tpl.name} HTML`}
                  >
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- No Results Fallback -->
        <div id="no-results" class="hidden py-16 text-center space-y-3">
          <p class="text-base font-semibold text-slate-300">No templates found matching your search.</p>
          <button id="reset-search" class="text-xs font-mono font-bold text-cyan-400 hover:underline">
            Clear filters and show all templates
          </button>
        </div>
      </section>

      <!-- CTA BANNER -->
      <CtaBanner
        headline="Have your own HTML project?"
        subheadline="You don't have to start with a template. Drop your existing website files into the editor now."
        ctaText="Open Studio with Blank Canvas"
      />
    </main>

    <Footer />
  </div>
</BaseLayout>

<script is:inline>
  const searchInput = document.getElementById("template-search");
  const filterBtns = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".template-card");
  const noResults = document.getElementById("no-results");
  const resetBtn = document.getElementById("reset-search");

  let activeCategory = "all";
  let searchQuery = "";

  function applyFilters() {
    let visibleCount = 0;
    const query = searchQuery.trim().toLowerCase();

    cards.forEach((card) => {
      const cat = card.getAttribute("data-category") || "";
      const name = card.getAttribute("data-name") || "";
      const desc = card.getAttribute("data-desc") || "";
      const tags = card.getAttribute("data-tags") || "";

      const matchesCat = activeCategory === "all" || cat === activeCategory;
      const matchesSearch = !query || name.includes(query) || desc.includes(query) || tags.includes(query);

      if (matchesCat && matchesSearch) {
        card.style.display = "flex";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove("hidden");
      } else {
        noResults.classList.add("hidden");
      }
    }
  }

  searchInput?.addEventListener("input", (e) => {
    searchQuery = e.target.value;
    applyFilters();
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => {
        b.className = "filter-btn px-4 py-2 rounded-full text-xs font-mono font-semibold capitalize cursor-pointer transition-all bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10";
      });
      btn.className = "filter-btn px-4 py-2 rounded-full text-xs font-mono font-semibold capitalize cursor-pointer transition-all bg-gradient-to-r from-cyan-400 to-sky-300 text-black shadow-lg shadow-cyan-500/25 active-cat font-bold";
      activeCategory = btn.getAttribute("data-cat") || "all";
      applyFilters();
    });
  });

  resetBtn?.addEventListener("click", () => {
    if (searchInput) searchInput.value = "";
    searchQuery = "";
    activeCategory = "all";
    filterBtns[0]?.click();
  });
</script>
