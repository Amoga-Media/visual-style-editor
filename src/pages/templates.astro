---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { TEMPLATE_REGISTRY } from "@/lib/templates/template-registry";

const categories = ["all", "landing", "saas", "portfolio", "blog", "component"] as const;
---

<BaseLayout
  title="Free Tailwind HTML Templates — Visual Style Editor"
  description="Browse and edit free responsive Tailwind CSS starter templates directly in your browser with zero installation."
>
  <main class="min-h-screen bg-[#09090b] text-zinc-100 flex flex-col justify-between selection:bg-[#0084FF] selection:text-white">
    <!-- Header Navigation -->
    <header class="border-b border-white/[0.06] bg-[#09090b]/80 backdrop-blur-xl sticky top-0 z-40">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#0084FF] to-blue-500 flex items-center justify-center text-white shadow-lg shadow-[#0084FF]/25 group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
            </svg>
          </div>
          <span class="font-bold text-sm tracking-tight text-white">Visual Style Editor</span>
        </a>

        <div class="flex items-center gap-4">
          <a href="/support" class="text-xs text-rose-400/90 hover:text-rose-300 transition-colors hidden sm:inline">
            Support
          </a>
          <a
            href="/editor"
            class="text-xs font-semibold px-4 py-2 rounded-xl bg-[#0084FF] hover:bg-[#0074E0] active:scale-95 text-white shadow-lg shadow-[#0084FF]/25 transition-all flex items-center gap-1.5"
          >
            <span>Open Blank Editor</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14m-7-7 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <div class="max-w-6xl mx-auto px-6 py-16 flex-1 w-full space-y-10">
      <!-- Title & Search Header -->
      <div class="text-center max-w-2xl mx-auto space-y-4">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Starter Templates
        </h1>
        <p class="text-zinc-400 text-sm sm:text-base leading-relaxed">
          Clean, modern Tailwind HTML layouts. Click any template to immediately open and visually edit it in Visual Style Editor.
        </p>

        <!-- Search Input -->
        <div class="pt-4 max-w-md mx-auto relative">
          <input
            id="template-search"
            type="text"
            placeholder="Search templates by name, keyword, or tag..."
            class="w-full px-4 py-3 pl-10 rounded-xl bg-[#111115] border border-white/[0.1] text-white text-xs placeholder:text-zinc-500 focus:outline-none focus:border-[#0084FF] transition-colors font-sans shadow-lg"
          />
          <svg class="w-4 h-4 text-zinc-500 absolute left-3.5 top-7.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap justify-center gap-1.5 pt-2" id="category-filters">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-cat={cat}
              class={`filter-btn px-3 py-1.5 rounded-lg text-xs font-medium capitalize cursor-pointer transition-all ${
                idx === 0
                  ? "bg-[#0084FF] text-white font-semibold shadow-md shadow-[#0084FF]/25 active-cat"
                  : "bg-white/[0.05] hover:bg-white/[0.08] text-zinc-400 hover:text-zinc-200"
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Templates Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="templates-grid">
        {TEMPLATE_REGISTRY.map((tpl) => (
          <div
            class="template-card p-6 rounded-2xl bg-[#111115] border border-white/[0.08] hover:border-white/[0.2] transition-all flex flex-col justify-between space-y-5 shadow-lg group relative overflow-hidden"
            data-name={tpl.name.toLowerCase()}
            data-desc={tpl.description.toLowerCase()}
            data-tags={tpl.tags.join(" ").toLowerCase()}
            data-category={tpl.category}
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/[0.06] text-zinc-300 border border-white/[0.06]">
                  {tpl.category}
                </span>
                <span class="text-[10px] font-mono text-zinc-500">HTML &bull; Tailwind</span>
              </div>
              <h2 class="text-lg font-bold text-white group-hover:text-[#0084FF] transition-colors">
                {tpl.name}
              </h2>
              <p class="text-xs text-zinc-400 leading-relaxed">
                {tpl.description}
              </p>
            </div>

            <div class="space-y-4 pt-2">
              <div class="flex flex-wrap gap-1">
                {tpl.tags.map((tag) => (
                  <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-white/[0.03] text-zinc-400 border border-white/[0.04]">
                    #{tag}
                  </span>
                ))}
              </div>

              <a
                href={`/editor?template=${tpl.id}`}
                class="w-full py-2.5 rounded-xl bg-white/[0.06] hover:bg-[#0084FF] hover:text-white text-zinc-200 text-xs font-semibold flex items-center justify-center gap-1.5 transition-all cursor-pointer shadow-xs"
              >
                <span>Open in Editor</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Empty State -->
      <div id="no-results" class="hidden text-center py-16 space-y-2">
        <p class="text-zinc-400 text-sm">No templates found matching your search.</p>
        <button id="reset-filters" class="text-xs text-[#0084FF] hover:underline cursor-pointer">
          Reset all filters
        </button>
      </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-white/[0.06] py-8 text-center text-xs text-zinc-500">
      <p>Visual Style Editor &bull; 100% Free &bull; Open-Source</p>
    </footer>
  </main>

  <script is:inline>
    const searchInput = document.getElementById("template-search");
    const filterBtns = document.querySelectorAll(".filter-btn");
    const cards = document.querySelectorAll(".template-card");
    const noResults = document.getElementById("no-results");
    const resetBtn = document.getElementById("reset-filters");

    let currentCategory = "all";
    let searchQuery = "";

    function filterCards() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const name = card.getAttribute("data-name") || "";
        const desc = card.getAttribute("data-desc") || "";
        const tags = card.getAttribute("data-tags") || "";
        const cat = card.getAttribute("data-category") || "";

        const matchesCat = currentCategory === "all" || cat === currentCategory;
        const matchesQuery = !searchQuery || name.includes(searchQuery) || desc.includes(searchQuery) || tags.includes(searchQuery);

        if (matchesCat && matchesQuery) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove("hidden");
        } else {
          noResults.classList.add("hidden");
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterCards();
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => {
          b.classList.remove("bg-[#0084FF]", "text-white", "font-semibold", "shadow-md", "shadow-[#0084FF]/25", "active-cat");
          b.classList.add("bg-white/[0.05]", "text-zinc-400");
        });
        btn.classList.remove("bg-white/[0.05]", "text-zinc-400");
        btn.classList.add("bg-[#0084FF]", "text-white", "font-semibold", "shadow-md", "shadow-[#0084FF]/25", "active-cat");

        currentCategory = btn.getAttribute("data-cat") || "all";
        filterCards();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        searchQuery = "";
        const allBtn = document.querySelector('[data-cat="all"]');
        if (allBtn) allBtn.click();
      });
    }
  </script>
</BaseLayout>
