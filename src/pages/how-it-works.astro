---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";
import FloatingBadges from "@/components/marketing/FloatingBadges";
import HardwareSpecs from "@/components/marketing/HardwareSpecs.astro";
import Icon from "@/components/ui/Icon.astro";

const steps = [
  {
    step: "01",
    iconName: "step-folder",
    title: "Open Your HTML File or Project Folder",
    tech: "W3C File System Access API",
    tagline: "Air-gapped memory ingestion. 0 bytes uploaded to any remote server.",
    body: "Drag and drop any HTML file from your hard drive, select a local project folder, or paste HTML generated by AI assistants like Claude, Cursor, v0, or Bolt. The browser prompts for local file access once per session, reading the markup into browser memory. Your code never leaves your computer.",
    badgeClass: "cyan",
    image: "/images/editor-snapshots/desktop/01-editor-overview-desktop.png",
    imageMobile: "/images/editor-snapshots/mobile/01-editor-overview-mobile.png",
    imageLabel: "Studio Workspace Canvas & Ingestion",
    zoomOrigin: "50% 50%",
    code: `const [fileHandle] = await window.showOpenFilePicker({
  types: [{ 
    description: 'HTML Files', 
    accept: { 'text/html': ['.html', '.htm'] } 
  }]
});
const file = await fileHandle.getFile();
const sourceHtml = await file.text();
// The file is now in browser memory. Zero uploads.`,
    chips: ["Chrome 86+", "Edge 86+", "Brave", "Arc", "Opera"]
  },
  {
    step: "02",
    iconName: "step-ast",
    title: "Map Every Element Without Breaking Any Code",
    tech: "Parse5 Source Location Tracking",
    tagline: "Pinpoints exact class coordinates while keeping comments and templates 100% safe.",
    body: "Traditional visual editors break code because they parse the whole page and serialize it back out scrambled. Visual Style Editor uses Parse5 with source location tracking to index the exact byte coordinates of every class name, tag, and comment. Because it knows exact coordinates, surrounding code is never touched.",
    badgeClass: "violet",
    image: "/images/editor-snapshots/desktop/02-editor-layers-pages-desktop.jpg",
    imageMobile: "/images/editor-snapshots/mobile/02-editor-layers-pages-mobile.jpg",
    imageLabel: "Pages & Parse5 AST Location Tracker",
    zoomOrigin: "15% 35%",
    code: `const ast = parse5.parse(sourceHtml, { 
  sourceCodeLocationInfo: true 
});

// Each attribute receives precise byte positions:
// attrLoc.startOffset = 127
// attrLoc.endOffset   = 163
// Entire surrounding document remains intact.`,
    chips: ["0ms AST overhead", "Preserves comments", "Bit-for-bit DOCTYPE preservation"]
  },
  {
    step: "03",
    iconName: "step-canvas",
    title: "Render in an Isolated Live Canvas",
    tech: "Sandboxed iframe + postMessage",
    tagline: "High-fidelity rendering with live bi-directional selection bridge.",
    body: "Your HTML renders inside an isolated, sandboxed preview canvas. When you click any button, headline, or card, the selection bridge instantly highlights the element, displaying its active Tailwind classes and computed box-model metrics at 60 FPS.",
    badgeClass: "lime",
    image: "/images/editor-snapshots/desktop/03-editor-classes-system-desktop.jpg",
    imageMobile: "/images/editor-snapshots/mobile/03-editor-classes-system-mobile.jpg",
    imageLabel: "Live Studio Canvas & Tailwind Classes System",
    zoomOrigin: "50% 50%",
    code: `// Canvas selection bridge
iframe.contentWindow.addEventListener('click', (e) => {
  const rect = e.target.getBoundingClientRect();
  const styles = getComputedStyle(e.target);
  parent.postMessage({ 
    type: 'ELEMENT_SELECTED', rect, styles 
  }, '*');
});`,
    chips: ["60 FPS requestAnimationFrame", "Bi-directional bridge", "Multi-viewport presets"]
  },
  {
    step: "04",
    iconName: "step-sliders",
    title: "Adjust Styles with Tactile Controls",
    tech: "Live style engine + Tailwind forward-map",
    tagline: "Tactile spring sliders translated directly into idiomatic Tailwind classes.",
    body: "The right inspector displays tactile spring controls for concentric box-model spacing, typography hierarchy, OKLCH color palettes, and radius. As you move a slider, the preview element updates in real-time and the forward-map engine generates idiomatic classes.",
    badgeClass: "amber",
    image: "/images/editor-snapshots/desktop/06-editor-padding-boxmodel-desktop.jpg",
    imageMobile: "/images/editor-snapshots/mobile/06-editor-padding-boxmodel-mobile.jpg",
    imageLabel: "Tactile Box Model: Padding, Margin & Color Controls",
    zoomOrigin: "85% 25%",
    code: `// Forward-map: CSS value → Idiomatic Tailwind class
forwardMap('font-weight', '600')   → 'font-semibold'
forwardMap('padding',     '1.5rem') → 'p-6'
forwardMap('color',       '#09090b') → 'text-zinc-950'

// Arbitrary values synthesized only as last resort
forwardMap('opacity', '0.73') → 'opacity-[73%]'`,
    chips: ["v3 utilities", "v4 @theme tokens", "OKLCH Color Lab", "WCAG AAA Validation"]
  },
  {
    step: "05",
    iconName: "step-splice",
    title: "Change Only What You Touched (Zero Broken Code)",
    tech: "String splice with byte offsets",
    tagline: "Only the modified class name updates. Surrounding code stays 100% untouched.",
    body: "When you adjust a slider or choose a color, Visual Style Editor updates only the specific characters inside that element's class attribute. Your HTML indentation, Blade/PHP tags, external scripts, and developer notes remain bit-for-bit identical with clean Git diffs.",
    badgeClass: "violet",
    image: "/images/editor-snapshots/desktop/08-editor-ast-splice-diff-desktop.jpg",
    imageMobile: "/images/editor-snapshots/mobile/08-editor-ast-splice-diff-mobile.jpg",
    imageLabel: "Character-Offset Surgical Byte Splicer & Diff",
    zoomOrigin: "50% 50%",
    code: `const before = sourceHtml.slice(0, attrLoc.startOffset);
const after  = sourceHtml.slice(attrLoc.endOffset);
const newAttr = \`class="\${newClasses}"\`;
const result = before + newAttr + after;

// Comments on line 42? Intact.
// PHP/Blade conditionals? 100% untouched.`,
    chips: ["0 collateral delta", "Byte slice rejoining", "Local git diff clean"]
  },
  {
    step: "06",
    iconName: "step-save",
    title: "Write Directly to Disk or Export Clean Code",
    tech: "W3C File System Access API writable stream",
    tagline: "Direct disk commit or export to HTML, JSX, and Astro with one click.",
    body: "In Chromium browsers, the native W3C File System Access API writes edits directly to your local file in under 2ms with zero cloud lag. When finished, you can also export your work as clean HTML, a React JSX component with className syntax, or an Astro island.",
    badgeClass: "lime",
    image: "/images/editor-snapshots/desktop/07-editor-export-studio-desktop.jpg",
    imageMobile: "/images/editor-snapshots/mobile/07-editor-export-studio-mobile.jpg",
    imageLabel: "Export Studio: HTML, JSX, Astro & Direct Disk Commit",
    zoomOrigin: "50% 50%",
    code: `const writable = await fileHandle.createWritable();
await writable.write(splicedHtml);
await writable.close();

// Multi-framework export also available:
// - Clean HTML
// - React JSX
// - Astro Component`,
    chips: ["<2ms disk IO", "Atomic stream write", "Git history clean", "Export Studio Suite"]
  }
];

const howToSchema = {
  "@type": "HowTo",
  "@id": "https://visualstyleeditor.com/how-it-works#howto",
  "name": "How to Visually Edit Local HTML and Tailwind CSS in Your Browser",
  "description": "Step-by-step workflow showing how Visual Style Editor parses HTML via Parse5, mutates styles visually, and commits changes directly to local disk.",
  "totalTime": "PT2M",
  "step": steps.map((s, idx) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "name": s.title,
    "itemListElement": [{
      "@type": "HowToDirection",
      "text": s.body
    }]
  }))
};

const breadcrumbs = [
  { name: "Home", item: "https://visualstyleeditor.com/" },
  { name: "How It Works", item: "https://visualstyleeditor.com/how-it-works" }
];
---

<BaseLayout
  title="How It Works — Step-by-Step In-Browser AST Walkthrough"
  description="A step-by-step walkthrough of how Visual Style Editor parses HTML with Parse5, edits at byte offsets, and writes back to your local file — entirely in the browser."
  breadcrumbs={breadcrumbs}
  customEntities={[howToSchema]}
>
  <div class="flex flex-col min-h-[100dvh]">
    <Navbar activePage="how it works" />

    <main id="main-content" class="flex-1">

      <!-- ============================================================
           HERO: Editorial Conduit Header
           ============================================================ -->
      <section class="relative overflow-hidden pt-8 sm:pt-12 md:pt-14 pb-14 lg:pb-16 px-4 sm:px-6 lg:px-8" data-parallax-section>
        {/* Vibrant Multi-Layered Ambient Studio Aura & Grid Texture */}
        <div class="hero-ambient-glow" aria-hidden="true">
          <div class="hero-glow-orb cyan"></div>
          <div class="hero-grid-pattern"></div>
        </div>

        <div class="max-w-6xl mx-auto relative z-10 space-y-8">
          <div class="max-w-3xl space-y-6" data-reveal="fade-up">
            <div
              class="inline-flex items-center gap-2 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-mono font-bold uppercase tracking-wider border select-none shadow-sm backdrop-blur-xl bg-sky-50 text-sky-800 border-sky-200 dark:bg-sky-950/40 dark:text-sky-300 dark:border-sky-500/40"
            >
              <span class="w-2 h-2 rounded-full bg-sky-600 dark:bg-sky-400 animate-pulse shrink-0"></span>
              <span class="truncate">Execution Pipeline · 6 Discrete Steps</span>
            </div>

            <h1
              class="text-display text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight leading-[1.12] sm:leading-[1.08]"
              data-motion-text="words"
            >
              Six surgical steps.<br />
              <span class="gradient-text">All inside browser memory.</span>
            </h1>

            <div data-aeo-answer class="text-xs sm:text-sm p-4 rounded-xl mt-4 mb-2 text-left bg-sky-500/10 border border-sky-500/20 text-sky-900 dark:text-sky-200">
              <p><strong>Direct Answer:</strong> Visual Style Editor works in 6 surgical client-side steps: 1) It opens local HTML files into browser memory via the W3C File System Access API with 0 bytes uploaded to remote servers; 2) Indexes nodes with Parse5 AST source tracking; 3) Renders in an isolated sandboxed canvas; 4) Modifies styles visually at 60 FPS; 5) Forward-maps CSS properties to Tailwind v3/v4 classes; 6) Commits only changed byte offsets back to disk.</p>
            </div>

            <p class="text-body text-sm sm:text-base md:text-lg lg:text-xl" style="color: var(--ink-2);">
              A complete technical walkthrough of exactly how the editor reads, parses, surgically splices, and saves your HTML files without a single byte sent to a server. Compliant with the W3C File System Access API standard.
            </p>

            <div class="pt-2">
              <FloatingBadges client:load />
            </div>
          </div>

          <!-- How It Works Hero Studio Visual Window Frame -->
          <div class="max-w-5xl mx-auto pt-4" data-reveal="fade-up">
            <div class="glass-window-frame p-1.5 sm:p-2.5 group overflow-hidden">
              <div class="px-4 py-2 flex items-center justify-between border-b rounded-t-xl select-none text-xs font-mono text-zinc-400" style="background: rgba(18, 18, 21, 0.75); border-color: rgba(255, 255, 255, 0.08);">
                <div class="flex items-center gap-2">
                  <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></div>
                  <span class="ml-2 hidden sm:inline">visual-style-editor • surgical-pipeline-walkthrough</span>
                </div>
                <span class="text-lime-400 font-semibold text-[11px]">6 In-Memory Steps</span>
              </div>
              <div class="relative rounded-lg overflow-hidden bg-black aspect-[16/9] max-sm:aspect-[9/13]">
                <picture class="block w-full h-full">
                  <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/01-editor-overview-mobile.png" />
                  <img
                    src="/images/editor-snapshots/desktop/01-editor-overview-desktop.png"
                    alt="Visual Style Editor 6 Steps Studio Canvas"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]"
                    loading="eager"
                  />
                </picture>
              </div>
            </div>
          </div>
        </div>
      </section>

      <hr class="section-divider" />

      <!-- ============================================================
           CONNECTED TIMELINE CONDUIT: Pinned Narrative & Live Visuals
           ============================================================ -->
      <section class="section py-20 relative" data-timeline-conduit>
        <div class="section-inner relative">

          {/* Animated Neon Conduit Line connecting all 6 steps */}
          <div class="conduit-line hidden lg:block" aria-hidden="true">
            <div class="conduit-pulse"></div>
          </div>

          <div class="space-y-24 lg:space-y-32">
            {steps.map((step, i) => (
              <article
                class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start"
                data-reveal="fade-up"
              >
                {/* Node Pill / Number Marker on the Conduit Spine */}
                <div class="lg:col-span-1 flex lg:justify-center">
                  <div
                    class={`frosted-icon-capsule ${step.badgeClass} w-14 h-14 p-2 shadow-lg relative z-20 flex flex-col items-center justify-center gap-0.5`}
                  >
                    <Icon name={step.iconName} class="w-5 h-5" />
                    <span class="text-[10px] font-mono font-black">{step.step}</span>
                  </div>
                </div>

                {/* Left Side: Pinned/Sticky Narrative Step Explanation */}
                <div class="lg:col-span-5 space-y-4 lg:sticky lg:top-28">
                  <div class="space-y-2">
                    <span class={`neon-callout-tag ${step.badgeClass} text-xs font-mono font-bold`}>
                      {step.tech}
                    </span>
                    <h2 class="text-headline text-2xl sm:text-3xl font-black tracking-tight" style="color: var(--ink-1);">
                      {step.title}
                    </h2>
                    <p class="text-xs font-mono font-semibold text-emerald-700 dark:text-emerald-400">
                      {step.tagline}
                    </p>
                  </div>

                  <p class="text-body text-sm sm:text-base leading-relaxed" style="color: var(--ink-2);">
                    {step.body}
                  </p>

                  {/* Feature Chips */}
                  <div class="flex flex-wrap gap-2 pt-2">
                    {step.chips.map((chip) => (
                      <span class="badge text-[11px] font-mono px-2.5 py-1" style="background: var(--surface-2); border-color: var(--border);">
                        ✓ {chip}
                      </span>
                    ))}
                  </div>
                </div>

                {/* Right Side: Interactive Code Diff & Enhanced Studio Comp */}
                <div class="lg:col-span-6 space-y-4">
                  {/* Enhanced Studio Screenshot if step has an image */}
                  {step.image && (
                    <div class="glass-window-frame p-2 sm:p-2.5 group cursor-zoom-in">
                      <div class="px-3 py-1.5 flex items-center justify-between border-b rounded-t-lg select-none text-[11px] font-mono text-zinc-400" style="background: rgba(18, 18, 21, 0.7); border-color: rgba(255, 255, 255, 0.08);">
                        <div class="flex items-center gap-1.5">
                          <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                          <span class="ml-2 font-medium">{step.imageLabel}</span>
                        </div>
                        <span class="text-purple-400 font-bold text-[10px]">Hover to Zoom • Phase {step.step}</span>
                      </div>
                      <div class="relative rounded-lg overflow-hidden bg-black aspect-[16/10] max-sm:aspect-[9/13]">
                        <picture class="w-full h-full block">
                          {step.imageMobile && (
                            <source media="(max-width: 640px)" srcset={step.imageMobile} />
                          )}
                          <img
                            src={step.image}
                            alt={step.imageLabel || step.title}
                            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.25]"
                            style={`transform-origin: ${step.zoomOrigin || '50% 50%'};`}
                            loading="lazy"
                          />
                        </picture>
                        <div class="absolute bottom-3 right-3 pointer-events-none">
                          <span class={`neon-callout-tag ${step.badgeClass} text-[10px]`}>
                            {step.tech} Active
                          </span>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* Interactive Code Container */}
                  <div class="code-block rounded-2xl shadow-xl border overflow-hidden p-0" style="background: var(--code-bg); border-color: var(--border);">
                    <div class="px-4 py-2.5 border-b flex items-center justify-between text-[11px] font-mono" style="border-color: var(--border); background: rgba(0,0,0,0.15);">
                      <span class="text-zinc-400 font-bold">engine/step-{step.step}.ts</span>
                      <span class="text-emerald-400 font-semibold">Verified Byte Splicing</span>
                    </div>
                    <pre class="p-4 text-xs font-mono leading-relaxed overflow-x-auto whitespace-pre-wrap" style="color: var(--ink-2);">{step.code}</pre>
                  </div>
                </div>
              </article>
            ))}
          </div>

        </div>
      </section>

      <!-- ============================================================
           ARCHITECTURE SUMMARY TILES
           ============================================================ -->
      <section class="section border-t" style="border-color: var(--border); background: var(--canvas-subtle);">
        <div class="section-inner space-y-12">
          <div class="section-header text-center max-w-4xl mx-auto" data-reveal="fade-up">
            <span class="badge text-xs font-mono uppercase tracking-wider mb-2 px-3 py-1" style="background: rgba(74, 222, 128, 0.1); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.25);">
              Uncompromising Principles
            </span>
            <h2 class="text-headline text-3xl sm:text-4xl font-black leading-[1.08]">Architecture Without Compromise</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-reveal-group>
            {[
              {
                icon: "lime",
                iconName: "cloud-off",
                title: "Zero data leaves your machine",
                body: "Every operation — parsing, editing, saving — executes strictly in browser memory. No WebSocket to a backend. No upload to validate permissions. No server to go down."
              },
              {
                icon: "violet",
                iconName: "code-integrity",
                title: "Your code stays your code",
                body: "The AST splicer never touches code it doesn't need to. PHP tags, Blade directives, and HTML comments in adjacent nodes are preserved bit-for-bit."
              },
              {
                icon: "cyan",
                iconName: "wifi-off",
                title: "Works 100% offline",
                body: "Once loaded, you can disconnect from Wi-Fi completely. The editor functions the same. The native File System API operates independent of internet connectivity."
              }
            ].map((fact) => (
              <div class="tile rounded-3xl p-8 border space-y-4" data-reveal-item style="background: var(--surface-1); border-color: var(--border);">
                <div class={`frosted-icon-capsule ${fact.icon}`}>
                  <Icon name={fact.iconName} class="w-6 h-6" />
                </div>
                <h3 class="text-title text-lg font-bold" style="color: var(--ink-1);">{fact.title}</h3>
                <p class="text-sm leading-relaxed" style="color: var(--ink-3);">{fact.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Hardware & System Specs -->
      <HardwareSpecs />

      <CtaBanner />
    </main>

    <Footer />
  </div>
</BaseLayout>
