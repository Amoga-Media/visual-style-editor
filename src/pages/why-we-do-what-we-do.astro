---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";
import Icon from "@/components/ui/Icon.astro";

const manifestoSchema = {
  "@type": "AboutPage",
  "@id": "https://visualstyleeditor.com/why-we-do-what-we-do#about",
  "name": "Why We Built Visual Style Editor — Developer Sovereignty Manifesto",
  "description": "An architectural manifesto on developer sovereignty: why code should remain local, why tools shouldn't extract rent, and how non-destructive AST splicing replaces cloud lock-in.",
  "mainEntity": {
    "@type": "Article",
    "headline": "Developer tools shouldn't extract rent: The Visual Style Editor Manifesto",
    "author": {
      "@id": "https://visualstyleeditor.com/#organization"
    },
    "publisher": {
      "@id": "https://visualstyleeditor.com/#organization"
    }
  }
};

const breadcrumbs = [
  { name: "Home", item: "https://visualstyleeditor.com/" },
  { name: "Why We Built This", item: "https://visualstyleeditor.com/why-we-do-what-we-do" }
];
---

<BaseLayout
  title="Why We Built This — Visual Style Editor Manifesto"
  description="An honest account of why Visual Style Editor exists: the frustration with losing work, paying for lock-in, and not owning your own code."
  breadcrumbs={breadcrumbs}
  customEntities={[manifestoSchema]}
>
  <div class="flex flex-col min-h-[100dvh]">
    <Navbar activePage="why we do it" />

    <main id="main-content" class="flex-1">

      <!-- Editorial header -->
      <section class="relative overflow-hidden pt-8 sm:pt-12 md:pt-14 pb-12 sm:pb-14 px-4 sm:px-6 lg:px-8">
        {/* Vibrant Multi-Layered Ambient Studio Aura & Grid Texture */}
        <div class="hero-ambient-glow" aria-hidden="true">
          <div class="hero-glow-orb magenta"></div>
          <div class="hero-grid-pattern"></div>
        </div>

        <div class="max-w-6xl mx-auto relative z-10">
          <div class="max-w-3xl space-y-4 reveal">
            <div
              class="inline-flex items-center gap-2 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full text-[11px] sm:text-xs font-mono font-bold uppercase tracking-wider border select-none shadow-sm backdrop-blur-xl bg-purple-50 text-purple-800 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-500/40"
            >
              <span class="w-2 h-2 rounded-full bg-pink-600 dark:bg-pink-400 animate-pulse shrink-0"></span>
              <span class="truncate">Engineering Ethics & Philosophy</span>
            </div>
            <h1 class="text-display text-3xl sm:text-5xl md:text-6xl font-black tracking-tight leading-[1.12] sm:leading-[1.08]">
              Why we built this.
            </h1>
            <p class="text-body text-sm sm:text-base md:text-lg" style="color: var(--ink-2);">
              An honest account of why Visual Style Editor exists: the frustration with losing work, paying for lock-in, and not owning your own code.
            </p>
          </div>

          <!-- Hero Studio Workstation Window Frame -->
          <div class="max-w-5xl mx-auto pt-6 reveal">
            <div class="glass-window-frame p-1.5 sm:p-2.5 group overflow-hidden">
              <div class="px-4 py-2 flex items-center justify-between border-b rounded-t-xl select-none text-xs font-mono text-zinc-400" style="background: rgba(18, 18, 21, 0.75); border-color: rgba(255, 255, 255, 0.08);">
                <div class="flex items-center gap-2">
                  <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></div>
                  <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></div>
                  <span class="ml-2 hidden sm:inline">visual-style-editor • ethics-and-architecture</span>
                </div>
                <span class="text-pink-400 font-semibold text-[11px]">Local Sovereignty First</span>
              </div>
              <div class="relative rounded-lg overflow-hidden bg-black aspect-[16/9] max-sm:aspect-[9/13]">
                <picture class="block w-full h-full">
                  <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/01-editor-overview-mobile.png" />
                  <img
                    src="/images/editor-snapshots/desktop/01-editor-overview-desktop.png"
                    alt="Visual Style Editor Local Studio Workspace"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.01]"
                    loading="eager"
                  />
                </picture>
              </div>
            </div>
          </div>
        </div>
      </section>

      <hr class="section-divider" />

      <!-- Long-form editorial content -->
      <section class="section">
        <div class="section-inner">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

            <!-- Sticky sidebar date -->
            <div class="lg:col-span-3 reveal">
              <div class="lg:sticky" style="top: 6rem;">
                <p class="text-label">Published</p>
                <p class="text-sm mt-1" style="color: var(--ink-3); font-family: var(--font-mono);">January 2025</p>
                <div class="mt-6 space-y-3">
                  <p class="text-label">Filed under</p>
                  <div class="flex flex-wrap gap-2">
                    <span class="badge">philosophy</span>
                    <span class="badge">open source</span>
                    <span class="badge">tooling</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Editorial body -->
            <article class="lg:col-span-7 space-y-8 reveal reveal-stagger-1" style="max-width: 64ch;">

              <div class="space-y-5">
                <h2 class="text-headline" style="font-size: 1.5rem;">Because the alternative was paying $39/month to not own your own HTML.</h2>
                <p class="text-body">
                  That's the honest version. We were building sites for clients using Tailwind CSS and running into the same wall every time: there was no good tool for visual editing that didn't either require a cloud subscription or throw away your code quality.
                </p>
                <p class="text-body">
                  Chrome DevTools was fine for quick experiments, but changes vanished on reload. Webflow was powerful, but it held the code in its own database, stripped comments, and exported markup that looked nothing like something a developer would write. Figma produced design files, not actual HTML. None of these solved the actual problem: <em>I have an HTML file on my disk, and I want to edit it visually without losing anything.</em>
                </p>

                <!-- Figure 1: Full Canvas & Utility Classes -->
                <figure class="rounded-2xl overflow-hidden border my-6 group" style="background: var(--surface-1); border-color: var(--border);">
                  <div class="relative overflow-hidden aspect-[16/10] max-sm:aspect-[9/13] bg-zinc-950">
                    <picture class="block w-full h-full">
                      <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/03-editor-classes-system-mobile.jpg" />
                      <img
                        src="/images/editor-snapshots/desktop/03-editor-classes-system-desktop.jpg"
                        alt="Visual Style Editor Tailwind Classes & Canvas Viewport"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                      />
                    </picture>
                  </div>
                  <figcaption class="p-3 text-[11px] font-mono text-center border-t" style="color: var(--ink-3); border-color: var(--border); background: var(--surface-2);">
                    Figure 1: Real-time Tailwind classes and canvas inspector operating 100% locally in browser RAM.
                  </figcaption>
                </figure>
              </div>

              <hr style="border: none; border-top: 1px solid var(--border);" />

              <div class="space-y-5">
                <h2 class="text-headline" style="font-size: 1.5rem;">Developer tools shouldn't extract rent.</h2>
                <div data-aeo-answer class="text-xs sm:text-sm p-4 rounded-xl my-3 text-left bg-purple-500/10 border border-purple-500/20 text-purple-900 dark:text-purple-200">
                  <p><strong>Direct Answer:</strong> Visual Style Editor was created under the principle of developer sovereignty: tools that execute computations on a user's local machine should never charge recurring subscriptions or require cloud account lock-in. By leveraging open web standards (W3C File System Access API, Parse5 AST parser), Visual Style Editor remains 100% free, MIT licensed, and air-gapped.</p>
                </div>
                <p class="text-body">
                  There's a category of software that charges you to access tools that don't depend on any server infrastructure. Tools that are, at their core, just processing you're paying a subscription to run on your own machine via their interface.
                </p>
                <p class="text-body">
                  We don't want to build that kind of company. The AST splicer, the OKLCH color engine, the Tailwind class mapper — none of this requires a server. There's no reason it should cost money. There's no reason your code should leave your machine. So we made it free and we kept everything local.
                </p>

                <!-- Figure 2: Surgical Byte Splicer Diff -->
                <figure class="rounded-2xl overflow-hidden border my-6 group" style="background: var(--surface-1); border-color: var(--border);">
                  <div class="relative overflow-hidden aspect-[16/10] max-sm:aspect-[9/13] bg-zinc-950">
                    <picture class="block w-full h-full">
                      <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/08-editor-ast-splice-diff-mobile.jpg" />
                      <img
                        src="/images/editor-snapshots/desktop/08-editor-ast-splice-diff-desktop.jpg"
                        alt="AST Surgical Character Splice Diff Review"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                      />
                    </picture>
                  </div>
                  <figcaption class="p-3 text-[11px] font-mono text-center border-t" style="color: var(--ink-3); border-color: var(--border); background: var(--surface-2);">
                    Figure 2: Byte-accurate AST splicing modifies only the exact attribute bytes, preserving comments and server tags.
                  </figcaption>
                </figure>
              </div>

              <hr style="border: none; border-top: 1px solid var(--border);" />

              <div class="space-y-5">
                <h2 class="text-headline" style="font-size: 1.5rem;">We build it because we use it.</h2>
                <p class="text-body">
                  This isn't a side project maintained out of obligation. It's a tool we reach for when we're building things. That means when something is slow, or the output isn't idiomatic, or a feature is missing — we notice immediately. Features get added when we hit friction.
                </p>
                <p class="text-body">
                  The backlog exists because other developers sent bug reports that turned into feature requests. If something is broken or missing for you, open an issue. We read them.
                </p>

                <!-- Figure 3: Box Model & Spacing -->
                <figure class="rounded-2xl overflow-hidden border my-6 group" style="background: var(--surface-1); border-color: var(--border);">
                  <div class="relative overflow-hidden aspect-[16/10] max-sm:aspect-[9/13] bg-zinc-950">
                    <picture class="block w-full h-full">
                      <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/06-editor-padding-boxmodel-mobile.jpg" />
                      <img
                        src="/images/editor-snapshots/desktop/06-editor-padding-boxmodel-desktop.jpg"
                        alt="Tactile Concentric Box Model & Spacing Sliders"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                      />
                    </picture>
                  </div>
                  <figcaption class="p-3 text-[11px] font-mono text-center border-t" style="color: var(--ink-3); border-color: var(--border); background: var(--surface-2);">
                    Figure 3: Tactile 4-tier Concentric Box Model translates directly into standard Tailwind spacing utilities.
                  </figcaption>
                </figure>
              </div>

              <hr style="border: none; border-top: 1px solid var(--border);" />

              <div class="space-y-5">
                <h2 class="text-headline" style="font-size: 1.5rem;">What this isn't.</h2>
                <p class="text-body">
                  It's not a Webflow replacement. It's not trying to be a full site builder. It doesn't handle content management, hosting, deployment, or team collaboration. It's a precision tool for a specific job: editing the visual output of HTML and Tailwind files that live on your local machine.
                </p>
                <p class="text-body">
                  If that's the job you need done, it's the right tool. If you need something else, we'd rather be honest about that than oversell scope.
                </p>

                <!-- Figure 4: Export Studio & Direct Disk Save -->
                <figure class="rounded-2xl overflow-hidden border my-6 group" style="background: var(--surface-1); border-color: var(--border);">
                  <div class="relative overflow-hidden aspect-[16/10] max-sm:aspect-[9/13] bg-zinc-950">
                    <picture class="block w-full h-full">
                      <source media="(max-width: 640px)" srcset="/images/editor-snapshots/mobile/07-editor-export-studio-mobile.jpg" />
                      <img
                        src="/images/editor-snapshots/desktop/07-editor-export-studio-desktop.jpg"
                        alt="Export Studio & Direct Disk Commit"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                      />
                    </picture>
                  </div>
                  <figcaption class="p-3 text-[11px] font-mono text-center border-t" style="color: var(--ink-3); border-color: var(--border); background: var(--surface-2);">
                    Figure 4: Direct disk write streams and multi-framework export suite (HTML, JSX, Astro) with zero cloud sync.
                  </figcaption>
                </figure>
              </div>

              <!-- CTA within editorial — inline, not a full banner -->
              <div class="card p-6 reveal rounded-3xl border space-y-4" style="background: var(--surface-1); border-color: var(--border);">
                <div class="frosted-icon-capsule violet">
                  <Icon name="sparkles" class="w-6 h-6" />
                </div>
                <div>
                  <p class="text-base font-bold" style="color: var(--ink-1);">Try it on a real project.</p>
                  <p class="text-sm mt-1 leading-relaxed" style="color: var(--ink-3);">Open any HTML file and spend 10 minutes with the inspector. That's the fastest way to understand what it is and isn't.</p>
                </div>
                <a href="/editor" class="btn btn-primary mt-2 text-sm inline-flex items-center gap-2">
                  <span>Open the editor</span>
                  <Icon name="arrow-right" class="w-4 h-4" />
                </a>
              </div>
            </article>
          </div>
        </div>
      </section>

    </main>

    <Footer />
  </div>
</BaseLayout>
