---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";

const faqs = [
  {
    q: "How does Visual Style Editor edit my files without a server?",
    a: "Visual Style Editor runs 100% client-side in your web browser. When you drop an HTML file or open a local folder, it uses the native File System Access API and an in-memory Parse5 AST (Abstract Syntax Tree) engine. Your source code, comments, formatting, and scripts are parsed, modified surgically, and saved directly to your local drive without a single byte ever touching a remote server."
  },
  {
    q: "Does it support Tailwind CSS v3 and the new Tailwind v4?",
    a: "Yes! Visual Style Editor features an automated Tailwind engine that detects both Tailwind v3 class conventions and modern Tailwind v4 theme variables. When you adjust visual sliders for spacing, typography, colors, or shadows, the editor maps your choices into idiomatic Tailwind utility classes."
  },
  {
    q: "Will it mess up my HTML formatting or delete my template comments?",
    a: "Never. Unlike conventional visual site builders that parse HTML into proprietary JSON and serialize back messy spaghetti code, Visual Style Editor uses an AST-first surgical splicing algorithm. It tracks exact source code locations, altering only the specific class attributes or style properties you touched while leaving surrounding HTML, conditional tags, and comments untouched."
  },
  {
    q: "Is it really completely free?",
    a: "Yes, 100% free and open-source under the MIT license. There are no paywalls, no monthly subscription fees, no locked exports, and no forced watermarks. We believe developer tools for local files should remain free and sovereign."
  },
  {
    q: "What browsers are supported for direct saving?",
    a: "Direct file and directory saving works natively in Chromium-based browsers (Google Chrome, Microsoft Edge, Brave, Arc, Opera) using the File System Access API. On browsers without File System Access (like Safari or Firefox), you can edit seamlessly and download your modified HTML with one click."
  }
];

const comparisons = [
  { feature: "Pricing", vse: "100% Free Forever", webflow: "$14–$39+/mo", figma: "$12–$75+/mo", devtools: "Free" },
  { feature: "Code Ownership", vse: "Direct on Your Disk", webflow: "Locked in Cloud DB", figma: "Canvas Vectors Only", devtools: "Lost on Page Reload" },
  { feature: "Tailwind CSS Native", vse: "Yes (v3 & v4 syntax)", webflow: "No (Proprietary CSS)", figma: "Requires Plugins", devtools: "Manual Typing Only" },
  { feature: "AST Comment Preservation", vse: "100% Surgical Preservation", webflow: "Strips All Comments", figma: "N/A", devtools: "N/A" },
  { feature: "Zero Telemetry / Privacy", vse: "Zero Data Sent to Cloud", webflow: "All Data Tracked", figma: "Cloud Hosted", devtools: "Local Only" },
  { feature: "Offline Capable", vse: "Yes (100% Client-Side)", webflow: "No (Requires Internet)", figma: "Limited", devtools: "Yes" },
];
---

<BaseLayout
  title="Visual Style Editor — Free Visual HTML & Tailwind CSS Studio"
  description="A high-performance visual editor for HTML and Tailwind CSS operating directly in your browser. Zero backend, zero telemetry, zero lock-in — just pure, surgical AST code editing."
  theme="light"
>
  <div class="relative min-h-screen flex flex-col bg-white overflow-hidden text-slate-900">
    <!-- Purple Ambient Glow Mesh -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-purple-200/40 via-purple-100/20 to-transparent blur-[140px] pointer-events-none -z-10"></div>
    <div class="absolute top-[800px] right-0 w-[500px] h-[500px] bg-purple-100/30 blur-[130px] pointer-events-none -z-10"></div>

    <Navbar activePage="home" />

    <main class="flex-1">
      <!-- HERO SECTION -->
      <section class="relative pt-12 sm:pt-20 pb-16 sm:pb-24 px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto text-center space-y-8">
          <!-- Eyebrow Pill -->
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-purple-50 text-purple-700 border border-purple-200/80 shadow-2xs hover:bg-purple-100/70 transition-colors">
            <span class="flex h-2 w-2 rounded-full bg-purple-600 animate-pulse"></span>
            <span>Next-Gen Web Design • 100% In-Browser & Local-First</span>
          </div>

          <!-- Main Headline -->
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-950 leading-[1.08]">
            Design at the speed of thought. <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 via-purple-600 to-indigo-600">
              Export clean Tailwind code.
            </span>
          </h1>

          <!-- Subheadline -->
          <p class="text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed font-normal">
            Drop any HTML or Tailwind file directly into your browser. Tweak layouts visually, 
            sculpt typography, harmonize OKLCH palettes, apply glow shadows, and save surgically 
            spliced AST code back to your local files with zero server roundtrips.
          </p>

          <!-- Primary CTAs -->
          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/editor"
              class="group inline-flex items-center gap-3 pl-7 pr-3 py-4 rounded-full text-base font-semibold text-white bg-gradient-to-r from-violet-600 via-purple-600 to-indigo-600 hover:from-violet-700 hover:to-purple-700 shadow-xl shadow-purple-600/25 hover:shadow-purple-600/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
            >
              <span>Launch Studio Free</span>
              <span class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center group-hover:translate-x-1 transition-transform">
                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </a>

            <a
              href="/templates"
              class="inline-flex items-center gap-2.5 px-7 py-4 rounded-full text-base font-medium text-slate-700 bg-white hover:bg-purple-50/80 border border-purple-200 shadow-sm hover:border-purple-300 hover:-translate-y-0.5 active:translate-y-0 transition-all"
            >
              <svg class="w-4 h-4 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
              </svg>
              <span>Explore Starter Templates</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-6 flex flex-wrap items-center justify-center gap-y-3 gap-x-8 text-xs font-semibold text-slate-500 uppercase tracking-wider">
            <span class="flex items-center gap-1.5"><span class="text-purple-600 font-bold">✓</span> No Account Required</span>
            <span class="flex items-center gap-1.5"><span class="text-purple-600 font-bold">✓</span> Zero Telemetry or Analytics</span>
            <span class="flex items-center gap-1.5"><span class="text-purple-600 font-bold">✓</span> Native File System Access</span>
            <span class="flex items-center gap-1.5"><span class="text-purple-600 font-bold">✓</span> 100% Offline Capable</span>
          </div>
        </div>

        <!-- HERO STUDIO PREVIEW MOCKUP (DOUBLE BEZEL) -->
        <div class="max-w-6xl mx-auto mt-14 sm:mt-20">
          <div class="p-2 sm:p-3 rounded-[2.5rem] bg-gradient-to-b from-purple-200/80 via-purple-100/50 to-slate-200/60 border border-purple-200/90 shadow-[0_25px_60px_-15px_rgba(124,58,237,0.18)]">
            <div class="overflow-hidden rounded-[calc(2.5rem-0.75rem)] bg-slate-900 border border-slate-800 text-slate-100 shadow-inner">
              <!-- Window Chrome Bar -->
              <div class="px-5 py-3.5 bg-slate-950/90 border-b border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
                  <span class="ml-3 text-xs font-mono text-slate-400">index.html — Visual Style Studio v2.0</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-purple-500/20 text-purple-300 border border-purple-500/30">Tailwind v4 Active</span>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Auto-Save 2s</span>
                </div>
              </div>

              <!-- 3-Pane Mockup Grid -->
              <div class="grid grid-cols-12 min-h-[460px] text-xs font-sans">
                <!-- Left: Layer Navigator -->
                <div class="hidden md:block col-span-3 bg-slate-950/50 border-r border-slate-800/80 p-4 space-y-4">
                  <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider flex items-center justify-between">
                    <span>Document Tree</span>
                    <span class="text-purple-400 text-xs">HTML5</span>
                  </div>
                  <div class="space-y-1 text-slate-300">
                    <div class="px-2.5 py-1.5 rounded-lg bg-slate-800/40 text-slate-400">▾ &lt;header&gt;</div>
                    <div class="px-2.5 py-1.5 rounded-lg bg-purple-600/20 text-purple-200 border border-purple-500/30 font-medium pl-6 flex items-center justify-between">
                      <span>▸ &lt;button#cta-btn&gt;</span>
                      <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
                    </div>
                    <div class="px-2.5 py-1.5 rounded-lg bg-slate-800/40 text-slate-400 pl-6">&lt;nav.links&gt;</div>
                    <div class="px-2.5 py-1.5 rounded-lg bg-slate-800/40 text-slate-400">▾ &lt;section.hero&gt;</div>
                    <div class="px-2.5 py-1.5 rounded-lg bg-slate-800/40 text-slate-400 pl-6">&lt;h1.headline&gt;</div>
                    <div class="px-2.5 py-1.5 rounded-lg bg-slate-800/40 text-slate-400 pl-6">&lt;p.lead&gt;</div>
                  </div>
                </div>

                <!-- Center: Live Canvas Artboard -->
                <div class="col-span-12 md:col-span-6 bg-slate-900/80 p-6 flex flex-col items-center justify-center relative">
                  <!-- Canvas Dots Background -->
                  <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.08)_1px,transparent_1px)] bg-[size:16px_16px] pointer-events-none"></div>

                  <!-- Active selected preview element with live bounding box -->
                  <div class="relative z-10 w-full max-w-md p-6 rounded-2xl bg-slate-950/80 border-2 border-purple-500 shadow-2xl shadow-purple-500/20 space-y-4">
                    <div class="flex items-center justify-between">
                      <span class="text-[10px] font-mono bg-purple-600 text-white px-2 py-0.5 rounded font-bold">
                        button#cta-btn.bg-purple-600
                      </span>
                      <span class="text-[10px] font-mono text-purple-300">324 × 52 px</span>
                    </div>
                    <div class="p-4 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white text-center font-semibold text-sm shadow-lg shadow-purple-600/30">
                      ⚡ Start Free 14-Day Trial
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-800">
                      <span>Tailwind: <code class="text-purple-300 font-mono">bg-purple-600 text-white rounded-xl shadow-lg</code></span>
                    </div>
                  </div>

                  <!-- Floating HUD quick action pill -->
                  <div class="mt-4 px-3 py-1.5 rounded-full bg-slate-950 border border-purple-500/40 text-slate-300 text-[11px] flex items-center gap-3 shadow-xl">
                    <span class="text-purple-400 font-semibold">Live AST:</span>
                    <span>Class edit applied</span>
                    <span class="text-emerald-400">● 60 FPS</span>
                  </div>
                </div>

                <!-- Right: Property Panel Inspector -->
                <div class="hidden md:block col-span-3 bg-slate-950/50 border-l border-slate-800/80 p-4 space-y-4">
                  <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider flex items-center justify-between">
                    <span>Property Inspector</span>
                    <span class="text-purple-400 font-mono">OKLCH</span>
                  </div>

                  <!-- Mock Controls -->
                  <div class="space-y-3">
                    <div class="space-y-1">
                      <div class="flex justify-between text-slate-400 text-[11px]">
                        <span>Font Weight</span>
                        <span class="text-purple-300 font-mono">font-semibold (600)</span>
                      </div>
                      <div class="h-1.5 rounded-full bg-slate-800 relative">
                        <div class="w-3/4 h-full bg-purple-500 rounded-full"></div>
                      </div>
                    </div>

                    <div class="space-y-1">
                      <div class="flex justify-between text-slate-400 text-[11px]">
                        <span>Shadow Preset</span>
                        <span class="text-purple-300 font-mono">Neon Purple Glow</span>
                      </div>
                      <div class="h-1.5 rounded-full bg-slate-800 relative">
                        <div class="w-4/5 h-full bg-purple-500 rounded-full"></div>
                      </div>
                    </div>

                    <div class="space-y-1">
                      <div class="flex justify-between text-slate-400 text-[11px]">
                        <span>Color Harmonizer</span>
                        <span class="text-purple-300 font-mono">Split-Complementary</span>
                      </div>
                      <div class="grid grid-cols-5 gap-1 pt-1">
                        <div class="h-5 rounded bg-purple-600"></div>
                        <div class="h-5 rounded bg-violet-500"></div>
                        <div class="h-5 rounded bg-fuchsia-500"></div>
                        <div class="h-5 rounded bg-indigo-500"></div>
                        <div class="h-5 rounded bg-amber-400"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 6 KEY PILLARS (ASYMMETRICAL BENTO GRID) -->
      <section class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50/50 border-y border-purple-100/60">
        <div class="max-w-7xl mx-auto space-y-16">
          <div class="text-center max-w-3xl mx-auto space-y-4">
            <span class="text-xs font-bold uppercase tracking-wider text-purple-700 bg-purple-50 border border-purple-200/80 px-3.5 py-1 rounded-full">
              Engineered For Modern Frontend
            </span>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-950 tracking-tight">
              Everything you need. <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-purple-600">
                Nothing holding your code hostage.
              </span>
            </h2>
            <p class="text-base sm:text-lg text-slate-600">
              No cloud databases, no proprietary styling formats, and zero code generation bloat.
            </p>
          </div>

          <!-- Bento Grid with Double-Bezel cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Card 1: In-Browser AST -->
            <div class="p-1.5 rounded-[2rem] bg-gradient-to-b from-purple-100/80 to-purple-50/40 border border-purple-200/60 shadow-xs hover:shadow-lg hover:shadow-purple-500/5 transition-all">
              <div class="h-full rounded-[calc(2rem-0.375rem)] bg-white p-7 flex flex-col justify-between space-y-6 shadow-[inset_0_1px_1px_rgba(255,255,255,1)]">
                <div class="space-y-4">
                  <div class="w-12 h-12 rounded-2xl bg-purple-50 border border-purple-200/70 flex items-center justify-center text-purple-600 shadow-2xs">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-slate-950">In-Browser AST Engine</h3>
                  <p class="text-sm text-slate-600 leading-relaxed">
                    Surgically splices your HTML without re-serializing the whole document. Your custom comments, server tags, scripts, and formatting are preserved intact.
                  </p>
                </div>
                <div class="pt-2 text-xs font-semibold text-purple-700 flex items-center gap-1.5">
                  <span>Zero code mutilation</span> →
                </div>
              </div>
            </div>

            <!-- Card 2: Dual Tailwind Engine -->
            <div class="p-1.5 rounded-[2rem] bg-gradient-to-b from-purple-100/80 to-purple-50/40 border border-purple-200/60 shadow-xs hover:shadow-lg hover:shadow-purple-500/5 transition-all">
              <div class="h-full rounded-[calc(2rem-0.375rem)] bg-white p-7 flex flex-col justify-between space-y-6 shadow-[inset_0_1px_1px_rgba(255,255,255,1)]">
                <div class="space-y-4">
                  <div class="w-12 h-12 rounded-2xl bg-purple-50 border border-purple-200/70 flex items-center justify-center text-purple-600 shadow-2xs">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-slate-950">Tailwind v3 & v4 Intelligence</h3>
                  <p class="text-sm text-slate-600 leading-relaxed">
                    Auto-detects active Tailwind versions. Translates visual slider interactions directly into standard utility classes or theme CSS variables.
                  </p>
                </div>
                <div class="pt-2 text-xs font-semibold text-purple-700 flex items-center gap-1.5">
                  <span>Semantic utility mapping</span> →
                </div>
              </div>
            </div>

            <!-- Card 3: OKLCH Palette Harmonizer -->
            <div class="p-1.5 rounded-[2rem] bg-gradient-to-b from-purple-100/80 to-purple-50/40 border border-purple-200/60 shadow-xs hover:shadow-lg hover:shadow-purple-500/5 transition-all">
              <div class="h-full rounded-[calc(2rem-0.375rem)] bg-white p-7 flex flex-col justify-between space-y-6 shadow-[inset_0_1px_1px_rgba(255,255,255,1)]">
                <div class="space-y-4">
                  <div class="w-12 h-12 rounded-2xl bg-purple-50 border border-purple-200/70 flex items-center justify-center text-purple-600 shadow-2xs">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-slate-950">OKLCH Color Harmonizer</h3>
                  <p class="text-sm text-slate-600 leading-relaxed">
                    Generate harmonious 9-shade tonal ramps (50–900) across 5 harmony modes with perceptual uniformity and zero muddy transitions.
                  </p>
                </div>
                <div class="pt-2 text-xs font-semibold text-purple-700 flex items-center gap-1.5">
                  <span>Perceptual color science</span> →
                </div>
              </div>
            </div>

            <!-- Card 4: Shadow & Glow Studio -->
            <div class="p-1.5 rounded-[2rem] bg-gradient-to-b from-purple-100/80 to-purple-50/40 border border-purple-200/60 shadow-xs hover:shadow-lg hover:shadow-purple-500/5 transition-all">
              <div class="h-full rounded-[calc(2rem-0.375rem)] bg-white p-7 flex flex-col justify-between space-y-6 shadow-[inset_0_1px_1px_rgba(255,255,255,1)]">
                <div class="space-y-4">
                  <div class="w-12 h-12 rounded-2xl bg-purple-50 border border-purple-200/70 flex items-center justify-center text-purple-600 shadow-2xs">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-slate-950">Shadow & Glow Presets</h3>
                  <p class="text-sm text-slate-600 leading-relaxed">
                    12 professionally calibrated shadow levels from subtle floating elevations to dramatic neon glows and soft inset bevels.
                  </p>
                </div>
                <div class="pt-2 text-xs font-semibold text-purple-700 flex items-center gap-1.5">
                  <span>Haptic visual depth</span> →
                </div>
              </div>
            </div>

            <!-- Card 5: Responsive Inheritance -->
            <div class="p-1.5 rounded-[2rem] bg-gradient-to-b from-purple-100/80 to-purple-50/40 border border-purple-200/60 shadow-xs hover:shadow-lg hover:shadow-purple-500/5 transition-all">
              <div class="h-full rounded-[calc(2rem-0.375rem)] bg-white p-7 flex flex-col justify-between space-y-6 shadow-[inset_0_1px_1px_rgba(255,255,255,1)]">
                <div class="space-y-4">
                  <div class="w-12 h-12 rounded-2xl bg-purple-50 border border-purple-200/70 flex items-center justify-center text-purple-600 shadow-2xs">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-slate-950">Responsive Inheritance</h3>
                  <p class="text-sm text-slate-600 leading-relaxed">
                    Switch between Desktop, Tablet, and Mobile artboards seamlessly. Breakpoint styles cascade cleanly and generate scoped media queries.
                  </p>
                </div>
                <div class="pt-2 text-xs font-semibold text-purple-700 flex items-center gap-1.5">
                  <span>Fluid multi-device views</span> →
                </div>
              </div>
            </div>

            <!-- Card 6: Direct Disk Saving -->
            <div class="p-1.5 rounded-[2rem] bg-gradient-to-b from-purple-100/80 to-purple-50/40 border border-purple-200/60 shadow-xs hover:shadow-lg hover:shadow-purple-500/5 transition-all">
              <div class="h-full rounded-[calc(2rem-0.375rem)] bg-white p-7 flex flex-col justify-between space-y-6 shadow-[inset_0_1px_1px_rgba(255,255,255,1)]">
                <div class="space-y-4">
                  <div class="w-12 h-12 rounded-2xl bg-purple-50 border border-purple-200/70 flex items-center justify-center text-purple-600 shadow-2xs">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-slate-950">Direct Disk Saving</h3>
                  <p class="text-sm text-slate-600 leading-relaxed">
                    Uses the File System Access API to write changes straight back to your original source file on disk. No zips, no re-importing, zero cloud lag.
                  </p>
                </div>
                <div class="pt-2 text-xs font-semibold text-purple-700 flex items-center gap-1.5">
                  <span>Git-ready workflows</span> →
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- COMPARISON TABLE -->
      <section class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto space-y-12">
          <div class="text-center space-y-4">
            <span class="text-xs font-bold uppercase tracking-wider text-purple-700 bg-purple-50 border border-purple-200/80 px-3.5 py-1 rounded-full">
              Transparent Comparison
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-950 tracking-tight">
              Why developers choose Visual Style Editor
            </h2>
            <p class="text-base text-slate-600 max-w-2xl mx-auto">
              See how our local-first AST architecture compares to conventional site builders and dev tools.
            </p>
          </div>

          <div class="overflow-x-auto rounded-3xl border border-purple-100 shadow-sm bg-white">
            <table class="w-full text-left text-sm border-collapse">
              <thead>
                <tr class="bg-purple-50/70 text-slate-900 border-b border-purple-100">
                  <th class="p-4 sm:p-5 font-bold">Feature / Metric</th>
                  <th class="p-4 sm:p-5 font-extrabold text-purple-700 bg-purple-100/50">Visual Style Editor</th>
                  <th class="p-4 sm:p-5 font-semibold text-slate-600">Webflow</th>
                  <th class="p-4 sm:p-5 font-semibold text-slate-600">Figma</th>
                  <th class="p-4 sm:p-5 font-semibold text-slate-600">DevTools</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-purple-100/60">
                {comparisons.map((row) => (
                  <tr class="hover:bg-purple-50/30 transition-colors">
                    <td class="p-4 sm:p-5 font-semibold text-slate-900">{row.feature}</td>
                    <td class="p-4 sm:p-5 font-bold text-purple-800 bg-purple-50/40">{row.vse}</td>
                    <td class="p-4 sm:p-5 text-slate-600">{row.webflow}</td>
                    <td class="p-4 sm:p-5 text-slate-600">{row.figma}</td>
                    <td class="p-4 sm:p-5 text-slate-600">{row.devtools}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- FAQ SECTION -->
      <section class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50/50 border-t border-purple-100/60">
        <div class="max-w-4xl mx-auto space-y-12">
          <div class="text-center space-y-4">
            <span class="text-xs font-bold uppercase tracking-wider text-purple-700 bg-purple-50 border border-purple-200/80 px-3.5 py-1 rounded-full">
              Common Questions
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-950 tracking-tight">
              Frequently Asked Questions
            </h2>
          </div>

          <div class="space-y-4">
            {faqs.map((faq) => (
              <details class="group p-6 rounded-2xl bg-white border border-purple-100 shadow-2xs hover:border-purple-200 transition-all [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-base sm:text-lg select-none">
                  <span>{faq.q}</span>
                  <span class="ml-4 w-7 h-7 rounded-full bg-purple-50 text-purple-700 flex items-center justify-center text-sm font-semibold group-open:rotate-180 transition-transform duration-200">
                    ↓
                  </span>
                </summary>
                <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed pt-2 border-t border-purple-50">
                  {faq.a}
                </p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA BANNER -->
      <CtaBanner />
    </main>

    <Footer />
  </div>
</BaseLayout>
