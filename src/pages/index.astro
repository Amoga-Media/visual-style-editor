---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";
import FloatingBadges from "@/components/marketing/FloatingBadges";
import PossibilitiesShowcase from "@/components/marketing/PossibilitiesShowcase";
import AsymmetricBentoGrid from "@/components/marketing/AsymmetricBentoGrid";
import SupportedTechMatrix from "@/components/marketing/SupportedTechMatrix.astro";
import HardwareSpecs from "@/components/marketing/HardwareSpecs.astro";

const faqs = [
  {
    q: "How does it edit my files without a server?",
    a: "It runs entirely in your browser. When you open a local file or folder, the editor uses the File System Access API and an in-memory Parse5 AST engine. Your code is parsed, modified at exact byte offsets, and written back to disk — no server, no uploads, no round-trips."
  },
  {
    q: "Does it support Tailwind CSS v3 and v4?",
    a: "Yes. It automatically detects whether your project uses Tailwind v3 utility classes or v4 @theme CSS variables. Visual adjustments map to idiomatic class names — not arbitrary inline styles."
  },
  {
    q: "Will it mess up my HTML comments or template logic?",
    a: "No. The AST splicer works at character offset level. It finds the exact attribute it needs to change and modifies only that. Adjacent HTML, Blade/Twig tags, and comments are untouched."
  },
  {
    q: "Is it really free?",
    a: "Yes. MIT licensed. No paywalls, no account requirement, no telemetry. Your code stays on your machine."
  },
  {
    q: "Which browsers support direct disk saving?",
    a: "Chromium-based browsers (Chrome, Edge, Brave, Arc) support the File System Access API for direct save. Safari and Firefox can still use the editor — you download the modified file when done."
  }
];

const comparisons = [
  { feature: "Pricing", vse: "Free (MIT Forever)", webflow: "$14–$39+/mo", figma: "$12–$75+/mo", devtools: "Free" },
  { feature: "Your code lives on", vse: "Your local disk", webflow: "Webflow's cloud DB", figma: "Canvas vectors", devtools: "Lost on reload" },
  { feature: "Tailwind-native output", vse: "v3 & v4 idiomatic", webflow: "Proprietary CSS", figma: "Plugin-only", devtools: "Manual typing" },
  { feature: "Preserves HTML comments", vse: "Yes, surgically", webflow: "Strips all", figma: "N/A", devtools: "N/A" },
  { feature: "Telemetry / tracking", vse: "None, air-gapped", webflow: "Full tracking", figma: "Cloud hosted", devtools: "Local only" },
  { feature: "Works offline", vse: "100% offline", webflow: "No", figma: "Limited", devtools: "Yes" },
];
---

<BaseLayout
  title="Visual Style Editor — 2026 Awwwards In-Browser Creative Studio"
  description="Edit HTML and Tailwind CSS visually, directly in your browser. Changes write to your local files using the File System Access API. No backend. No telemetry. MIT licensed."
>
  <div class="flex flex-col min-h-[100dvh]">
    <Navbar activePage="home" />

    <main id="main-content" class="flex-1">

      <!-- ============================================================
           HERO: 2026 Awwwards Cinematic Studio Hero
           ============================================================ -->
      <section class="relative overflow-hidden pt-8 sm:pt-12 md:pt-14 pb-16 lg:pb-24 px-4 sm:px-6 lg:px-8" data-parallax-section>
        {/* Vibrant Multi-Layered Ambient Studio Aura & Grid Texture */}
        <div class="hero-ambient-glow" aria-hidden="true">
          <div class="hero-glow-orb"></div>
          <div class="hero-grid-pattern"></div>
        </div>

        <div class="max-w-6xl mx-auto relative z-10 space-y-10 sm:space-y-12">
          {/* Hero text header with staggered word reveal */}
          <div class="max-w-4xl mx-auto text-center space-y-6">
            <!-- Eyebrow Pill with live pulse -->
            <div
              class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider border select-none mx-auto shadow-sm backdrop-blur-xl bg-purple-50 text-purple-800 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-500/40"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse"></span>
              <span>2026 Awwwards Grade · Local AST Engine</span>
            </div>

            <h1
              class="text-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight leading-[1.08]"
              data-motion-text="words"
            >
              Visual CSS editing. <br />
              <span class="gradient-text">Your files. Your disk. Zero cloud.</span>
            </h1>

            <p class="text-body text-base sm:text-lg md:text-xl max-w-2xl mx-auto" style="color: var(--ink-2);" data-reveal="fade-up">
              Drop any HTML or Tailwind template into your browser. Click an element, adjust styles with tactile spring sliders, and save changes directly to disk — without touching a server.
            </p>

            <!-- Actions with magnetic hover -->
            <div class="flex flex-wrap items-center justify-center gap-3.5 pt-2" data-reveal="fade-up">
              <a
                href="/editor"
                data-magnetic
                class="btn btn-primary px-7 py-4 text-sm font-bold rounded-2xl shadow-xl flex items-center gap-3 transition-transform hover:scale-105 active:scale-95"
                style="background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%); border-color: transparent;"
              >
                <span>Launch Visual Studio</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>

              <a
                href="#what-is-under-the-hood"
                data-magnetic
                class="btn btn-secondary px-6 py-4 text-sm font-semibold rounded-2xl border flex items-center gap-2 hover:border-purple-400/50"
              >
                <span>Under The Hood</span>
                <svg class="w-4 h-4 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              <div class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2.5 rounded-xl text-xs font-mono border backdrop-blur-md" style="background: var(--surface-2); border-color: var(--border); color: var(--ink-3);">
                <kbd class="px-1.5 py-0.5 rounded bg-black/10 dark:bg-white/10 font-bold">⌘ + O</kbd>
                <span>or drag & drop file</span>
              </div>
            </div>

            <!-- Floating Interactive Stickers & Badges -->
            <div class="pt-2">
              <FloatingBadges client:load />
            </div>
          </div>

          <!-- ENHANCED STUDIO VISUAL COMP: Wrapped in Dark Glassmorphic Window Frame with Glossy Reflections & Neon Callouts -->
          <div class="max-w-6xl mx-auto" data-reveal="fade-up">
            <div class="glass-window-frame p-2 sm:p-3 group">
              <!-- Window Chrome Header -->
              <div class="px-4 py-2.5 flex items-center justify-between border-b rounded-t-xl select-none" style="background: rgba(18, 18, 21, 0.75); border-color: rgba(255, 255, 255, 0.08);">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
                  <span class="ml-3 text-xs font-mono text-zinc-400 hidden sm:inline">visual-style-editor • studio-canvas</span>
                </div>

                <div class="flex items-center gap-2 px-3 py-1 rounded-lg border text-[11px] font-mono text-zinc-300" style="background: rgba(0,0,0,0.3); border-color: rgba(255,255,255,0.08);">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>localhost:4321/editor</span>
                </div>

                <div class="flex items-center gap-2 text-[11px] font-mono text-purple-400 font-bold">
                  <span class="hidden md:inline">AST Splicer v2.4</span>
                </div>
              </div>

              <!-- Main Live Canvas Snapshot Image with Overlaid Neon Feature Callout Tags -->
              <div class="relative rounded-xl overflow-hidden bg-zinc-950">
                <img
                  src="/images/editor-snapshots/08-editor-hero-workstation.png"
                  alt="Visual Style Editor Live Studio Canvas — Full workspace showing layers tree, canvas inspector, and device switchers"
                  class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-[1.01]"
                  loading="eager"
                  width="1920"
                  height="1080"
                />

                <!-- Glossy Specular Glass Reflection Overlay -->
                <div class="absolute inset-0 pointer-events-none bg-gradient-to-tr from-transparent via-white/[0.02] to-white/[0.07]"></div>

                <!-- Contextual Neon Feature Callout Tags Overlaid on Hotspots -->
                <div class="absolute top-4 left-4 hidden sm:flex items-center gap-2">
                  <span class="neon-callout-tag lime">
                    💾 Direct File System Access
                  </span>
                </div>

                <div class="absolute top-4 right-4 hidden sm:flex items-center gap-2">
                  <span class="neon-callout-tag cyan">
                    🎨 OKLCH Color Tuner
                  </span>
                </div>

                <div class="absolute bottom-4 left-4 hidden sm:flex items-center gap-2">
                  <span class="neon-callout-tag violet">
                    ⚙️ AST Surgical Splicer
                  </span>
                </div>

                <div class="absolute bottom-4 right-4 hidden md:flex items-center gap-2">
                  <span class="neon-callout-tag amber">
                    ⚡ Tailwind v3 & v4 Bridge
                  </span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>


      <!-- ============================================================
           APPROVED SECTION: Inspect, Tune & Export With Zero Friction
           (Retains public/images/studio-editor-mockup.jpg strictly as required)
           ============================================================ -->
      <section class="section py-20 border-t relative" style="background: var(--canvas-subtle); border-color: var(--border);">
        <div class="section-inner space-y-16">
          <div class="section-header text-center max-w-3xl mx-auto" data-reveal="fade-up">
            <span class="badge text-xs font-mono uppercase tracking-wider mb-3 px-3 py-1" style="background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.25);">
              High-Precision UI Studio
            </span>
            <h2 class="text-headline text-3xl sm:text-4xl md:text-5xl font-black">
              Inspect, Tune & Export With Zero Friction
            </h2>
            <p class="text-body text-base sm:text-lg max-w-2xl mx-auto mt-3">
              Real-time element selection, OKLCH harmonic color palette tuner, live typography scales, and surgical character-offset splicing.
            </p>
          </div>

          <!-- Approved 3D Perspective Studio Mockup Art -->
          <div class="max-w-5xl mx-auto" data-reveal="fade-up">
            <div class="card-raised rounded-3xl p-3 sm:p-4 border overflow-hidden shadow-2xl relative group">
              <picture>
                <img
                  src="/images/studio-editor-mockup.jpg"
                  alt="Realistic 3D Perspective Browser Mockup of Visual Style Editor Interface"
                  class="w-full h-auto object-cover rounded-2xl transition-transform duration-500 group-hover:scale-[1.01]"
                  loading="lazy"
                  width="1920"
                  height="1080"
                />
              </picture>

              <!-- Annotation Hotspots -->
              <div class="absolute top-8 left-8 hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full backdrop-blur-md border text-xs font-mono font-bold"
                style="background: rgba(74, 222, 128, 0.18); border-color: #4ade80; color: #4ade80;"
              >
                <span>💾 File System Direct Write</span>
              </div>

              <div class="absolute bottom-10 right-10 hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full backdrop-blur-md border text-xs font-mono font-bold"
                style="background: rgba(56, 189, 248, 0.18); border-color: #38bdf8; color: #38bdf8;"
              >
                <span>⚙️ AST Character Splicer</span>
              </div>
            </div>
          </div>

          <!-- Live Interactive Token Tuner Sandbox -->
          <div class="max-w-4xl mx-auto" data-reveal="fade-up">
            <div class="card-raised overflow-hidden rounded-3xl border shadow-xl">
              <!-- Window chrome -->
              <div
                class="px-5 py-3.5 flex items-center justify-between border-b"
                style="background: var(--surface-2); border-color: var(--border);"
              >
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-red-400/80"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-400/80"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-400/80"></div>
                  <span class="ml-2 text-xs font-mono font-medium" style="color: var(--ink-3);">
                    sandbox-tuner.html
                  </span>
                </div>
                <div class="badge badge-green text-[10px]">
                  <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background: var(--success);"></span>
                  AST live synced
                </div>
              </div>

              <!-- Demo body -->
              <div class="p-6 sm:p-8 grid grid-cols-1 sm:grid-cols-2 gap-8" style="background: var(--surface-1);">
                <!-- Controls -->
                <div class="space-y-6">
                  <div>
                    <p class="text-label text-purple-400 mb-1">Interactive Sandbox</p>
                    <h3 class="text-lg font-bold" style="color: var(--ink-1);">Tactile Style Sliders</h3>
                  </div>

                  <div class="space-y-2">
                    <div class="flex justify-between text-xs font-mono">
                      <span style="color: var(--ink-3);">Border Radius</span>
                      <span id="radius-val" class="font-bold text-purple-400">rounded-2xl</span>
                    </div>
                    <input id="slider-radius" type="range" min="0" max="3" value="2" step="1" class="w-full accent-purple-500 cursor-pointer" />
                  </div>

                  <div class="space-y-2">
                    <div class="flex justify-between text-xs font-mono">
                      <span style="color: var(--ink-3);">Elevation Shadow</span>
                      <span id="glow-val" class="font-bold text-sky-400">shadow-md</span>
                    </div>
                    <input id="slider-glow" type="range" min="1" max="4" value="2" step="1" class="w-full accent-sky-500 cursor-pointer" />
                  </div>

                  <div class="space-y-2">
                    <p class="text-xs font-mono" style="color: var(--ink-3);">Accent Hue Palette</p>
                    <div class="flex items-center gap-3">
                      <button data-color="zinc" class="palette-btn w-7 h-7 rounded-lg border-2 transition-transform hover:scale-110 cursor-pointer" style="background: #71717a; border-color: var(--border-strong);" aria-label="Zinc accent"></button>
                      <button data-color="blue" class="palette-btn w-7 h-7 rounded-lg border transition-transform hover:scale-110 cursor-pointer" style="background: #3b82f6; border-color: transparent;" aria-label="Blue accent"></button>
                      <button data-color="emerald" class="palette-btn w-7 h-7 rounded-lg border transition-transform hover:scale-110 cursor-pointer" style="background: #10b981; border-color: transparent;" aria-label="Emerald accent"></button>
                      <button data-color="rose" class="palette-btn w-7 h-7 rounded-lg border transition-transform hover:scale-110 cursor-pointer" style="background: #f43f5e; border-color: transparent;" aria-label="Rose accent"></button>
                    </div>
                  </div>

                  <!-- Code output -->
                  <div class="code-block text-xs !p-3 rounded-xl">
                    <p class="text-label mb-1 text-zinc-400">Generated Tailwind string</p>
                    <p id="code-output" class="font-bold text-emerald-400 font-mono">rounded-2xl shadow-md</p>
                  </div>
                </div>

                <!-- Live preview card -->
                <div class="flex items-center justify-center p-4">
                  <div
                    id="preview-card"
                    class="w-full p-6 space-y-4 transition-all duration-300"
                    style="background: var(--surface-2); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow-md);"
                  >
                    <div class="flex items-center justify-between">
                      <div id="preview-icon" class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: var(--surface-3);">
                        <svg class="w-5 h-5" style="color: var(--ink-2);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                        </svg>
                      </div>
                      <span class="badge text-[10px] font-mono" id="preview-badge">live preview</span>
                    </div>
                    <div>
                      <p class="text-sm font-bold" style="color: var(--ink-1);">Interactive Component</p>
                      <p class="text-xs mt-1 leading-relaxed" style="color: var(--ink-3);">Move sliders to watch the real-time class string recompute instantly.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>


      <!-- ============================================================
           POSSIBILITIES SHOWCASE: Carousel & Interactive Playground
           ============================================================ -->
      <section id="possibilities" class="py-12">
        <PossibilitiesShowcase client:load />
      </section>


      <!-- ============================================================
           ASYMMETRIC BENTO GRID: "What's Under the Hood"
           ============================================================ -->
      <section id="what-is-under-the-hood" class="section py-20 border-t relative" style="background: var(--canvas); border-color: var(--border);">
        <div class="section-inner space-y-14">
          <div class="section-header text-center max-w-3xl mx-auto" data-reveal="fade-up">
            <span class="badge text-xs font-mono font-bold uppercase tracking-wider mb-3 px-3 py-1 bg-purple-50 text-purple-800 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-500/40">
              Zero Cloud Dependencies
            </span>
            <h2 class="text-headline text-3xl sm:text-4xl md:text-5xl font-black">
              Under the Hood: Surgical Precision
            </h2>
            <p class="text-body text-base sm:text-lg max-w-2xl mx-auto mt-3">
              Explore the Parse5 AST location-tracking engine and OKLCH color science working together at 60 FPS.
            </p>
          </div>

          <!-- Asymmetric Bento Layout Component with Live Splicer & Color Lab -->
          <div data-reveal="fade-up">
            <AsymmetricBentoGrid client:load />
          </div>
        </div>
      </section>


      <!-- ============================================================
           SUPPORTED TECH & FRAMEWORK MATRIX
           ============================================================ -->
      <SupportedTechMatrix />


      <!-- ============================================================
           HARDWARE & SYSTEM REQUIREMENTS GUIDE
           ============================================================ -->
      <HardwareSpecs />


      <!-- ============================================================
           COMPARISON TABLE: Honest & Uncompromising
           ============================================================ -->
      <section class="section py-20 border-t" style="border-color: var(--border); background: var(--canvas-subtle);">
        <div class="section-inner space-y-12">
          <div class="section-header text-center max-w-2xl mx-auto" data-reveal="fade-up">
            <h2 class="text-headline text-3xl sm:text-4xl font-black">How Visual Style Editor Compares</h2>
            <p class="text-body text-base mt-2">
              Not a closed cloud ecosystem. A developer tool designed for your local repository.
            </p>
          </div>

          <div class="card overflow-x-auto rounded-3xl border shadow-xl" data-reveal="fade-up">
            <table class="w-full text-sm" style="border-collapse: collapse; font-family: var(--font-mono);">
              <thead>
                <tr style="border-bottom: 1px solid var(--border); background: var(--surface-2);">
                  <th class="text-left px-6 py-4 text-label font-semibold" style="color: var(--ink-2); min-width: 170px;">Feature</th>
                  <th class="text-left px-6 py-4 text-label font-bold text-purple-700 dark:text-purple-300 min-w-[190px]">VSE (Local Studio)</th>
                  <th class="text-left px-6 py-4 text-label font-medium" style="color: var(--ink-3); min-width: 150px;">Webflow</th>
                  <th class="text-left px-6 py-4 text-label font-medium" style="color: var(--ink-3); min-width: 150px;">Figma</th>
                  <th class="text-left px-6 py-4 text-label font-medium" style="color: var(--ink-3); min-width: 150px;">DevTools</th>
                </tr>
              </thead>
              <tbody>
                {comparisons.map((row, i) => (
                  <tr style={`border-bottom: 1px solid var(--border); background: ${i % 2 === 0 ? 'transparent' : 'var(--surface-1)'};`}>
                    <td class="px-6 py-4 text-xs font-semibold" style="color: var(--ink-1);">{row.feature}</td>
                    <td class="px-6 py-4 text-xs font-bold text-emerald-700 dark:text-emerald-400">{row.vse}</td>
                    <td class="px-6 py-4 text-xs font-medium" style="color: var(--ink-3);">{row.webflow}</td>
                    <td class="px-6 py-4 text-xs font-medium" style="color: var(--ink-3);">{row.figma}</td>
                    <td class="px-6 py-4 text-xs font-medium" style="color: var(--ink-3);">{row.devtools}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>


      <!-- ============================================================
           FAQ SECTION
           ============================================================ -->
      <section class="section py-20 border-t" style="border-color: var(--border); background: var(--canvas);">
        <div class="section-inner">
          <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
            <div class="lg:col-span-2 space-y-3" data-reveal="fade-up">
              <span class="badge text-xs font-mono uppercase tracking-wider px-3 py-1" style="background: rgba(168, 85, 247, 0.1); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.25);">
                Everything Explained
              </span>
              <h2 class="text-headline text-3xl sm:text-4xl font-black">Frequently Asked Questions</h2>
              <p class="text-body text-sm sm:text-base leading-relaxed">
                Clear technical answers. No marketing fluff or evasive jargon.
              </p>
            </div>
            <div class="lg:col-span-3 space-y-0" data-reveal="fade-up">
              {faqs.map((faq, i) => (
                <div
                  class="py-6"
                  style={`border-bottom: 1px solid var(--border);${i === 0 ? 'border-top: 1px solid var(--border);' : ''}`}
                >
                  <h3 class="text-sm sm:text-base font-bold mb-2 tracking-tight" style="color: var(--ink-1);">{faq.q}</h3>
                  <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--ink-3);">{faq.a}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <CtaBanner />
    </main>

    <Footer />
  </div>

  <!-- Interactive sandbox script -->
  <script is:inline>
    (function() {
      var radiusSlider = document.getElementById('slider-radius');
      var radiusVal = document.getElementById('radius-val');
      var glowSlider = document.getElementById('slider-glow');
      var glowVal = document.getElementById('glow-val');
      var codeOutput = document.getElementById('code-output');
      var previewCard = document.getElementById('preview-card');
      var previewIcon = document.getElementById('preview-icon');
      var previewBadge = document.getElementById('preview-badge');
      var paletteBtns = document.querySelectorAll('.palette-btn');

      if (!radiusSlider || !previewCard) return;

      var radii = [
        { label: 'rounded-none', px: '0px' },
        { label: 'rounded-lg', px: '8px' },
        { label: 'rounded-2xl', px: '16px' },
        { label: 'rounded-3xl', px: '24px' },
      ];
      var shadows = [
        { label: 'shadow-none', val: 'none' },
        { label: 'shadow-sm', val: 'var(--shadow-sm)' },
        { label: 'shadow-md', val: 'var(--shadow-md)' },
        { label: 'shadow-lg', val: 'var(--shadow-lg)' },
      ];

      var currentColor = 'zinc';
      var accentMap = {
        zinc:    { bg: 'rgba(113,113,122,0.15)', border: 'rgba(113,113,122,0.35)', text: '#71717a' },
        blue:    { bg: 'rgba(59,130,246,0.12)',  border: 'rgba(59,130,246,0.3)',   text: '#60a5fa' },
        emerald: { bg: 'rgba(16,185,129,0.12)',  border: 'rgba(16,185,129,0.3)',   text: '#4ade80' },
        rose:    { bg: 'rgba(244,63,94,0.12)',   border: 'rgba(244,63,94,0.3)',    text: '#fb7185' },
      };

      function update() {
        var rIdx = parseInt(radiusSlider.value, 10);
        var gIdx = parseInt(glowSlider.value, 10) - 1;
        var r = radii[rIdx];
        var s = shadows[gIdx];
        var accent = accentMap[currentColor];

        if (radiusVal) radiusVal.textContent = r.label;
        if (glowVal) glowVal.textContent = s.label;
        if (codeOutput) codeOutput.textContent = r.label + ' ' + s.label;

        previewCard.style.borderRadius = r.px;
        previewCard.style.boxShadow = s.val;
        previewCard.style.borderColor = accent.border;
        if (previewIcon) {
          previewIcon.style.background = accent.bg;
          previewIcon.style.color = accent.text;
        }
        if (previewBadge) {
          previewBadge.style.color = accent.text;
          previewBadge.style.borderColor = accent.border;
        }
      }

      radiusSlider.addEventListener('input', update);
      glowSlider.addEventListener('input', update);

      paletteBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          paletteBtns.forEach(function(b) {
            b.style.borderWidth = '1px';
            b.style.borderColor = 'transparent';
          });
          btn.style.borderWidth = '2px';
          btn.style.borderColor = 'var(--border-strong)';
          currentColor = btn.getAttribute('data-color') || 'zinc';
          update();
        });
      });

      update();
    })();
  </script>
</BaseLayout>
