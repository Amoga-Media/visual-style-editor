      <!-- Global Call To Action -->
      <CtaBanner />
    </main>

    <Footer />
  </div>

  <!-- Interactive Sandbox Live Script -->
  <script is:inline>
    (function () {
      const radiusSlider = document.getElementById('slider-radius');
      const radiusVal = document.getElementById('radius-val');
      const glowSlider = document.getElementById('slider-glow');
      const glowVal = document.getElementById('glow-val');
      const targetCard = document.getElementById('target-card');
      const codeSnippet = document.getElementById('code-snippet');
      const targetIcon = document.getElementById('target-icon');
      const targetBadge = document.getElementById('target-badge');
      const targetToken = document.getElementById('target-token');
      const paletteBtns = document.querySelectorAll('.palette-btn');

      if (!radiusSlider || !targetCard) return;

      const radii = ['rounded-none', 'rounded-lg', 'rounded-2xl', 'rounded-3xl'];
      const glows = [
        'shadow-none',
        'shadow-lg shadow-cyan-500/20',
        'shadow-xl shadow-cyan-500/30',
        'shadow-2xl shadow-cyan-500/50'
      ];

      let currentTheme = 'cyan';

      function updateCard() {
        const rIndex = parseInt(radiusSlider.value, 10);
        const gIndex = parseInt(glowSlider.value, 10) - 1;

        const currentRadius = radii[rIndex];
        const currentGlow = glows[gIndex];

        radiusVal.textContent = currentRadius;
        glowVal.textContent = currentGlow.replace('shadow-cyan-500/30', `shadow-${currentTheme}-500/30`);

        // Update target card classes
        targetCard.className = `w-full max-w-md p-6 sm:p-8 bg-[#131722] border transition-all duration-300 space-y-5 ${currentRadius} ${currentGlow} border-${currentTheme}-500/40`;
        
        // Update code snippet
        codeSnippet.textContent = `${currentRadius} ${currentGlow} border-${currentTheme}-500/40`;
      }

      radiusSlider.addEventListener('input', updateCard);
      glowSlider.addEventListener('input', updateCard);

      paletteBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          paletteBtns.forEach(b => b.classList.remove('ring-2', 'ring-white', 'ring-offset-2', 'ring-offset-[#0e111a]'));
          btn.classList.add('ring-2', 'ring-white', 'ring-offset-2', 'ring-offset-[#0e111a]');
          currentTheme = btn.getAttribute('data-theme') || 'cyan';

          if (targetIcon) {
            targetIcon.className = `w-10 h-10 rounded-xl bg-${currentTheme}-500/20 text-${currentTheme}-400 flex items-center justify-center border border-${currentTheme}-500/30`;
          }
          if (targetBadge) {
            targetBadge.className = `px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-${currentTheme}-950 text-${currentTheme}-300 border border-${currentTheme}-500/30`;
          }
          if (targetToken) {
            targetToken.className = `text-${currentTheme}-400 font-bold`;
            targetToken.textContent = `--color-${currentTheme}`;
          }

          updateCard();
        });
      });
    })();
  </script>
</BaseLayout>
