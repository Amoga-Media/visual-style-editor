---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";
import { FaqAccordion } from "@/components/marketing/FaqAccordion";

const faqs = [
  {
    q: "How does Visual Style Editor edit my files without a server?",
    a: "Visual Style Editor runs 100% client-side in your web browser. When you drop an HTML file or open a local folder, it uses the native File System Access API and an in-memory Parse5 AST (Abstract Syntax Tree) engine. Your source code, comments, formatting, and scripts are parsed, modified surgically, and saved directly to your local drive without a single byte ever touching a remote server."
  },
  {
    q: "Does it support Tailwind CSS v3 and the new Tailwind v4?",
    a: "Yes! Visual Style Editor features an automated Tailwind engine that detects both Tailwind v3 class conventions and modern Tailwind v4 theme variables. When you adjust visual sliders for spacing, typography, colors, or shadows, the editor maps your choices into idiomatic Tailwind utility classes."
  },
  {
    q: "Will it mess up my HTML formatting or delete my template comments?",
    a: "Never. Unlike conventional visual site builders that parse HTML into proprietary JSON and serialize back messy spaghetti code, Visual Style Editor uses an AST-first surgical splicing algorithm. It tracks exact source code locations, altering only the specific class attributes or style properties you touched while leaving surrounding HTML, conditional tags, and comments untouched."
  },
  {
    q: "Is it really completely free?",
    a: "Yes, 100% free and open-source under the MIT license. There are no paywalls, no monthly subscription fees, no locked exports, and no forced watermarks. We believe developer tools for local files should remain free and sovereign."
  },
  {
    q: "What browsers are supported for direct saving?",
    a: "Direct file and directory saving works natively in Chromium-based browsers (Google Chrome, Microsoft Edge, Brave, Arc, Opera) using the File System Access API. On browsers without File System Access (like Safari or Firefox), you can edit seamlessly and download your modified HTML with one click."
  }
];

const comparisons = [
  { feature: "Pricing Model", vse: "100% Free Forever (MIT)", webflow: "$14–$39+/mo", figma: "$12–$75+/mo", devtools: "Free" },
  { feature: "Code Ownership", vse: "Direct On Your Local Disk", webflow: "Locked in Cloud DB", figma: "Canvas Vectors Only", devtools: "Lost on Page Reload" },
  { feature: "Tailwind CSS Native", vse: "Yes (v3 & v4 syntax)", webflow: "No (Proprietary CSS)", figma: "Requires Plugins", devtools: "Manual Typing Only" },
  { feature: "AST Comment Preservation", vse: "100% Surgical Preservation", webflow: "Strips All Comments", figma: "N/A", devtools: "N/A" },
  { feature: "Zero Telemetry / Privacy", vse: "Zero Data Sent to Cloud", webflow: "All Data Tracked", figma: "Cloud Hosted", devtools: "Local Only" },
  { feature: "Offline Capable", vse: "Yes (100% In-Browser)", webflow: "No (Requires Internet)", figma: "Limited", devtools: "Yes" },
];
---

<BaseLayout
  title="Visual Style Editor — Next-Gen In-Browser Tailwind CSS & HTML Studio"
  description="A high-performance visual editor for HTML and Tailwind CSS operating directly in your browser. Zero backend, zero telemetry, zero lock-in — just pure, surgical AST code editing."
  theme="dark"
  showPixelCanvas={true}
>
  <div class="relative min-h-screen flex flex-col bg-[#060608] text-slate-100 overflow-hidden">
    <Navbar activePage="home" />

    <main class="flex-1">
      <!-- ========================================================
           HERO SECTION: ASYMMETRICAL AGENCY SHOWCASE & LIVE SANDBOX
           ======================================================== -->
      <section class="relative pt-12 sm:pt-24 pb-20 sm:pb-32 px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto text-center space-y-8">
          <!-- Eyebrow Pill -->
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-cyan-950/60 text-cyan-300 border border-cyan-500/30 shadow-lg shadow-cyan-500/10">
            <span class="flex h-2 w-2 rounded-full bg-cyan-400 animate-ping"></span>
            <span>Local-First AST Engine • Zero Cloud Lock-in</span>
          </div>

          <!-- Main Headline with Kinetic Typography -->
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08]">
            Design at the speed of thought. <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">
              Export clean Tailwind code.
            </span>
          </h1>

          <!-- Subheadline -->
          <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed font-normal">
            Drop any HTML file or Tailwind template directly into your browser. Tweak design tokens visually, 
            sculpt typography, harmonize OKLCH palettes, and write surgically spliced AST code back to your local files with zero server roundtrips.
          </p>

          <!-- Primary CTAs (Nested Button-in-Button Pattern) -->
          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/editor"
              class="group relative inline-flex items-center gap-3 pl-8 pr-2.5 py-4 rounded-full text-base font-bold text-black bg-gradient-to-r from-cyan-400 via-sky-300 to-cyan-300 hover:brightness-110 shadow-xl shadow-cyan-500/25 active:scale-98 transition-all duration-200"
            >
              <span>Launch Studio Free</span>
              <span class="w-8 h-8 rounded-full bg-black/15 flex items-center justify-center transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-0.5">
                <svg class="w-4 h-4 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </a>

            <a
              href="/templates"
              class="inline-flex items-center gap-2.5 px-7 py-4 rounded-full text-base font-semibold text-slate-200 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-all"
            >
              <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
              </svg>
              <span>Explore Starter Templates</span>
            </a>
          </div>

          <!-- Trust Signals -->
          <div class="pt-6 flex flex-wrap items-center justify-center gap-y-3 gap-x-8 text-xs font-mono text-slate-400">
            <span class="flex items-center gap-1.5"><span class="text-cyan-400 font-bold">✓</span> No Account Required</span>
            <span class="flex items-center gap-1.5"><span class="text-cyan-400 font-bold">✓</span> Zero Telemetry / Analytics</span>
            <span class="flex items-center gap-1.5"><span class="text-cyan-400 font-bold">✓</span> Native File System Access</span>
            <span class="flex items-center gap-1.5"><span class="text-cyan-400 font-bold">✓</span> 100% Offline Capable</span>
          </div>
        </div>

        <!-- ========================================================
             INTERACTIVE HERO LIVE SANDBOX (DOPPELRAND CHASSIS)
             ======================================================== -->
        <div class="max-w-6xl mx-auto mt-16 sm:mt-24">
          <div class="doppelrand-shell spotlight-card">
            <div class="doppelrand-core">
              <!-- Window Top Bar -->
              <div class="px-5 py-3.5 bg-[#0a0c12] border-b border-white/10 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
                  <span class="ml-2 text-xs font-mono text-slate-400 hidden sm:inline">interactive-preview-sandbox.html</span>
                </div>

                <div class="flex items-center gap-3">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-medium bg-emerald-950/70 text-emerald-400 border border-emerald-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Live 60fps AST Sync
                  </span>
                  <a href="/editor" class="text-xs font-mono font-medium text-cyan-400 hover:text-cyan-300 transition-colors">
                    Full Studio ↗
                  </a>
                </div>
              </div>

              <!-- Interactive Playground Canvas -->
              <div class="p-6 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-[#090b10]">
                <!-- Left: Live Visual Controls -->
                <div class="lg:col-span-5 space-y-6 bg-[#0e111a] p-6 rounded-2xl border border-white/5 shadow-inner">
                  <div class="flex items-center justify-between border-b border-white/10 pb-3">
                    <span class="text-xs font-mono uppercase tracking-wider text-slate-300 font-bold">Interactive Token Tuner</span>
                    <span class="text-[10px] font-mono text-cyan-400 bg-cyan-950/60 px-2 py-0.5 rounded border border-cyan-500/30">Live HTML</span>
                  </div>

                  <!-- Control: Border Radius -->
                  <div class="space-y-2">
                    <div class="flex justify-between text-xs font-mono text-slate-400">
                      <span>Border Radius</span>
                      <span id="radius-val" class="text-cyan-400 font-bold">rounded-2xl</span>
                    </div>
                    <input id="slider-radius" type="range" min="0" max="3" value="2" step="1" class="w-full accent-cyan-400 cursor-pointer" />
                  </div>

                  <!-- Control: Glow Intensity -->
                  <div class="space-y-2">
                    <div class="flex justify-between text-xs font-mono text-slate-400">
                      <span>Glow Intensity</span>
                      <span id="glow-val" class="text-cyan-400 font-bold">shadow-cyan-500/30</span>
                    </div>
                    <input id="slider-glow" type="range" min="1" max="4" value="2" step="1" class="w-full accent-cyan-400 cursor-pointer" />
                  </div>

                  <!-- Control: Color Palette Preset -->
                  <div class="space-y-2">
                    <span class="text-xs font-mono text-slate-400 block">Accent Palette</span>
                    <div class="flex items-center gap-2.5">
                      <button data-theme="cyan" class="palette-btn w-7 h-7 rounded-full bg-cyan-400 ring-2 ring-white ring-offset-2 ring-offset-[#0e111a] transition-transform hover:scale-110"></button>
                      <button data-theme="indigo" class="palette-btn w-7 h-7 rounded-full bg-indigo-500 hover:scale-110 transition-transform"></button>
                      <button data-theme="emerald" class="palette-btn w-7 h-7 rounded-full bg-emerald-400 hover:scale-110 transition-transform"></button>
                      <button data-theme="fuchsia" class="palette-btn w-7 h-7 rounded-full bg-fuchsia-400 hover:scale-110 transition-transform"></button>
                    </div>
                  </div>

                  <!-- Simulated AST Code Output -->
                  <div class="pt-3 border-t border-white/5 space-y-1">
                    <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider block">Real-Time Generated Class</span>
                    <div id="code-snippet" class="p-2.5 rounded-lg bg-[#06070a] border border-white/5 text-[11px] font-mono text-cyan-300 break-all">
                      rounded-2xl shadow-xl shadow-cyan-500/30 border-cyan-500/40
                    </div>
                  </div>
                </div>

                <!-- Right: Live Rendered Target Card -->
                <div class="lg:col-span-7 flex flex-col items-center justify-center p-4">
                  <div id="target-card" class="w-full max-w-md p-6 sm:p-8 bg-[#131722] border border-cyan-500/40 rounded-2xl shadow-xl shadow-cyan-500/30 transition-all duration-300 space-y-5">
                    <div class="flex items-center justify-between">
                      <div id="target-icon" class="w-10 h-10 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center border border-cyan-500/30">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                        </svg>
                      </div>
                      <span id="target-badge" class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-cyan-950 text-cyan-300 border border-cyan-500/30">
                        AST SYNCHRONIZED
                      </span>
                    </div>

                    <div>
                      <h4 class="text-xl font-bold text-white tracking-tight">Enterprise Design System</h4>
                      <p class="text-xs sm:text-sm text-slate-300 mt-1 leading-relaxed">
                        Drag the controls on the left. Notice how every visual adjustment updates the AST code in real time without refreshing.
                      </p>
                    </div>

                    <div class="pt-2 flex items-center justify-between border-t border-white/10 text-xs font-mono text-slate-400">
                      <span>Status: Verified</span>
                      <span id="target-token" class="text-cyan-400 font-bold">--color-cyan</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================================================
           SHADCN-SPACE BENTO GRID: ARCHITECTURE & CORE ADVANTAGES
           ======================================================== -->
      <section class="py-24 sm:py-32 px-4 sm:px-6 lg:px-8 border-t border-white/10 bg-[#07090e]/60">
        <div class="max-w-7xl mx-auto space-y-16">
          <div class="text-center max-w-3xl mx-auto space-y-4">
            <span class="text-xs font-mono font-semibold uppercase tracking-widest text-cyan-400">Under The Hood</span>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
              Surgical AST Editing. Built for Production.
            </h2>
            <p class="text-base sm:text-lg text-slate-400 leading-relaxed">
              Never choose between visual velocity and pristine code craftsmanship. Visual Style Editor bridges both worlds seamlessly.
            </p>
          </div>

          <!-- 5-Cell Asymmetrical Bento Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
            <!-- Cell 1: Large Feature (Span 8) -->
            <div class="lg:col-span-8 doppelrand-shell spotlight-card">
              <div class="doppelrand-core p-8 sm:p-10 flex flex-col justify-between h-full space-y-8">
                <div class="space-y-4">
                  <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center border border-cyan-500/30">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
                    </svg>
                  </div>
                  <h3 class="text-2xl font-bold text-white tracking-tight">Surgical Parse5 AST Splicer</h3>
                  <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl">
                    Unlike standard site builders that demolish your HTML and regenerate messy code, our engine tracks the exact source offsets of every tag. Your custom template tags, PHP/Blade logic, inline scripts, and developer comments stay 100% intact.
                  </p>
                </div>

                <div class="p-4 rounded-xl bg-[#090b10] border border-white/5 font-mono text-xs text-slate-300 space-y-2">
                  <div class="flex items-center justify-between text-slate-500 pb-2 border-b border-white/5">
                    <span>ast-splicing-diff.tsx</span>
                    <span class="text-emerald-400">0 ms server latency</span>
                  </div>
                  <div class="text-rose-400">- &lt;div class="px-4 py-2 bg-slate-100"&gt; &lt;!-- Client review note --&gt;</div>
                  <div class="text-emerald-400">+ &lt;div class="px-6 py-3.5 bg-cyan-950 text-cyan-300 rounded-full"&gt; &lt;!-- Client review note --&gt;</div>
                </div>
              </div>
            </div>

            <!-- Cell 2: Tailwind v3 & v4 Engine (Span 4) -->
            <div class="lg:col-span-4 doppelrand-shell spotlight-card">
              <div class="doppelrand-core p-8 flex flex-col justify-between h-full space-y-6">
                <div class="space-y-3">
                  <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center border border-indigo-500/30">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-white tracking-tight">Tailwind v3 & v4 Bridge</h3>
                  <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                    Auto-detects whether your project runs classic Tailwind utility configs or the new CSS variable-first Tailwind v4 `@theme` architecture.
                  </p>
                </div>
                <div class="flex items-center gap-2 pt-2">
                  <span class="px-3 py-1 rounded-full text-[11px] font-mono bg-cyan-950/60 text-cyan-300 border border-cyan-500/30">v3 Utility Maps</span>
                  <span class="px-3 py-1 rounded-full text-[11px] font-mono bg-indigo-950/60 text-indigo-300 border border-indigo-500/30">v4 @theme Tokens</span>
                </div>
              </div>
            </div>

            <!-- Cell 3: Direct Disk Sync (Span 4) -->
            <div class="lg:col-span-4 doppelrand-shell spotlight-card">
              <div class="doppelrand-core p-8 flex flex-col justify-between h-full space-y-6">
                <div class="space-y-3">
                  <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center border border-emerald-500/30">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-white tracking-tight">Direct Local Disk Sync</h3>
                  <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                    Uses the browser's native File System Access API. Press Save, and your changes write straight to your disk repository in under 2ms.
                  </p>
                </div>
                <div class="text-xs font-mono text-emerald-400">
                  ⚡ 0.4ms Native IO Latency
                </div>
              </div>
            </div>

            <!-- Cell 4: Inline WYSIWYG Editing (Span 4) -->
            <div class="lg:col-span-4 doppelrand-shell spotlight-card">
              <div class="doppelrand-core p-8 flex flex-col justify-between h-full space-y-6">
                <div class="space-y-3">
                  <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center border border-amber-500/30">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-white tracking-tight">Double-Click Text Editing</h3>
                  <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                    Double-click any heading or paragraph right in the preview canvas to rewrite copy inline, maintaining typography tags perfectly.
                  </p>
                </div>
                <div class="text-xs font-mono text-slate-400">
                  No inspector needed for copy changes.
                </div>
              </div>
            </div>

            <!-- Cell 5: OKLCH & Color Harmonizer (Span 4) -->
            <div class="lg:col-span-4 doppelrand-shell spotlight-card">
              <div class="doppelrand-core p-8 flex flex-col justify-between h-full space-y-6">
                <div class="space-y-3">
                  <div class="w-10 h-10 rounded-xl bg-fuchsia-500/10 text-fuchsia-400 flex items-center justify-center border border-fuchsia-500/30">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.433-.432 1.077-.52 1.603-.223l2.88 1.62c.43.242.668.736.586 1.222l-.72 4.32a1.125 1.125 0 01-.645.856l-3.69 1.845a1.125 1.125 0 01-1.004-.047l-1.89-1.05" />
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-white tracking-tight">OKLCH Color Tuner</h3>
                  <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
                    Perceptually uniform color sliders that calculate harmonic color palettes, complementary contrasts, and accessible WCAG ratios automatically.
                  </p>
                </div>
                <div class="text-xs font-mono text-fuchsia-400">
                  WCAG AAA Compliance Helper
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================================================
           INTERACTIVE 3-STEP WORKFLOW SCRUBBER
           ======================================================== -->
      <section class="py-24 sm:py-32 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
        <div class="max-w-6xl mx-auto space-y-16">
          <div class="text-center max-w-2xl mx-auto space-y-4">
            <span class="text-xs font-mono font-semibold uppercase tracking-widest text-cyan-400">Workflow</span>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
              Three Steps. Zero Confusion.
            </h2>
            <p class="text-slate-400 text-sm sm:text-base">
              From raw HTML file to pixel-perfect design in minutes.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Step 1 -->
