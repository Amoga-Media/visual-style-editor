---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/marketing/Navbar.astro";
import Footer from "@/components/marketing/Footer.astro";
import CtaBanner from "@/components/marketing/CtaBanner.astro";
import FloatingBadges from "@/components/marketing/FloatingBadges";
import StoryManifestoInteractive from "@/components/marketing/StoryManifestoInteractive";
import Icon from "@/components/ui/Icon.astro";

const coreValues = [
  {
    icon: "violet",
    iconName: "shield",
    title: "Zero Telemetry & Tracking",
    body: "We don't track what you build, what files you open, or how long you spend editing. No analytics beacons, no third-party scripts. Your code never leaves your computer.",
  },
  {
    icon: "lime",
    iconName: "hard-drive",
    title: "Local-First Realtime Speed",
    body: "Everything executes strictly in browser memory. No network round-trips to verify subscription seats or persist drafts. Sliders update at 60 FPS because there's nothing remote to wait on.",
  },
  {
    icon: "cyan",
    iconName: "ast",
    title: "Surgical Code Integrity",
    body: "Your indentation, server template logic (Blade, PHP, Liquid), and developer comments stay exactly where you wrote them. The AST splicer operates at byte offset precision.",
  },
  {
    icon: "amber",
    iconName: "open-source",
    title: "Honest Open Source",
    body: "MIT licensed and unconditionally free. Not an 'open core' bait-and-switch with gated features. The complete, production-ready studio is yours forever.",
  },
];
---

<BaseLayout
  title="Our Story — The Visual Style Editor Founder Manifesto"
  description="Why we refused to let site builders hold our code hostage: how frustration with lost DevTools edits led to an in-browser surgical AST editor with zero cloud dependencies."
>
  <div class="flex flex-col min-h-[100dvh]">
    <Navbar activePage="our story" />

    <main id="main-content" class="flex-1">

      <!-- ============================================================
           HERO: Bold Founder Manifesto Statement
           ============================================================ -->
      <section class="relative overflow-hidden pt-8 sm:pt-12 md:pt-14 pb-16 lg:pb-20 px-4 sm:px-6 lg:px-8" data-parallax-section>
        {/* Vibrant Multi-Layered Ambient Studio Aura & Grid Texture */}
        <div class="hero-ambient-glow" aria-hidden="true">
          <div class="hero-glow-orb magenta"></div>
          <div class="hero-grid-pattern"></div>
        </div>

        <div class="max-w-4xl mx-auto relative z-10 space-y-8">
          <div class="max-w-4xl mx-auto text-center space-y-6" data-reveal="fade-up">
            <div
              class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider border select-none shadow-sm backdrop-blur-xl mx-auto bg-purple-50 text-purple-800 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-500/40"
            >
              <span class="w-2 h-2 rounded-full bg-pink-600 dark:bg-pink-400 animate-pulse"></span>
              <span>The Founder Manifesto · 2021 to 2026</span>
            </div>

            <h1
              class="text-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight leading-[1.08]"
              data-motion-text="words"
            >
              Why we refused to let site builders <br />
              <span class="gradient-text">hold our code hostage.</span>
            </h1>

            <p class="text-body text-base sm:text-lg md:text-xl max-w-2xl mx-auto" style="color: var(--ink-2);">
              For years, visual styling meant surrendering your codebase to proprietary cloud databases and watching visual builders strip comments and template tags. We set out to change that forever.
            </p>

            <div class="pt-2">
              <FloatingBadges client:load />
            </div>
          </div>
        </div>
      </section>

      <hr class="section-divider" />

      <!-- ============================================================
           INTERACTIVE MANIFESTO: Slider, Milestones, Philosophy Grid
           ============================================================ -->
      <section class="section py-20 relative">
        <div class="section-inner" data-reveal="fade-up">
          <StoryManifestoInteractive client:load />
        </div>
      </section>

      <!-- ============================================================
           CORE ETHICAL VALUES: Frosted Glass Grid
           ============================================================ -->
      <section class="section border-t" style="border-color: var(--border); background: var(--canvas-subtle);">
        <div class="section-inner space-y-12">
          <div class="section-header max-w-2xl mx-auto text-center" data-reveal="fade-up">
            <span class="badge text-xs font-mono font-bold uppercase tracking-wider mb-2 px-3 py-1 bg-purple-50 text-purple-800 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-500/40">
              Guiding Principles
            </span>
            <h2 class="text-headline text-3xl sm:text-4xl font-black">Things We Will Never Compromise On</h2>
            <p class="text-body text-base mt-2">
              Architectural decisions that put developer freedom ahead of vendor profit.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-reveal-group>
            {coreValues.map((v) => (
              <div
                class="tile rounded-3xl p-8 border space-y-4"
                data-reveal-item
                style="background: var(--surface-1); border-color: var(--border);"
              >
                <div class={`frosted-icon-capsule ${v.icon}`}>
                  <Icon name={v.iconName} class="w-6 h-6" />
                </div>
                <h3 class="text-title text-xl font-bold" style="color: var(--ink-1);">{v.title}</h3>
                <p class="text-sm leading-relaxed" style="color: var(--ink-3);">{v.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <CtaBanner
        headline="Your HTML file. Your terms."
        subheadline="No sign-up, no cloud sync, no monthly subscription. Open the editor and start styling."
        ctaText="Launch Visual Studio"
      />
    </main>

    <Footer />
  </div>
</BaseLayout>
