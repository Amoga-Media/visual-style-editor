---
interface Props {
  size?: "sm" | "md" | "lg";
  showStatusPill?: boolean;
  className?: string;
}

const { size = "md", showStatusPill = false, className = "" } = Astro.props;

const dimensions = {
  sm: { icon: "w-7 h-7", text: "text-xs", status: "hidden" },
  md: { icon: "w-8 h-8", text: "text-sm", status: "hidden sm:inline-flex" },
  lg: { icon: "w-10 h-10", text: "text-base", status: "inline-flex" },
}[size];
---

<div class={`inline-flex items-center gap-3 select-none group/logo ${className}`}>
  <!-- Logo Icon Container -->
  <div class={`relative ${dimensions.icon} flex items-center justify-center rounded-xl p-1 transition-transform duration-300 ease-out group-hover/logo:scale-105`} style="background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(59, 130, 246, 0.1)); border: 1px solid rgba(139, 92, 246, 0.3); box-shadow: 0 0 15px rgba(139, 92, 246, 0.2);">
    <!-- SVG Animated Mark -->
    <svg
      viewBox="0 0 40 40"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-full transform transition-transform duration-500 group-hover/logo:rotate-6"
    >
      <defs>
        <!-- Gradient for brackets -->
        <linearGradient id="bracket-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#a855f7" />
          <stop offset="50%" stop-color="#38bdf8" />
          <stop offset="100%" stop-color="#4ade80" />
        </linearGradient>

        <!-- Glow filter -->
        <filter id="logo-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="1.5" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      <!-- Ambient glow circle -->
      <circle cx="20" cy="20" r="14" fill="#a855f7" opacity="0.12" class="logo-pulse-ambient" />

      <!-- Left bracket < -->
      <path
        d="M 12 14 L 6 20 L 12 26"
        stroke="url(#bracket-grad)"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-all duration-300 group-hover/logo:-translate-x-0.5"
      />

      <!-- Right bracket > -->
      <path
        d="M 28 14 L 34 20 L 28 26"
        stroke="url(#bracket-grad)"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-all duration-300 group-hover/logo:translate-x-0.5"
      />

      <!-- Slider track (horizontal centerline control) -->
      <line
        x1="13"
        y1="20"
        x2="27"
        y2="20"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-dasharray="2 2"
        opacity="0.35"
      />

      <!-- Color Swatch & Slider Handle: breathing pulse idle, spring shifts on hover -->
      <g class="logo-swatch-handle">
        <rect
          x="16.5"
          y="15.5"
          width="7"
          height="9"
          rx="2.5"
          fill="#a855f7"
          stroke="#fafafa"
          stroke-width="1.2"
          filter="url(#logo-glow)"
          class="logo-swatch"
        >
          <animate
            attributeName="fill"
            values="#a855f7;#38bdf8;#4ade80;#f59e0b;#a855f7"
            dur="6s"
            repeatCount="indefinite"
          />
        </rect>
        <!-- Center indicator dot -->
        <circle cx="20" cy="20" r="1.2" fill="#ffffff" />
      </g>

      <!-- Spark particles (burst on hover via CSS) -->
      <g class="logo-sparks opacity-0 group-hover/logo:opacity-100 transition-opacity duration-200">
        <path d="M 20 6 L 20 9" stroke="#fbbf24" stroke-width="1.5" stroke-linecap="round" />
        <path d="M 20 31 L 20 34" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round" />
        <path d="M 33 11 L 31 13" stroke="#38bdf8" stroke-width="1.5" stroke-linecap="round" />
        <path d="M 7 29 L 9 27" stroke="#a855f7" stroke-width="1.5" stroke-linecap="round" />
      </g>
    </svg>
  </div>

  <!-- Wordmark Text -->
  <div class="flex flex-col">
    <div class="flex items-center gap-2">
      <span class={`${dimensions.text} font-bold tracking-tight text-ink-1 flex items-center gap-1.5`} style="color: var(--ink-1); letter-spacing: -0.025em;">
        Visual Style Editor
      </span>
      {showStatusPill && (
        <span
          class={`items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold border ${dimensions.status} transition-all duration-200 bg-emerald-50 text-emerald-800 border-emerald-300 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-500/30`}
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse"></span>
          v1.4 AST Live
        </span>
      )}
    </div>
  </div>
</div>

<style>
  @keyframes logo-breathing {
    0%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.08);
      opacity: 1;
    }
  }

  .logo-swatch {
    transform-origin: 20px 20px;
    animation: logo-breathing 3s ease-in-out infinite;
  }

  .logo-swatch-handle {
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .group\/logo:hover .logo-swatch-handle {
    transform: translateX(2px);
  }
</style>
