---
import Logo from "@/components/marketing/Logo.astro";

interface Props {
  activePage?: string;
}

const { activePage = "" } = Astro.props;

const navItems = [
  { label: "Features", href: "/features" },
  { label: "How it works", href: "/how-it-works" },
  { label: "Templates", href: "/templates" },
  { label: "Our story", href: "/our-story" },
];
---

<header class="sticky top-0 z-50 w-full border-b backdrop-blur-xl transition-colors duration-200" style="background: color-mix(in srgb, var(--canvas) 85%, transparent); border-color: var(--border);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand -->
    <a
      href="/"
      class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 rounded-xl pr-2"
      aria-label="Visual Style Editor — home"
    >
      <Logo size="md" showStatusPill={false} />
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-1 sm:gap-1.5" role="navigation" aria-label="Main navigation">
      {navItems.map((item) => {
        const slug = item.href.replace("/", "").replace(/-/g, " ");
        const isActive = activePage === slug || activePage === item.label.toLowerCase();
        return (
          <a
            href={item.href}
            class={`px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-150 ${
              isActive
                ? "bg-purple-100 text-purple-900 dark:bg-purple-950/60 dark:text-purple-300 font-bold shadow-xs"
                : "text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5"
            }`}
            aria-current={isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right: Theme toggle + CTA + Mobile hamburger -->
    <div class="flex items-center gap-2.5">
      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle light/dark theme"
        class="w-9 h-9 rounded-xl flex items-center justify-center transition-all duration-150 cursor-pointer border hover:scale-105 active:scale-95"
        style="background: var(--surface-2); border-color: var(--border); color: var(--ink-2);"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="icon-sun" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 110 10A5 5 0 0112 7z"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="icon-moon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- CTA -->
      <a
        href="/editor"
        class="btn btn-primary text-xs px-4 py-2 rounded-xl shadow-md hover:shadow-lg transition-all"
        id="nav-cta"
      >
        <span>Open editor</span>
        <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden w-9 h-9 rounded-xl flex items-center justify-center border transition-colors duration-150 cursor-pointer"
        style="background: var(--surface-2); border-color: var(--border); color: var(--ink-2);"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg id="ham-open" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="ham-close" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div
    id="mobile-drawer"
    class="hidden md:hidden border-t px-4 py-3"
    style="background: var(--surface-1); border-color: var(--border); box-shadow: var(--shadow-lg);"
    role="menu"
  >
    <div class="flex flex-col gap-1">
      {navItems.map((item) => {
        const slug = item.href.replace("/", "").replace(/-/g, " ");
        const isActive = activePage === slug || activePage === item.label.toLowerCase();
        return (
          <a
            href={item.href}
            role="menuitem"
            class={`px-3.5 py-2.5 rounded-lg text-sm font-semibold transition-colors duration-150 ${
              isActive
                ? "bg-purple-100 text-purple-900 dark:bg-purple-950/60 dark:text-purple-300 font-bold"
                : "text-zinc-700 dark:text-zinc-300 hover:text-black dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5"
            }`}
          >
            {item.label}
          </a>
        );
      })}
      <div class="pt-3 mt-1 border-t" style="border-color: var(--border);">
        <a
          href="/editor"
          class="btn btn-primary w-full justify-center text-sm rounded-xl py-3"
        >
          Open editor
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  // Theme toggle
  var toggleBtn = document.getElementById('theme-toggle');
  var iconSun = document.getElementById('icon-sun');
  var iconMoon = document.getElementById('icon-moon');

  function syncIcons() {
    var isDark = document.documentElement.classList.contains('dark');
    if (iconSun) iconSun.classList.toggle('hidden', !isDark);
    if (iconMoon) iconMoon.classList.toggle('hidden', isDark);
  }

  syncIcons();

  if (toggleBtn) {
    toggleBtn.addEventListener('click', function() {
      var isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
      syncIcons();
    });
  }

  // Mobile menu
  var mobileToggle = document.getElementById('mobile-menu-toggle');
  var drawer = document.getElementById('mobile-drawer');
  var hamOpen = document.getElementById('ham-open');
  var hamClose = document.getElementById('ham-close');

  if (mobileToggle && drawer) {
    mobileToggle.addEventListener('click', function() {
      var isOpen = !drawer.classList.contains('hidden');
      drawer.classList.toggle('hidden', isOpen);
      hamOpen && hamOpen.classList.toggle('hidden', !isOpen);
      hamClose && hamClose.classList.toggle('hidden', isOpen);
      mobileToggle.setAttribute('aria-expanded', String(!isOpen));
    });
  }
</script>
