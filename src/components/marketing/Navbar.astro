---
interface Props {
  activePage?: string;
}

const { activePage = "" } = Astro.props;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Features", href: "/features" },
  { label: "How It Works", href: "/how-it-works" },
  { label: "Templates", href: "/templates" },
  { label: "Our Story", href: "/our-story" },
  { label: "Why We Do It", href: "/why-we-do-what-we-do" },
  { label: "Support", href: "/support" },
];
---

<header class="sticky top-0 z-50 w-full px-4 sm:px-6 lg:px-8 py-4 transition-all">
  <div class="max-w-7xl mx-auto">
    <!-- Fluid Glass Island Chassis -->
    <nav class="relative flex items-center justify-between px-3 sm:px-5 py-2 rounded-full bg-[#0c0e14]/85 backdrop-blur-2xl border border-white/10 shadow-[0_12px_40px_rgba(0,0,0,0.7)] ring-1 ring-white/5">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 rounded-full pr-2">
        <div class="relative w-9 h-9 rounded-full bg-gradient-to-tr from-cyan-500 via-indigo-500 to-fuchsia-500 p-[1px] shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform duration-300">
          <div class="w-full h-full rounded-full bg-[#08090d] flex items-center justify-center text-cyan-400">
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-white tracking-tight text-sm sm:text-base group-hover:text-cyan-300 transition-colors">
            Visual Style <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">Editor</span>
          </span>
          <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-mono font-medium tracking-wide uppercase bg-cyan-950/60 text-cyan-300 border border-cyan-500/30">
            v2.0
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <div class="hidden xl:flex items-center gap-1 bg-[#12151f]/80 p-1 rounded-full border border-white/5">
        {navItems.map((item) => {
          const isActive = 
            activePage === item.label.toLowerCase() || 
            (item.label === "Home" && (activePage === "home" || activePage === "")) || 
            (item.label === "Why We Do It" && activePage === "why");
          return (
            <a
              href={item.href}
              class={`px-3.5 py-1.5 rounded-full text-xs font-medium transition-all duration-200 ${
                isActive
                  ? "bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 shadow-xs shadow-cyan-500/20 font-semibold"
                  : "text-slate-300 hover:text-white hover:bg-white/5"
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </div>

      <!-- Action Buttons (Button-in-Button Pattern) -->
      <div class="flex items-center gap-3">
        <!-- Direct Studio CTA -->
        <a
          href="/editor"
          class="group relative inline-flex items-center gap-3 pl-4 pr-1.5 py-1.5 rounded-full text-xs font-semibold text-black bg-gradient-to-r from-cyan-400 via-sky-300 to-cyan-300 hover:brightness-110 shadow-lg shadow-cyan-500/25 active:scale-98 transition-all duration-200"
        >
          <span class="tracking-wide font-bold">Open Studio</span>
          <!-- Nested Button-in-Button Circle -->
          <span class="w-6 h-6 rounded-full bg-black/15 flex items-center justify-center transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
            <svg class="w-3.5 h-3.5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="xl:hidden p-2 rounded-full text-slate-300 hover:bg-white/10 hover:text-white border border-white/10 transition-colors focus:outline-none"
          aria-label="Toggle navigation menu"
        >
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Drawer Modal -->
    <div
      id="mobile-menu-drawer"
      class="hidden xl:hidden mt-3 p-5 rounded-3xl bg-[#0c0e14]/95 backdrop-blur-3xl border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.9)] transition-all"
    >
      <div class="flex flex-col gap-1.5">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-4 py-2.5 rounded-2xl text-sm font-medium text-slate-300 hover:bg-white/5 hover:text-cyan-400 transition-colors"
          >
            {item.label}
          </a>
        ))}
        <div class="pt-3 border-t border-white/10 mt-2 flex flex-col gap-2">
          <a
            href="/editor"
            class="w-full flex items-center justify-center gap-2 py-3 rounded-full text-sm font-bold text-black bg-gradient-to-r from-cyan-400 to-sky-300 shadow-md shadow-cyan-500/25"
          >
            Launch Studio
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const drawer = document.getElementById("mobile-menu-drawer");
  const hamIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = !drawer.classList.contains("hidden");
      if (isExpanded) {
        drawer.classList.add("hidden");
        hamIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      } else {
        drawer.classList.remove("hidden");
        hamIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
      }
    });
  }
</script>
