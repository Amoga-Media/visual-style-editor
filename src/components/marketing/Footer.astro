---
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#080a10] border-t border-white/10 pt-20 pb-12 mt-auto text-slate-400 relative overflow-hidden">
  <!-- Subtle decorative ambient cyan/indigo mesh glow -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-cyan-500/10 blur-[140px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 pb-14 border-b border-white/10">
      <!-- Col 1: Brand & Manifesto -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3 group focus:outline-none">
          <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-cyan-500 via-indigo-500 to-fuchsia-500 p-[1px] shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform duration-300">
            <div class="w-full h-full rounded-full bg-[#08090d] flex items-center justify-center text-cyan-400">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
          </div>
          <span class="font-bold text-white tracking-tight text-lg">
            Visual Style <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">Editor</span>
          </span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          A high-performance visual editor for HTML and Tailwind CSS operating directly in your browser. 
          Zero backend, zero telemetry, zero lock-in — just pure, surgical AST code editing.
        </p>

        <!-- Status & Engine Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#12151f] border border-white/10 text-xs font-mono text-slate-300 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>100% In-Browser AST Engine • Offline Capable</span>
        </div>
      </div>

      <!-- Col 2: Product -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">Product</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/features" class="hover:text-cyan-400 transition-colors">Features & Tech</a></li>
          <li><a href="/how-it-works" class="hover:text-cyan-400 transition-colors">How It Works</a></li>
          <li><a href="/templates" class="hover:text-cyan-400 transition-colors">Starter Templates</a></li>
          <li><a href="/editor" class="text-cyan-400 font-semibold hover:text-cyan-300 transition-colors flex items-center gap-1">Open Studio <span class="text-xs">↗</span></a></li>
        </ul>
      </div>

      <!-- Col 3: Company & Story -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">Philosophy</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/our-story" class="hover:text-cyan-400 transition-colors">Our Story</a></li>
          <li><a href="/why-we-do-what-we-do" class="hover:text-cyan-400 transition-colors">Why We Do What We Do</a></li>
          <li><a href="/support" class="hover:text-cyan-400 transition-colors">Support & FAQs</a></li>
          <li><a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">GitHub Repository</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & Trust -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">Security & Open Web</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/privacy" class="hover:text-cyan-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-cyan-400 transition-colors">Terms of Service</a></li>
          <li><span class="text-slate-500 font-mono text-xs">MIT License</span></li>
          <li><span class="text-slate-500 font-mono text-xs">Zero Tracking Cookies</span></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-500">
      <p>© {currentYear} Visual Style Editor. Crafted for developers & designers worldwide.</p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-slate-300 transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-slate-300 transition-colors">Terms</a>
        <a href="/support" class="hover:text-slate-300 transition-colors">Help Hub</a>
        <a href="#top" class="text-cyan-400 hover:text-cyan-300 transition-colors">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>
