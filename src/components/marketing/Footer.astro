---
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#fbfaff] border-t border-purple-100/80 pt-16 pb-12 mt-auto text-slate-600 relative overflow-hidden">
  <!-- Subtle decorative purple mesh glow -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-purple-200/25 blur-[120px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 pb-14 border-b border-purple-100">
      <!-- Col 1: Brand & Manifesto -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3 group focus:outline-none">
          <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-violet-600 to-purple-500 flex items-center justify-center text-white shadow-md shadow-purple-500/25">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <span class="font-bold text-slate-900 tracking-tight text-lg">
            Visual Style <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-600 to-purple-600">Editor</span>
          </span>
        </a>
        <p class="text-sm text-slate-600 leading-relaxed max-w-sm">
          A high-performance visual editor for HTML and Tailwind CSS operating directly in your browser. 
          Zero backend, zero telemetry, zero lock-in — just pure, surgical AST code editing.
        </p>

        <!-- Status badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-purple-200/80 text-xs font-medium text-slate-700 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>100% Client-Side Engine • Offline Capable</span>
        </div>
      </div>

      <!-- Col 2: Product -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">Product</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/features" class="hover:text-purple-700 transition-colors">Features & Tech</a></li>
          <li><a href="/how-it-works" class="hover:text-purple-700 transition-colors">How It Works</a></li>
          <li><a href="/templates" class="hover:text-purple-700 transition-colors">Starter Templates</a></li>
          <li><a href="/editor" class="text-purple-700 font-semibold hover:text-purple-800 transition-colors flex items-center gap-1">Open Studio <span class="text-xs">↗</span></a></li>
        </ul>
      </div>

      <!-- Col 3: Company & Story -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">Philosophy</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/our-story" class="hover:text-purple-700 transition-colors">Our Story</a></li>
          <li><a href="/why-we-do-what-we-do" class="hover:text-purple-700 transition-colors">Why We Do What We Do</a></li>
          <li><a href="/support" class="hover:text-purple-700 transition-colors">Support & Sponsors</a></li>
          <li><a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-purple-700 transition-colors">GitHub Repository</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & Trust -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900">Legal & Trust</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/privacy" class="hover:text-purple-700 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-purple-700 transition-colors">Terms of Service</a></li>
          <li><span class="text-slate-400 cursor-default">MIT Open Source</span></li>
          <li><span class="text-slate-400 cursor-default">Zero Cookies Policy</span></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-600">
      <p>© {currentYear} Visual Style Editor. Crafted for developers & designers worldwide.</p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-purple-700 transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-purple-700 transition-colors">Terms</a>
        <a href="/support" class="hover:text-purple-700 transition-colors">Support</a>
        <a href="#top" class="text-purple-700 font-medium hover:underline">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>
