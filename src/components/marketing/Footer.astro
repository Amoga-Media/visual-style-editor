---
import Logo from "@/components/marketing/Logo.astro";

const currentYear = new Date().getFullYear();
---

<footer
  class="w-full mt-auto border-t"
  style="background: var(--canvas-subtle); border-color: var(--border);"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 pb-12 border-b" style="border-color: var(--border);">

      <!-- Brand column -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-2.5 group w-fit" aria-label="Visual Style Editor — home">
          <Logo size="sm" showStatusPill={false} />
        </a>
        <p class="text-sm leading-relaxed" style="color: var(--ink-3); max-width: 28ch;">
          Visual HTML and Tailwind CSS editing that runs entirely in your browser. No accounts. No servers. No lock-in.
        </p>
        <div class="badge badge-green">
          <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background: var(--success);"></span>
          MIT licensed · 100% offline capable
        </div>
      </div>

      <!-- Product links -->
      <div class="space-y-4">
        <h4 class="text-label" style="color: var(--ink-3);">Product</h4>
        <ul class="space-y-2.5">
          <li><a href="/features" class="text-sm transition-colors duration-150 hover:underline" style="color: var(--ink-2);">Features</a></li>
          <li><a href="/how-it-works" class="text-sm transition-colors duration-150 hover:underline" style="color: var(--ink-2);">How it works</a></li>
          <li><a href="/templates" class="text-sm transition-colors duration-150 hover:underline" style="color: var(--ink-2);">Starter templates</a></li>
          <li>
            <a href="/editor" class="text-sm font-semibold transition-colors duration-150 flex items-center gap-1" style="color: var(--ink-1);">
              Open editor
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Company & legal -->
      <div class="space-y-4">
        <h4 class="text-label" style="color: var(--ink-3);">Company & Legal</h4>
        <ul class="space-y-2.5">
          <li><a href="/our-story" class="text-sm transition-colors duration-150 hover:underline" style="color: var(--ink-2);">Our story</a></li>
          <li><a href="/why-we-do-what-we-do" class="text-sm transition-colors duration-150 hover:underline" style="color: var(--ink-2);">Why we built this</a></li>
          <li><a href="/support" class="text-sm transition-colors duration-150 hover:underline" style="color: var(--ink-2);">Support</a></li>
          <li><a href="/contact" class="text-sm transition-colors duration-150 hover:underline" style="color: var(--ink-2);">Contact</a></li>
          <li><a href="/privacy" class="text-sm transition-colors duration-150 hover:underline" style="color: var(--ink-2);">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm transition-colors duration-150 hover:underline" style="color: var(--ink-2);">Terms of Service</a></li>
          <li><a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-sm transition-colors duration-150 hover:underline flex items-center gap-1" style="color: var(--ink-2);">
            GitHub
            <svg class="w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-10 flex flex-col items-center justify-center text-center space-y-4">
      <p class="text-base sm:text-lg font-semibold flex items-center justify-center gap-2" style="color: var(--ink-1); font-family: var(--font-mono);">
        <span>Made with</span>
        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-rose-500 fill-rose-500 inline-block animate-pulse shrink-0" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
        </svg>
        <span>by</span>
        <a
          href="https://amogamedia.com"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold underline decoration-purple-500/50 underline-offset-4 transition-all duration-150 text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 hover:decoration-purple-500"
        >
          Amoga Media
        </a>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-5 pt-1">
        <p class="text-xs" style="color: var(--ink-4); font-family: var(--font-mono);">
          &copy; {currentYear} Visual Style Editor. Built for the open web.
        </p>
        <span class="hidden sm:inline opacity-30 text-xs select-none" style="color: var(--ink-4);">&bull;</span>
        <div class="flex items-center gap-5">
          <a href="/privacy" class="text-xs transition-colors duration-150 hover:underline" style="color: var(--ink-4); font-family: var(--font-mono);">Privacy</a>
          <a href="/terms" class="text-xs transition-colors duration-150 hover:underline" style="color: var(--ink-4); font-family: var(--font-mono);">Terms</a>
          <a href="#" class="text-xs transition-colors duration-150 hover:underline" style="color: var(--ink-4); font-family: var(--font-mono);">Back to top &uarr;</a>
        </div>
      </div>
    </div>
  </div>
</footer>
