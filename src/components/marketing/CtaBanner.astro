---
interface Props {
  headline?: string;
  subheadline?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  headline = "Ready to experience visual editing with zero lock-in?",
  subheadline = "Drop any HTML or Tailwind file directly into your browser. No telemetry, no monthly subscriptions, zero server uploads.",
  ctaText = "Open Visual Style Editor Free",
  ctaLink = "/editor",
} = Astro.props;
---

<section class="w-full py-20 sm:py-28 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <!-- Doppelrand Machined Chassis -->
    <div class="doppelrand-shell spotlight-card">
      <div class="doppelrand-core relative px-6 sm:px-12 py-16 sm:py-24 text-center">
        <!-- Ambient Cyber Radial Glow -->
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-b from-cyan-500/20 via-indigo-500/10 to-transparent blur-[100px] rounded-full pointer-events-none"></div>

        <div class="relative z-10 max-w-3xl mx-auto space-y-6">
          <!-- Eyebrow Pill -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[11px] font-mono font-semibold uppercase tracking-wider bg-cyan-950/70 text-cyan-300 border border-cyan-500/30">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
            100% In-Browser AST Studio
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.15]">
            {headline}
          </h2>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
            {subheadline}
          </p>

          <!-- Interactive CTAs -->
          <div class="pt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={ctaLink}
              class="group relative inline-flex items-center gap-3 pl-8 pr-2.5 py-3.5 rounded-full text-base font-bold text-black bg-gradient-to-r from-cyan-400 via-sky-300 to-cyan-300 hover:brightness-110 shadow-xl shadow-cyan-500/25 active:scale-98 transition-all duration-200"
            >
              <span>{ctaText}</span>
              <span class="w-8 h-8 rounded-full bg-black/15 flex items-center justify-center transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-0.5">
                <svg class="w-4 h-4 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </a>

            <a
              href="/templates"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-base font-semibold text-slate-200 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-all"
            >
              <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
              </svg>
              <span>Explore Templates</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-4 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-400 font-mono">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Zero Install Required
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              100% Free & Open Web
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Direct Local Disk Sync
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
