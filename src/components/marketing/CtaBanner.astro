---
interface Props {
  headline?: string;
  subheadline?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  headline = "Your HTML file. Your disk. Your terms.",
  subheadline = "Drop any file and start editing. Changes save directly to your local files — no uploads, no subscriptions, no accounts.",
  ctaText = "Try in the editor",
  ctaLink = "/editor",
} = Astro.props;
---

<section class="section border-t" style="border-color: var(--border);">
  <div class="section-inner">
    <div
      class="card-raised px-8 sm:px-16 py-16 sm:py-20 relative overflow-hidden reveal"
      style="border-radius: 20px;"
    >
      <!-- Subtle top-edge highlight -->
      <div
        class="absolute inset-x-0 top-0 h-px"
        style="background: linear-gradient(to right, transparent, var(--border-strong), transparent);"
        aria-hidden="true"
      ></div>

      <div class="max-w-2xl space-y-6">
        <!-- Section marker (1-per-3-sections rule: this is justified as the final CTA) -->
        <span class="text-label">Free &amp; open source</span>

        <h2 class="text-headline">{headline}</h2>
        <p class="text-body">{subheadline}</p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a href={ctaLink} class="btn btn-primary">
            {ctaText}
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="/templates" class="btn btn-ghost">
            Browse templates
          </a>
        </div>

        <!-- Trust trifecta -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-2">
          {["No account required", "100% local processing", "MIT licensed"].map(t => (
            <span class="flex items-center gap-1.5 text-xs" style="color: var(--ink-3); font-family: var(--font-mono);">
              <svg class="w-3.5 h-3.5 shrink-0" style="color: var(--success);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {t}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
