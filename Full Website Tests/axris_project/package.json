{
  "name": "axris-media",
  "version": "2.0.0",
  "description": "Axris Media Solutions — marketing site build pipeline",
  "scripts": {
    "dev:css": "node scripts/build-css.js --watch",
    "dev:js": "node build.js --watch",
    "dev": "npm-run-all --parallel dev:css dev:js",
    "build:css": "node scripts/build-css.js",
    "build:js": "node build.js",
    "version-assets": "node scripts/version-assets.js",
    "build": "npm-run-all build:css build:js version-assets",
    "serve": "python3 -m http.server 8080",
    "test": "node scripts/smoke-test.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.28.1",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "gsap": "3.14.2",
    "lenis": "1.3.21"
  }
}
